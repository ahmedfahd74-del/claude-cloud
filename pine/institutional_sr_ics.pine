//@version=6
// Institutional S/R Engine — MEMORY + ICS + MS-CORE STRUCTURE CONFLUENCE.
// Levels are clustered swing pivots (chart-native — where price actually reverses).
// Each level carries a MEMORY: touches, flips (support↔resistance), reaction size,
// time span, volume, retests, bounces, breaks, win-rate, last reaction. An
// Institutional Confidence Score (ICS 0-100) blends all of it PLUS structure
// confluence with the MS-Core market-structure bias (W→D→4H→1H). Only the
// strongest levels display; a level being tested expands into a live ZONE.
// Bias now uses the SAME method as MS-Core: swings detected on the WICK,
// breaks confirmed on the CLOSE — so S/R and structure agree by construction.
// Levels that FIGHT the bias are dimmed; the one actionable level is ★-marked.
indicator("Institutional S/R [ICS + Structure]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=5000)

gD = "Detection"
pivLen      = input.int(10, "Swing Size", minval=2, maxval=100, group=gD)
histBars    = input.int(2000, "History Lookback (bars)", minval=100, maxval=5000, group=gD)
bandPct     = input.float(0.75, "Cluster Band (% of price)", minval=0.05, maxval=10.0, step=0.05, group=gD)
zoneBandPct = input.float(0.50, "Test Zone Band (% of price)", minval=0.05, maxval=10.0, step=0.05, group=gD)

gS = "Selection"
maxLines   = input.int(6, "Max Lines", minval=1, maxval=20, group=gS)
minICS     = input.float(0.0, "Min ICS to Show", minval=0.0, maxval=100.0, step=5.0, group=gS)
minTouches = input.int(2, "Min Touches", minval=1, maxval=20, group=gS)
sepPct     = input.float(1.5, "Min Separation (% of price)", minval=0.1, maxval=10.0, step=0.1, group=gS)

gI = "ICS Weights"
touchNorm = input.float(6.0, "Touches for Full Score", minval=1.0, maxval=30.0, group=gI)
reactNorm = input.float(2.0, "Reaction ATR for Full Score", minval=0.5, maxval=10.0, step=0.5, group=gI)
spanNorm  = input.float(200.0, "Time Span (bars) for Full Score", minval=10.0, maxval=5000.0, group=gI)
wTouch  = input.float(0.25, "Weight Touches", minval=0.0, maxval=1.0, step=0.05, group=gI)
wFlip   = input.float(0.15, "Weight Flip", minval=0.0, maxval=1.0, step=0.05, group=gI)
wReact  = input.float(0.12, "Weight Reaction", minval=0.0, maxval=1.0, step=0.05, group=gI)
wWin    = input.float(0.18, "Weight Win Rate", minval=0.0, maxval=1.0, step=0.05, group=gI)
wSpan   = input.float(0.08, "Weight Time Span", minval=0.0, maxval=1.0, step=0.05, group=gI)
wVol    = input.float(0.05, "Weight Volume", minval=0.0, maxval=1.0, step=0.05, group=gI)
wStruct = input.float(0.25, "Weight Structure Confluence", minval=0.0, maxval=1.0, step=0.05, group=gI)

gC = "Style"
resCol    = input.color(#ffd24a, "Resistance", group=gC)
supCol    = input.color(#4ac6ff, "Support", group=gC)
zoneCol   = input.color(#ffd24a, "Active Test Zone", group=gC)
lineWidth = input.int(2, "Line Width", minval=1, maxval=6, group=gC)
flipThick = input.bool(true, "Flip levels thicker", group=gC)
extendR   = input.int(30, "Extend Right (bars)", minval=0, maxval=200, group=gC)
showLbl   = input.bool(true, "Show Labels", group=gC)
lblSizeS  = input.string("Small", "Label Size", options=["Tiny", "Small", "Normal", "Large"], group=gC)

gM = "Market Structure (MS-Core)"
biasPiv   = input.int(5, "Bias Swing Length (wick fractal L/R)", minval=2, maxval=30, group=gM)
structLen = input.int(120, "Premium/Discount Range Lookback", minval=20, maxval=1000, group=gM)
showExc   = input.bool(true, "Excursion Zones (track test depth)", group=gM)
showPanel = input.bool(true, "Show Decision Panel", group=gM)
dimVs     = input.bool(true, "Dim levels that fight the bias", group=gM)
showAct   = input.bool(true, "Mark the actionable level (★)", group=gM)

gL = "DOL Liquidity (Sphinx)"
showDOL     = input.bool(true, "Show DOL liquidity levels (prior D/W/M)", group=gL)
dolDay      = input.bool(true, "Prior Day H/L (PDH/PDL)", group=gL)
dolWeek     = input.bool(true, "Prior Week H/L (PWH/PWL)", group=gL)
dolMonth    = input.bool(true, "Prior Month H/L (PMH/PML)", group=gL)
dolEQ       = input.bool(true, "Weekly / Monthly Equilibrium (50%)", group=gL)
dolBandPct  = input.float(1.0, "Confluence band (% of price)", minval=0.1, maxval=5.0, step=0.1, group=gL)
dolBoost    = input.float(15.0, "DOL confluence ICS boost (per level)", minval=0.0, maxval=50.0, step=5.0, group=gL)
nakedBoost  = input.float(8.0, "Extra boost if DOL is naked (untested)", minval=0.0, maxval=30.0, step=2.0, group=gL)
dolSnap     = input.bool(true, "Snap confluent S/R line to exact DOL price", group=gL)
dolEmph     = input.bool(true, "Emphasize ceiling (bear) / floor (bull)", group=gL)
colCeil     = input.color(#ef5350, "Ceiling (above price)", group=gL)
colFloor    = input.color(#26a69a, "Floor (below price)", group=gL)

f_size(s) => s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large : size.small

// A level and its full memory.
type Lvl
    float price
    int   touch
    bool  hi
    bool  lo
    int   first
    int   last
    float reactSum
    int   reactN
    float volSum
    int   retest
    int   bounce
    int   brk
    int   lastReact
    bool  was
    array<int> hist
    float testHi
    float testLo

var array<Lvl> book = array.new<Lvl>()

atr    = ta.atr(14)
avgVol = ta.sma(volume, 50)

// ── Premium / discount context ───────────────────────────────────────────────
rangeHi = ta.highest(high, structLen)
rangeLo = ta.lowest(low, structLen)
eqLvl   = (rangeHi + rangeLo) / 2.0
inPrem  = close > eqLvl

// ── MS-CORE bias: swings on WICK, break confirmed on CLOSE (matches ms_core.pine)
// Returns +1 bull / -1 bear / 0. Scalar, so requesting W/D/4H/1H is cheap and
// never triggers array-memory blow-up.
// NOTE: no barstate.isconfirmed in here — it does NOT work inside request.security
// (it reads the CHART bar, not the requested TF's bar), which previously let the
// still-forming HTF bar register a premature break (the "1D Bullish on a bearish
// chart" bug). Confirmation is applied OUTSIDE via f_biasPrev()[1] + lookahead_on,
// so the value is the last CLOSED HTF bar and history never repaints.
f_bias() =>
    _ph = ta.pivothigh(high, biasPiv, biasPiv)
    _pl = ta.pivotlow(low,  biasPiv, biasPiv)
    var int   _dir    = 0
    var float _lastPH = na
    var float _lastPL = na
    var float _upRef  = na
    var float _dnRef  = na
    if not na(_ph)
        _lastPH := _ph
        if na(_upRef)
            _upRef := _ph
    if not na(_pl)
        _lastPL := _pl
        if na(_dnRef)
            _dnRef := _pl
    _brokeUp = not na(_upRef) and close > _upRef
    _brokeDn = not na(_dnRef) and close < _dnRef
    if _brokeUp
        _dir := 1
        _dnRef := _lastPL
        _upRef := na
    if _brokeDn
        _dir := -1
        _upRef := _lastPH
        _dnRef := na
    _dir

// Non-repaint wrapper: bias of the last CLOSED bar of the requested TF.
f_biasPrev() =>
    int b = f_bias()
    b[1]

wB  = request.security(syminfo.tickerid, "W",   f_biasPrev(), lookahead = barmerge.lookahead_on)
dB  = request.security(syminfo.tickerid, "D",   f_biasPrev(), lookahead = barmerge.lookahead_on)
h4B = request.security(syminfo.tickerid, "240", f_biasPrev(), lookahead = barmerge.lookahead_on)
h1B = request.security(syminfo.tickerid, "60",  f_biasPrev(), lookahead = barmerge.lookahead_on)
f_biasTxt(int b) => b > 0 ? "Bullish" : b < 0 ? "Bearish" : "Neutral"

// Weighted HTF bias score (W is the boss) in [-1, 1], with a neutral deadband.
biasScore = wB * 0.40 + dB * 0.30 + h4B * 0.20 + h1B * 0.10
bDir = biasScore > 0.15 ? 1 : biasScore < -0.15 ? -1 : 0

// ── DOL LIQUIDITY: prior D/W/M pools (Sphinx), non-repainting ─────────────────
// [1] + lookahead_on = the last CLOSED period's high/low (prior day/week/month).
pdH = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdL = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)
pwH = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
pwL = request.security(syminfo.tickerid, "W", low[1],  lookahead=barmerge.lookahead_on)
pmH = request.security(syminfo.tickerid, "M", high[1], lookahead=barmerge.lookahead_on)
pmL = request.security(syminfo.tickerid, "M", low[1],  lookahead=barmerge.lookahead_on)
wEQ = (na(pwH) or na(pwL)) ? na : (pwH + pwL) / 2.0
mEQ = (na(pmH) or na(pmL)) ? na : (pmH + pmL) / 2.0

// naked tracking: a pool is "naked" until price trades through it in the new period
var bool pdHn = true
var bool pdLn = true
var bool pwHn = true
var bool pwLn = true
var bool pmHn = true
var bool pmLn = true
if pdH != pdH[1]
    pdHn := true
if pdL != pdL[1]
    pdLn := true
if pwH != pwH[1]
    pwHn := true
if pwL != pwL[1]
    pwLn := true
if pmH != pmH[1]
    pmHn := true
if pmL != pmL[1]
    pmLn := true
if not na(pdH) and high >= pdH
    pdHn := false
if not na(pdL) and low <= pdL
    pdLn := false
if not na(pwH) and high >= pwH
    pwHn := false
if not na(pwL) and low <= pwL
    pwLn := false
if not na(pmH) and high >= pmH
    pmHn := false
if not na(pmL) and low <= pmL
    pmLn := false

var array<float>  dolPx  = array.new<float>()
var array<string> dolTag = array.new<string>()
var array<bool>   dolNk  = array.new<bool>()
var array<float>  snapUsed = array.new<float>()

f_addDol(bool en, float px, string tag, bool nk) =>
    if en and showDOL and not na(px)
        array.push(dolPx, px)
        array.push(dolTag, tag)
        array.push(dolNk, nk)

// ICS boost from every DOL level within the confluence band (stacking rewarded).
f_dolBoost(float px) =>
    band = px * dolBandPct / 100.0
    float bst = 0.0
    if showDOL and array.size(dolPx) > 0
        for i = 0 to array.size(dolPx) - 1
            if math.abs(array.get(dolPx, i) - px) <= band
                bst := bst + dolBoost + (array.get(dolNk, i) ? nakedBoost : 0.0)
    bst

// Nearest DOL to a price → [snapped price (exact DOL), combined tag, count].
f_dolInfo(float px) =>
    band = px * dolBandPct / 100.0
    float snapPx = px
    float bestD = band
    string tag = ""
    int cnt = 0
    if showDOL and array.size(dolPx) > 0
        for i = 0 to array.size(dolPx) - 1
            d = math.abs(array.get(dolPx, i) - px)
            if d <= band
                cnt := cnt + 1
                tag := tag + (tag == "" ? "" : "+") + array.get(dolTag, i)
                if d < bestD
                    bestD := d
                    snapPx := dolSnap ? array.get(dolPx, i) : px
    [snapPx, tag, cnt]

ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)

// Register a swing pivot into the nearest price cluster (or open a new one),
// updating touch count, side flags, reaction size, volume and last-seen bar.
f_touch(float pv, bool isHigh, float rct, float vol) =>
    if not na(pv)
        band = pv * bandPct / 100.0
        int best = -1
        float bestD = band
        if array.size(book) > 0
            for i = 0 to array.size(book) - 1
                d = math.abs(array.get(book, i).price - pv)
                if d <= bestD
                    bestD := d
                    best := i
        if best >= 0
            L = array.get(book, best)
            c = L.touch
            L.price := (L.price * c + pv) / (c + 1)
            L.touch := c + 1
            if isHigh
                L.hi := true
            else
                L.lo := true
            L.last := bar_index
            L.reactSum := L.reactSum + rct
            L.reactN := L.reactN + 1
            L.volSum := L.volSum + vol
            array.set(book, best, L)
        else
            array.push(book, Lvl.new(price=pv, touch=1, hi=isHigh, lo=not isHigh, first=bar_index, last=bar_index, reactSum=rct, reactN=1, volSum=vol, retest=0, bounce=0, brk=0, lastReact=0, was=false, hist=array.new<int>(), testHi=na, testLo=na))

rctH = (na(atr) or atr <= 0) ? 0.0 : math.abs(ph - close) / atr
rctL = (na(atr) or atr <= 0) ? 0.0 : math.abs(pl - close) / atr
if not na(ph)
    f_touch(ph, true, rctH, volume[pivLen])
if not na(pl)
    f_touch(pl, false, rctL, volume[pivLen])

// prune stale clusters (untouched for longer than the lookback)
if array.size(book) > 0
    for i = array.size(book) - 1 to 0
        if bar_index - array.get(book, i).last > histBars
            array.remove(book, i)

// per-bar MEMORY: retest on entry, bounce/break classified on exit, last reaction.
if array.size(book) > 0
    for i = 0 to array.size(book) - 1
        L = array.get(book, i)
        bnd = L.price * zoneBandPct / 100.0
        zt = L.price + bnd
        zb = L.price - bnd
        isT = high >= zb and low <= zt
        if isT
            L.testHi := na(L.testHi) ? high : math.max(L.testHi, high)
            L.testLo := na(L.testLo) ? low : math.min(L.testLo, low)
        else
            L.testHi := na
            L.testLo := na
        if isT and not L.was
            L.retest := L.retest + 1
        if L.was and not isT
            enteredBelow = close[2] < zb
            enteredAbove = close[2] > zt
            exitAbove = close > zt
            exitBelow = close < zb
            isBounce = (enteredBelow and exitBelow) or (enteredAbove and exitAbove)
            isBreak  = (enteredBelow and exitAbove) or (enteredAbove and exitBelow)
            if isBounce
                L.bounce := L.bounce + 1
                L.lastReact := 1
                array.push(L.hist, 1)
            else if isBreak
                L.brk := L.brk + 1
                L.lastReact := -1
                array.push(L.hist, -1)
            if array.size(L.hist) > 5
                array.shift(L.hist)
        L.was := isT

// Institutional Confidence Score — weighted blend of memory + structure (0-100).
// bScore = weighted HTF bias [-1,1]; px = current close (level side vs price).
f_ics(Lvl L, float bScore, float px) =>
    touchF = math.min(L.touch / touchNorm, 1.0)
    flipF  = (L.hi and L.lo) ? 1.0 : 0.0
    reactF = L.reactN > 0 ? math.min((L.reactSum / L.reactN) / reactNorm, 1.0) : 0.0
    tot    = L.bounce + L.brk
    winF   = tot > 0 ? L.bounce / tot : 0.5
    spanF  = math.min((L.last - L.first) / spanNorm, 1.0)
    volF   = (avgVol > 0 and L.touch > 0) ? math.min((L.volSum / L.touch) / (avgVol * 1.5), 1.0) : 0.3
    isSup  = L.price < px
    aligned = (isSup and bScore > 0) or (not isSup and bScore < 0)
    structF = aligned ? math.min(math.abs(bScore), 1.0) : 0.0
    wSum   = wTouch + wFlip + wReact + wWin + wSpan + wVol + wStruct
    raw    = wSum > 0 ? (touchF*wTouch + flipF*wFlip + reactF*wReact + winF*wWin + spanF*wSpan + volF*wVol + structF*wStruct) / wSum : 0.0
    math.min(math.max(raw * 100.0, 0.0), 100.0)

// Is a level with the bias? (support in a bull / resistance in a bear)
f_aligned(Lvl L, float px, int dir) =>
    isSup = L.price < px
    (isSup and dir > 0) or (not isSup and dir < 0)

// Expected behaviour, derived from the memory — the "why".
f_expect(Lvl L) =>
    tot = L.bounce + L.brk
    win = tot > 0 ? L.bounce / tot : 0.5
    L.lastReact < 0 ? "RETEST likely" : (win >= 0.6 and tot >= 1) ? "HOLD expected" : (win <= 0.35 and tot >= 2) ? "WEAK / breaks" : "NEUTRAL"

// Last-5 interactions rendered oldest→newest: ✓ = bounce (held), ✗ = break.
f_form(Lvl L) =>
    string s = ""
    if array.size(L.hist) > 0
        for i = 0 to array.size(L.hist) - 1
            s := s + (array.get(L.hist, i) == 1 ? "✓" : "✗")
    s == "" ? "—" : s

var array<line>  dLine = array.new<line>()
var array<label> dLab  = array.new<label>()
var array<box>   dBox  = array.new<box>()
var table        panel = table.new(position.top_right, 2, 8, border_color=color.new(color.gray, 60), border_width=1)

if barstate.islast
    while array.size(dLine) > 0
        line.delete(array.pop(dLine))
    while array.size(dLab) > 0
        label.delete(array.pop(dLab))
    while array.size(dBox) > 0
        box.delete(array.pop(dBox))
    // rebuild the DOL set for this bar
    array.clear(dolPx)
    array.clear(dolTag)
    array.clear(dolNk)
    array.clear(snapUsed)
    f_addDol(dolDay,   pdH, "PDH", pdHn)
    f_addDol(dolDay,   pdL, "PDL", pdLn)
    f_addDol(dolWeek,  pwH, "PWH", pwHn)
    f_addDol(dolWeek,  pwL, "PWL", pwLn)
    f_addDol(dolMonth, pmH, "PMH", pmHn)
    f_addDol(dolMonth, pmL, "PML", pmLn)
    f_addDol(dolEQ,    wEQ, "wEQ", false)
    f_addDol(dolEQ,    mEQ, "mEQ", false)
    float railUp = na
    float railDn = na
    n = array.size(book)
    if n > 0
        scores = array.new_float(n, 0.0)
        for i = 0 to n - 1
            array.set(scores, i, math.min(100.0, f_ics(array.get(book, i), biasScore, close) + f_dolBoost(array.get(book, i).price)))
        used = array.new_bool(n, false)
        sel  = array.new_int()
        for _s = 0 to n - 1
            if array.size(sel) >= maxLines
                break
            best = -1
            bestS = -1.0
            for i = 0 to n - 1
                if array.get(used, i)
                    continue
                L = array.get(book, i)
                if L.touch < minTouches
                    continue
                if array.get(scores, i) < minICS
                    continue
                if array.get(scores, i) > bestS
                    bestS := array.get(scores, i)
                    best := i
            if best < 0
                break
            array.set(used, best, true)
            pb = array.get(book, best).price
            ok = true
            if array.size(sel) > 0
                for j = 0 to array.size(sel) - 1
                    if math.abs(pb - array.get(book, array.get(sel, j)).price) < pb * sepPct / 100.0
                        ok := false
                        break
            if ok
                array.push(sel, best)
        // find the ONE actionable level: aligned with bias, nearest to price on its side
        int actIdx = -1
        float actDist = 1.0e20
        if array.size(sel) > 0 and bDir != 0
            for k = 0 to array.size(sel) - 1
                i = array.get(sel, k)
                L = array.get(book, i)
                if f_aligned(L, close, bDir)
                    d = math.abs(close - L.price)
                    if d < actDist
                        actDist := d
                        actIdx := i
        x1 = bar_index - math.min(400, bar_index)
        x2 = bar_index + extendR
        if array.size(sel) > 0
            for k = 0 to array.size(sel) - 1
                i = array.get(sel, k)
                L = array.get(book, i)
                ics = array.get(scores, i)
                flip = L.hi and L.lo
                aligned = f_aligned(L, close, bDir)
                fights  = bDir != 0 and not aligned
                isAct   = showAct and i == actIdx
                // DOL confluence: snap the drawn line to the exact institutional price
                [snapPx, dtag, dcnt] = f_dolInfo(L.price)
                drawPx = snapPx
                if dcnt > 0
                    array.push(snapUsed, snapPx)
                col = drawPx > close ? resCol : supCol
                if drawPx > close
                    railUp := na(railUp) ? drawPx : math.min(railUp, drawPx)
                if drawPx < close
                    railDn := na(railDn) ? drawPx : math.max(railDn, drawPx)
                bnd = L.price * zoneBandPct / 100.0
                tested = high >= L.price - bnd and low <= L.price + bnd
                if tested
                    zTop = (showExc and not na(L.testHi)) ? math.max(L.testHi, L.price + bnd) : L.price + bnd
                    zBot = (showExc and not na(L.testLo)) ? math.min(L.testLo, L.price - bnd) : L.price - bnd
                    array.push(dBox, box.new(x1, zTop, x2, zBot, border_color=color.new(zoneCol, 40), border_width=1, bgcolor=color.new(zoneCol, 80)))
                else
                    lw = isAct ? lineWidth + 2 : (dcnt > 0 ? lineWidth + 1 : (flipThick and flip ? lineWidth + 1 : lineWidth))
                    lstyle = (dimVs and fights) ? line.style_dashed : line.style_solid
                    lcol = (dimVs and fights) ? color.new(col, 65) : col
                    array.push(dLine, line.new(x1, drawPx, x2, drawPx, color=lcol, width=lw, extend=extend.left, style=lstyle))
                if showLbl
                    tot = L.bounce + L.brk
                    wintxt = tot > 0 ? "win " + str.tostring(math.round(L.bounce / tot * 100)) + "%" : "new"
                    loc = drawPx > eqLvl ? "PREM" : "DISC"
                    stag = isAct ? "★ TRADE" : aligned ? "✓struct" : fights ? "✗vs bias" : "—"
                    dolt = dcnt > 0 ? "  ⚡" + dtag : ""
                    lblTxtCol = (dimVs and fights) ? color.new(color.white, 45) : color.white
                    lblBgCol  = isAct ? color.new(#26c281, 10) : (dimVs and fights) ? color.new(col, 55) : color.new(col, 20)
                    txt = str.tostring(drawPx, format.mintick) + "  ICS " + str.tostring(math.round(ics)) + (flip ? "  ⇄FLIP" : "") + dolt + "  " + stag + "\n×" + str.tostring(L.touch) + " · " + wintxt + " · " + f_expect(L) + "\nlast5 " + f_form(L) + "  ·  " + loc
                    array.push(dLab, label.new(x2, drawPx, txt, xloc=xloc.bar_index, style=label.style_label_left, color=lblBgCol, textcolor=lblTxtCol, size=f_size(lblSizeS)))
        // draw standalone DOL levels (those not already represented by a snapped S/R line)
        if showDOL and array.size(dolPx) > 0
            for di = 0 to array.size(dolPx) - 1
                dpx = array.get(dolPx, di)
                repD = false
                if array.size(snapUsed) > 0
                    for u = 0 to array.size(snapUsed) - 1
                        if array.get(snapUsed, u) == dpx
                            repD := true
                            break
                if not repD
                    above = dpx > close
                    barrier = dolEmph and ((bDir < 0 and above) or (bDir > 0 and not above))
                    dcol = above ? colCeil : colFloor
                    dlw = barrier ? 2 : 1
                    dstyle = barrier ? line.style_solid : line.style_dotted
                    array.push(dLine, line.new(x1, dpx, x2, dpx, color=color.new(dcol, barrier ? 0 : 40), width=dlw, extend=extend.left, style=dstyle))
                    if showLbl
                        btag = barrier ? (above ? "🔒CEIL " : "🛡FLOOR ") : ""
                        ntag = array.get(dolNk, di) ? " (naked)" : ""
                        array.push(dLab, label.new(x2, dpx, btag + array.get(dolTag, di) + " " + str.tostring(dpx, format.mintick) + ntag, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(dcol, 35), textcolor=color.white, size=f_size(lblSizeS)))

    if showPanel
        act = (bDir > 0 and not inPrem) ? "BUY zone" : (bDir < 0 and inPrem) ? "SELL zone" : (bDir > 0 and inPrem) ? "BUY (wait pullback)" : (bDir < 0 and not inPrem) ? "SELL (wait pop)" : "WAIT / no bias"
        actCol = str.startswith(act, "BUY") ? #26c281 : str.startswith(act, "SELL") ? #ff5252 : color.gray
        hdr = color.new(color.gray, 10)
        table.cell(panel, 0, 0, "DECISION", text_color=color.white, bgcolor=hdr, text_size=size.small)
        table.cell(panel, 1, 0, act, text_color=actCol, bgcolor=hdr, text_size=size.small)
        table.cell(panel, 0, 1, "1W Bias", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, 1, f_biasTxt(wB), text_color=wB > 0 ? #26c281 : wB < 0 ? #ff5252 : color.gray, text_size=size.small)
        table.cell(panel, 0, 2, "1D Bias", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, 2, f_biasTxt(dB), text_color=dB > 0 ? #26c281 : dB < 0 ? #ff5252 : color.gray, text_size=size.small)
        table.cell(panel, 0, 3, "4H Bias", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, 3, f_biasTxt(h4B), text_color=h4B > 0 ? #26c281 : h4B < 0 ? #ff5252 : color.gray, text_size=size.small)
        table.cell(panel, 0, 4, "1H Bias", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, 4, f_biasTxt(h1B), text_color=h1B > 0 ? #26c281 : h1B < 0 ? #ff5252 : color.gray, text_size=size.small)
        table.cell(panel, 0, 5, "Location", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, 5, inPrem ? "PREMIUM" : "DISCOUNT", text_color=inPrem ? #ff5252 : #26c281, text_size=size.small)
        table.cell(panel, 0, 6, "Rail Above", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, 6, na(railUp) ? "—" : str.tostring(railUp, format.mintick), text_color=color.white, text_size=size.small)
        table.cell(panel, 0, 7, "Rail Below", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, 7, na(railDn) ? "—" : str.tostring(railDn, format.mintick), text_color=color.white, text_size=size.small)
