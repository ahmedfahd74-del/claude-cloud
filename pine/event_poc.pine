// © Institutional Event Database — Deterministic MTF Proof of Concept (Phase 2)
//
// PROOF OF CONCEPT. Same architecture proven in the S/R POC: detect events
// INSIDE request.security() on each timeframe's own bars → freeze each event as
// an immutable record → append-only union across timeframes → order-independent
// hash → replay/freeze test (A=B=C) → read-only renderer + debug panel.
//
// Phase 2 — one unified EVENT stream with a `kind` field so every institutional
// event lives in one database:
//   kind 0 · LIQUIDITY SWEEP — price takes liquidity beyond a swing then rejects
//            back inside (wick through, close rejects).
//   kind 1 · BOS (Break of Structure) — price CLOSES beyond a prior swing
//            (structure broken in the close's direction).
//   (CHoCH / FVG / Order Block follow as kinds 2,3,4 on this same spine.)
//
// One breach of a swing resolves to EITHER a BOS (close through) or a sweep
// (wick through, close rejects). Direction is uniform: 1 = bullish, 0 = bearish.
// Lifecycle (in-security, chart-independent): mitigated when the level is
// revisited; invalidated when price closes beyond the event's extreme.

//@version=6
indicator("IA-Event · Institutional Event DB POC", "IA-Event POC", overlay = true,
     max_lines_count = 200, max_labels_count = 200, max_boxes_count = 200, max_bars_back = 2000)

// ─── Detection constants — FROZEN, NOT user inputs (the database is objective) ─
pivLen  = 5      // swing strength (bars each side)
MAXSW   = 100    // per-TF swing registry cap
MAXEV   = 150    // per-TF event cap (bounds in-security memory; the union retains history)
FVGMIN  = 0.15   // minimum FVG size in ATR — skip micro-gaps

// ─── Display (read-only — must never change the database) ──────────────────
maxEv      = input.int(8, "Max events per timeframe", minval = 1, maxval = 40, group = "Display",
     tooltip = "Per timeframe: draw up to this many events, nearest to price first. Never moves an event; only changes how many show.")
showSweep  = input.bool(true, "Sweeps", inline = "k", group = "Display")
showBOS    = input.bool(true, "BOS",    inline = "k", group = "Display")
showChoch  = input.bool(true, "CHoCH",  inline = "k", group = "Display")
showFVG    = input.bool(true, "FVG",    inline = "k", group = "Display")
showOB     = input.bool(true, "OB",     inline = "k", group = "Display")
fvgFill    = input.int(85, "Zone fill transparency", minval = 0, maxval = 100, group = "Display")
showActive = input.bool(true, "Only active (hide invalidated)", group = "Display")
hideMit    = input.bool(false, "Hide mitigated", group = "Display")
showW      = input.bool(true, "Show Weekly", inline = "s", group = "Display")
showD      = input.bool(true, "Show Daily",  inline = "s", group = "Display")
showH4     = input.bool(true, "Show 4H",     inline = "s", group = "Display")
colBull    = input.color(#26a69a, "Bullish (up)",   group = "Display")
colBear    = input.color(#ef5350, "Bearish (down)", group = "Display")
colMit     = input.color(#787b86, "Mitigated (dimmed)", group = "Display")
lineWid    = input.int(2, "Line width", minval = 1, maxval = 6, group = "Display")
showLbl    = input.bool(true, "Labels", group = "Display")

// ─── Validation (proof instruments — affect only the debug panel) ──────────
canonDays  = input.int(30, "Canonical hash window (days)", minval = 3, maxval = 365, group = "Validation",
     tooltip = "The cross-TF event hash covers events confirmed in the last N days — keep it inside the history every timeframe loads so the hash matches across resolutions.")
windowBars = input.int(1200, "Replay window (bars, must exceed 1000)", minval = 1050, group = "Validation")

// ═══════════════════════════════════════════════════════════════════════════
// 1 · PER-TIMEFRAME EVENT BOOK — runs INSIDE request.security on its own TF.
//     Swing registry + sweep/BOS detection + lifecycle all on that TF's own
//     bars, so the returned event book is identical regardless of chart TF.
// ═══════════════════════════════════════════════════════════════════════════
f_events() =>
    var array<float> shP = array.new<float>()   // swing-high prices (liquidity above)
    var array<bool>  shX = array.new<bool>()    // swept?
    var array<bool>  shB = array.new<bool>()    // broken (BOS'd)?
    var array<float> slP = array.new<float>()   // swing-low prices (liquidity below)
    var array<bool>  slX = array.new<bool>()
    var array<bool>  slB = array.new<bool>()
    var array<float> eL  = array.new<float>()   // level price (identity)
    var array<int>   eD  = array.new<int>()     // 1 bullish · 0 bearish
    var array<int>   eK  = array.new<int>()     // 0 sweep · 1 BOS
    var array<int>   eT  = array.new<int>()     // birth time (HTF bar time — chart-independent)
    var array<float> eX  = array.new<float>()   // extreme (invalidation reference)
    var array<bool>  eM  = array.new<bool>()    // mitigated (level revisited)
    var array<bool>  eV  = array.new<bool>()    // invalidated (extreme reclaimed)
    var int trend = -1                          // structure trend: 1 bull · 0 bear · -1 unset
    var float lastDnHi = na                     // last down-candle range (bullish OB source)
    var float lastDnLo = na
    var float lastUpHi = na                     // last up-candle range (bearish OB source)
    var float lastUpLo = na

    // 1a · lifecycle FIRST — so an event never mitigates on its own birth bar
    if eL.size() > 0
        for i = 0 to eL.size() - 1
            if not eV.get(i)
                bear = eD.get(i) == 0
                lvl  = eL.get(i)
                ext  = eX.get(i)
                if (bear and high >= lvl) or (not bear and low <= lvl)
                    eM.set(i, true)                       // level revisited
                if (bear and close > ext) or (not bear and close < ext)
                    eV.set(i, true)                       // extreme reclaimed → invalid

    // 1b · register newly-confirmed swings
    ph = ta.pivothigh(pivLen, pivLen)
    pl = ta.pivotlow(pivLen, pivLen)
    if not na(ph)
        shP.push(ph), shX.push(false), shB.push(false)
    if not na(pl)
        slP.push(pl), slX.push(false), slB.push(false)

    brkUp = false   // a bullish structure break (BOS or CHoCH up) fired this bar
    brkDn = false   // a bearish structure break fired this bar

    // 1c · resolve swing HIGHS: a close above = bullish BOS; a wick above with a
    //      close back below = bearish sweep. Each swing resolves once per kind.
    if shP.size() > 0
        for i = 0 to shP.size() - 1
            if not shB.get(i)
                sh = shP.get(i)
                if close > sh
                    shB.set(i, true)
                    knd = trend == 0 ? 2 : 1          // break UP against a bearish trend = CHoCH
                    trend := 1
                    brkUp := true
                    eL.push(sh), eD.push(1), eK.push(knd), eT.push(time), eX.push(sh), eM.push(false), eV.push(false)
                else if not shX.get(i) and high > sh and close < sh
                    shX.set(i, true)
                    eL.push(sh), eD.push(0), eK.push(0), eT.push(time), eX.push(high), eM.push(false), eV.push(false)

    // 1d · resolve swing LOWS: a close below = bearish BOS; a wick below with a
    //      close back above = bullish sweep.
    if slP.size() > 0
        for i = 0 to slP.size() - 1
            if not slB.get(i)
                sl = slP.get(i)
                if close < sl
                    slB.set(i, true)
                    knd = trend == 1 ? 2 : 1          // break DOWN against a bullish trend = CHoCH
                    trend := 0
                    brkDn := true
                    eL.push(sl), eD.push(0), eK.push(knd), eT.push(time), eX.push(sl), eM.push(false), eV.push(false)
                else if not slX.get(i) and low < sl and close > sl
                    slX.set(i, true)
                    eL.push(sl), eD.push(1), eK.push(0), eT.push(time), eX.push(low), eM.push(false), eV.push(false)

    // 1e · FVG (kind 3) — a 3-candle imbalance: bullish gap when c1.high < c3.low;
    //      bearish gap when c1.low > c3.high (c1 = 2 bars back, c3 = current).
    //      Micro-gaps below FVGMIN×ATR are skipped. eL = near edge (closest to
    //      price), eX = far edge, so the shared lifecycle reads mitigated on gap
    //      entry and invalidated when the gap is fully filled through.
    atr = ta.atr(14)
    if low > high[2] and (low - high[2]) >= atr * FVGMIN
        eL.push(low), eD.push(1), eK.push(3), eT.push(time), eX.push(high[2]), eM.push(false), eV.push(false)
    if high < low[2] and (low[2] - high) >= atr * FVGMIN
        eL.push(high), eD.push(0), eK.push(3), eT.push(time), eX.push(low[2]), eM.push(false), eV.push(false)

    // 1f · ORDER BLOCK (kind 4) — the last opposing candle before a structure
    //      break. Bullish OB = last down-candle before an up-break (its range is a
    //      support zone); bearish OB = last up-candle before a down-break. Uses
    //      lastDn/lastUp captured through the PREVIOUS bar, so the breaking bar is
    //      never its own OB. eL = near edge, eX = far edge (shared zone lifecycle).
    if brkUp and not na(lastDnHi)
        eL.push(lastDnHi), eD.push(1), eK.push(4), eT.push(time), eX.push(lastDnLo), eM.push(false), eV.push(false)
    if brkDn and not na(lastUpLo)
        eL.push(lastUpLo), eD.push(0), eK.push(4), eT.push(time), eX.push(lastUpHi), eM.push(false), eV.push(false)
    // update last up/down candle AFTER OB creation (breaking bar excluded from its own OB)
    if close < open
        lastDnHi := high
        lastDnLo := low
    else if close > open
        lastUpHi := high
        lastUpLo := low

    // 1g · bound memory (oldest swings / events age out first)
    if shP.size() > MAXSW
        shP.remove(0), shX.remove(0), shB.remove(0)
    if slP.size() > MAXSW
        slP.remove(0), slX.remove(0), slB.remove(0)
    if eL.size() > MAXEV
        eL.remove(0), eD.remove(0), eK.remove(0), eT.remove(0), eX.remove(0), eM.remove(0), eV.remove(0)

    [eL, eD, eK, eT, eX, eM, eV]   // eX carried: far edge of FVG zones (degenerate for point events)

// ═══════════════════════════════════════════════════════════════════════════
// 2 · FETCH FROZEN EVENT BOOKS (one security call per TF) + chart-indep. anchors
// ═══════════════════════════════════════════════════════════════════════════
[wL,  wD,  wK,  wT,  wX,  wM,  wV]  = request.security(syminfo.tickerid, "W",   f_events(), lookahead = barmerge.lookahead_off)
[dL,  dD,  dK,  dT,  dX,  dM,  dV]  = request.security(syminfo.tickerid, "D",   f_events(), lookahead = barmerge.lookahead_off)
[h4L, h4D, h4K, h4T, h4X, h4M, h4V] = request.security(syminfo.tickerid, "240", f_events(), lookahead = barmerge.lookahead_off)
atrD   = request.security(syminfo.tickerid, "D", ta.atr(14), lookahead = barmerge.lookahead_off)
atrRef = na(atrD) or atrD <= 0 ? close * 0.005 : atrD
dayOpen = request.security(syminfo.tickerid, "D", time, lookahead = barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════════════
// 3 · ONE PERSISTENT EVENT DATABASE — APPEND-ONLY UNION, WRITE-ONCE IDENTITY.
//     Identity = (level tick, kind, direction, timeframe). An event enters once
//     and never leaves; later bars only refresh live flags (mitigated / invalid).
//     Order-independent union ⇒ same hash on every chart TF; immutable per fixed
//     cut over time ⇒ freeze test.
// ═══════════════════════════════════════════════════════════════════════════
var array<float> EL   = array.new<float>()   // frozen level price
var array<int>   ED   = array.new<int>()     // 1 bullish · 0 bearish
var array<int>   EKd  = array.new<int>()     // 0 sweep · 1 BOS
var array<int>   ETf  = array.new<int>()     // 3 W · 2 D · 1 4H
var array<int>   EBt  = array.new<int>()     // frozen confirmation time
var array<float> EL2  = array.new<float>()   // far edge (FVG zone) — = EL for point events
var array<bool>  EM   = array.new<bool>()    // mitigated (live)
var array<bool>  EV   = array.new<bool>()    // invalidated (live)
var array<int>   EBir = array.new<int>()     // frozen birth bar_index
var map<int, int> Eidx = map.new<int, int>() // combined-key → array index (O(1) lookup)

f_ingest(bool use, array<float> l, array<int> d, array<int> k, array<int> t, array<float> x, array<bool> m, array<bool> v, int tf) =>
    if use and not na(l) and l.size() > 0
        for i = 0 to l.size() - 1
            px  = l.get(i)
            key = int(math.round(px / syminfo.mintick))
            ck  = key * 64 + k.get(i) * 8 + d.get(i) * 4 + tf   // kind ∈{0..4},dir,tf buckets disjoint (*64 > 39)
            if Eidx.contains(ck)
                idx = Eidx.get(ck)
                EM.set(idx, m.get(i)), EV.set(idx, v.get(i))    // refresh live flags only
            else
                EL.push(px), ED.push(d.get(i)), EKd.push(k.get(i)), ETf.push(tf), EBt.push(t.get(i)), EL2.push(x.get(i))
                EM.push(m.get(i)), EV.push(v.get(i))
                Eidx.put(ck, EL.size() - 1)
                EBir.push(bar_index)

f_ingest(true, wL,  wD,  wK,  wT,  wX,  wM,  wV,  3)
f_ingest(true, dL,  dD,  dK,  dT,  dX,  dM,  dV,  2)
f_ingest(true, h4L, h4D, h4K, h4T, h4X, h4M, h4V, 1)

// ═══════════════════════════════════════════════════════════════════════════
// 4 · EVENT DB HASH (canonical window) + counts for the debug panel
// ═══════════════════════════════════════════════════════════════════════════
canonCut = dayOpen - canonDays * 86400000
f_inWin(int i) => not na(dayOpen) and EBt.get(i) >= canonCut
f_hash() =>
    h = 0
    if EL.size() > 0
        for i = 0 to EL.size() - 1
            if not EV.get(i) and f_inWin(i)
                tickP = int(math.round(EL.get(i) / syminfo.mintick))
                lh = tickP * 131 + EKd.get(i) * 23 + ED.get(i) * 17 + ETf.get(i) * 7
                h := int(math.abs((h + lh) % 99999989))
    h
dbHash = f_hash()

// counts (active = not invalidated)
cActive = 0
cSweep = 0
cBOS = 0
cChoch = 0
cFVG = 0
cOB = 0
cBull = 0
cBear = 0
cMit = 0
cUnmit = 0
if EL.size() > 0
    for i = 0 to EL.size() - 1
        if not EV.get(i)
            cActive += 1
            if EKd.get(i) == 4
                cOB += 1
            else if EKd.get(i) == 3
                cFVG += 1
            else if EKd.get(i) == 2
                cChoch += 1
            else if EKd.get(i) == 1
                cBOS += 1
            else
                cSweep += 1
            if ED.get(i) == 1
                cBull += 1
            else
                cBear += 1
            if EM.get(i)
                cMit += 1
            else
                cUnmit += 1

// ═══════════════════════════════════════════════════════════════════════════
// 4b · REPLAY / FREEZE-INTEGRITY TEST — hashes only events whose write-once birth
//      bar ≤ last_bar − windowBars. Append-only + frozen identity ⇒ immutable
//      window, so the hash now / 500 / 1000 bars ago must match: A = B = C.
// ═══════════════════════════════════════════════════════════════════════════
f_whash(int cut) =>
    h = 0
    if EL.size() > 0
        for i = 0 to EL.size() - 1
            if EBir.get(i) <= cut
                key = int(math.round(EL.get(i) / syminfo.mintick))
                h := int(math.abs((h + key * 131 + EKd.get(i) * 23 + ED.get(i) * 17 + ETf.get(i) * 7) % 99999989))
    h
winCut = last_bar_index - windowBars
wHash  = f_whash(winCut)
rA = wHash
rB = wHash[500]
rC = wHash[1000]
replayPass = not na(rC) and rA == rB and rB == rC

// ═══════════════════════════════════════════════════════════════════════════
// 5 · RENDERER — READ-ONLY. Draws each active event at its level.
// ═══════════════════════════════════════════════════════════════════════════
f_show(int tf) => tf == 3 ? showW : tf == 2 ? showD : showH4
f_tag(int tf)  => tf == 3 ? "W" : tf == 2 ? "D" : "4H"
f_ecol(int i)  => EM.get(i) ? colMit : (ED.get(i) == 1 ? colBull : colBear)

// eligible = shown TF, shown kind, and passes the active / mitigated filters
f_eligible(int i) =>
    ok = f_show(ETf.get(i))
    kd = EKd.get(i)
    if (kd == 0 and not showSweep) or (kd == 1 and not showBOS) or (kd == 2 and not showChoch) or (kd == 3 and not showFVG) or (kd == 4 and not showOB)
        ok := false
    if showActive and EV.get(i)
        ok := false
    if hideMit and EM.get(i)
        ok := false
    ok

// PER (timeframe × kind) nearest-to-price budget: each kind on each timeframe
// gets its own n-nearest allowance, so enabling a kind ADDS its events and never
// displaces another kind's. Never moves an event; only limits count.
f_cutoff(int n, int tf, int kd) =>
    tmp = array.new<float>()
    if EL.size() > 0
        for i = 0 to EL.size() - 1
            if f_eligible(i) and ETf.get(i) == tf and EKd.get(i) == kd
                tmp.push(math.abs(close - EL.get(i)))
    cut = float(na)
    if tmp.size() > n and n > 0
        tmp.sort(order.ascending)
        cut := tmp.get(n - 1)
    cut
f_inbudget(int i, float cut) => na(cut) or math.abs(close - EL.get(i)) <= cut

var array<line>  drawn  = array.new<line>()
var array<label> drawnL = array.new<label>()
var array<box>   drawnBx = array.new<box>()

if barstate.islast
    if drawn.size() > 0
        for i = 0 to drawn.size() - 1
            line.delete(drawn.get(i))
    if drawnL.size() > 0
        for i = 0 to drawnL.size() - 1
            label.delete(drawnL.get(i))
    if drawnBx.size() > 0
        for i = 0 to drawnBx.size() - 1
            box.delete(drawnBx.get(i))
    drawn.clear(), drawnL.clear(), drawnBx.clear()
    cuts = array.new<float>(40, na)                  // one cutoff per (tf,kind): index tf*8+kd
    for tf = 1 to 3
        for kd = 0 to 4
            cuts.set(tf * 8 + kd, f_cutoff(maxEv, tf, kd))
    x2 = bar_index + 1
    if EL.size() > 0
        for i = 0 to EL.size() - 1
            tf = ETf.get(i)
            if f_eligible(i) and f_inbudget(i, cuts.get(tf * 8 + EKd.get(i)))
                lvl = EL.get(i)
                col = f_ecol(i)
                kd  = EKd.get(i)
                bt  = EBt.get(i)                                        // formation TIME (left anchor)
                // Everything is anchored at the bar it FORMED and drawn to the
                // current bar. Only Order Blocks project further right (extended
                // through), since an OB is a forward zone price returns to.
                ext = kd == 4 ? extend.right : extend.none
                if kd == 3 or kd == 4
                    // ZONE (FVG / OB) — box from near edge to far edge
                    top = math.max(lvl, EL2.get(i))
                    bot = math.min(lvl, EL2.get(i))
                    drawnBx.push(box.new(bt, top, time, bot, xloc = xloc.bar_time, extend = ext, border_color = col, border_width = 1, bgcolor = color.new(col, fvgFill)))
                    if showLbl
                        ztxt = kd == 4 ? "OB" : "FVG"
                        drawnL.push(label.new(x2, top, f_tag(tf) + " " + ztxt + " " + (ED.get(i) == 1 ? "▲" : "▼") + (EM.get(i) ? " ·mit" : ""), xloc = xloc.bar_index, style = label.style_label_left, color = col, textcolor = color.white, size = size.small))
                else
                    sty = kd == 0 ? line.style_dashed : line.style_solid   // sweep dashed; BOS/CHoCH solid
                    wid = kd == 2 ? lineWid + 1 : lineWid                  // CHoCH heavier (trend change)
                    drawn.push(line.new(bt, lvl, time, lvl, xloc = xloc.bar_time, extend = ext, color = col, width = wid, style = sty))
                    if showLbl
                        arrow = ED.get(i) == 1 ? "▲" : "▼"
                        ktxt  = kd == 2 ? "CHoCH" : kd == 1 ? "BOS" : "SWEEP"
                        mtag  = EM.get(i) ? " ·mit" : ""
                        drawnL.push(label.new(x2, lvl, f_tag(tf) + " " + ktxt + " " + arrow + mtag, xloc = xloc.bar_index, style = label.style_label_left, color = col, textcolor = color.white, size = size.small))

// ═══════════════════════════════════════════════════════════════════════════
// 6 · DEBUG PANEL — event DB hash + per-kind / lifecycle counts + freeze test
// ═══════════════════════════════════════════════════════════════════════════
var table hud = table.new(position.top_right, 2, 8, bgcolor = color.new(#0a1a3a, 10), border_width = 1, border_color = color.new(color.gray, 60))
if barstate.islast
    table.cell(hud, 0, 0, "EVENT HASH", text_color = color.white, text_size = size.normal)
    table.cell(hud, 1, 0, str.tostring(dbHash), text_color = #00e676, text_size = size.normal)
    table.cell(hud, 0, 1, "Active", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 1, str.tostring(cActive), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 2, "Sw/BOS/CH/FVG/OB", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 2, str.tostring(cSweep) + "/" + str.tostring(cBOS) + "/" + str.tostring(cChoch) + "/" + str.tostring(cFVG) + "/" + str.tostring(cOB), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 3, "Bull / Bear", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 3, str.tostring(cBull) + " / " + str.tostring(cBear), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 4, "Mit / Unmit", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 4, str.tostring(cMit) + " / " + str.tostring(cUnmit), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 5, "Total events", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 5, str.tostring(EL.size()), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 6, "Replay A/B/C", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 6, str.tostring(rA) + "/" + (na(rB) ? "—" : str.tostring(rB)) + "/" + (na(rC) ? "—" : str.tostring(rC)), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 7, "Freeze test", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 7, na(rC) ? "need 1000+ bars" : replayPass ? "PASS ✓" : "FAIL ✗", text_color = na(rC) ? color.gray : replayPass ? #00e676 : #ff1744, text_size = size.normal)
