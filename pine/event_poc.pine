// © Institutional Event Database — Deterministic MTF Proof of Concept (Phase 2)
//
// Detect events INSIDE request.security() on each timeframe's own CONFIRMED bars
// → freeze each as an immutable record → append-only union across timeframes →
// order-independent hash → time-based replay/freeze test → read-only renderer.
//
// Events (one unified stream, `kind` field):
//   0 SWEEP  — wick beyond a swing, close rejects back inside (liquidity grab)
//   1 BOS    — close beyond a prior swing in the trend direction
//   2 CHoCH  — a BOS against the trend (first opposing break)
//   3 FVG    — 3-candle imbalance on a displacement candle
//   4 OB     — last opposing candle before a displacement break
// Direction uniform: 1 = bullish, 0 = bearish.
//
// DETERMINISM (patched):
//  · events are emitted ONLY from confirmed HTF bars (no forming-candle repaint)
//  · each event carries a monotonic per-TF sequence id → distinct events never
//    merge, even at the same price/kind/dir/tf (repeated BOS, stacked zones)
//  · freeze test keys on birth TIME (chart-independent), not bar_index

//@version=6
indicator("IA-Event · Institutional Event DB POC", "IA-Evt POC", overlay = true,
     max_lines_count = 200, max_labels_count = 200, max_boxes_count = 200, max_bars_back = 80,
     calc_bars_count = 1600)
// calc_bars_count caps the script to the most recent 1600 chart bars. This bounds
// BOTH memory (fewer bars → fewer events → smaller request.security arrays, so it
// runs on every timeframe) AND the number of events formed, so the per-TF book
// stays under MAXEV and no frozen-window event is ever evicted → A=B=C stays valid.
// 1600 > the 1200-bar freeze window with warm-up to spare.

// ─── Market length — the ONLY detection input (it re-detects swings, so it moves
//     events and changes the DB hash: a detection parameter, not a display one) ──
pivLen   = input.int(5, "Market length (swing bars each side)", minval = 2, maxval = 30, group = "Structure",
     tooltip = "Institutional swing sensitivity — the pivot leg length used to find the swing highs/lows that seed sweeps, BOS and CHoCH. Larger = only bigger, more significant structure; smaller = more, finer events. This RE-DETECTS structure, so it changes which events exist and the DB hash (a detection input, not a display filter).")

// ─── Detection constants — FROZEN, NOT user inputs (the database is objective) ─
MAXSW    = 300    // per-TF swing registry cap
MAXEV    = 800    // per-TF event cap. Must exceed events formed within calc_bars_count so a
                  // frozen-window event is NEVER evicted (eviction would break the A=B=C freeze).
FVGMIN   = 0.15   // minimum FVG size in ATR
DISPBODY = 0.55   // displacement: breaking-candle body ≥ this × ATR ...
DISPRNG  = 1.00   // ... OR breaking-candle range ≥ this × ATR
IMPMIN   = 0.40   // FVG: middle (impulse) candle body ≥ this × ATR

// ─── Display (read-only — must never change the database) ──────────────────
maxEv      = input.int(8, "Max events per timeframe & kind", minval = 1, maxval = 40, group = "Display",
     tooltip = "Applied per timeframe AND per kind: each shows up to this many, nearest to price first. Never moves an event; only limits count.")
showSweep  = input.bool(true, "Sweeps", inline = "k", group = "Display")
showBOS    = input.bool(true, "BOS",    inline = "k", group = "Display")
showChoch  = input.bool(true, "CHoCH",  inline = "k", group = "Display")
showFVG    = input.bool(true, "FVG",    inline = "k", group = "Display")
showOB     = input.bool(true, "OB",     inline = "k", group = "Display")
fvgFill    = input.int(85, "Zone fill transparency", minval = 0, maxval = 100, group = "Display")
showActive = input.bool(true, "Only active (hide invalidated)", group = "Display")
hideMit    = input.bool(false, "Hide mitigated", group = "Display")
showW      = input.bool(true, "Show Weekly", inline = "s", group = "Display")
showD      = input.bool(true, "Show Daily",  inline = "s", group = "Display")
showH4     = input.bool(true, "Show 4H",     inline = "s", group = "Display")
colBull    = input.color(#26a69a, "Bullish (up)",   group = "Display")
colBear    = input.color(#ef5350, "Bearish (down)", group = "Display")
colMit     = input.color(#787b86, "Mitigated (dimmed)", group = "Display")
lineWid    = input.int(2, "Line width", minval = 1, maxval = 6, group = "Display")
showLbl    = input.bool(true, "Labels", group = "Display")

// ─── Validation (proof instruments — affect only the debug panel) ──────────
canonDays  = input.int(30, "Canonical hash window (days)", minval = 3, maxval = 365, group = "Validation",
     tooltip = "The cross-TF EVENT HASH covers events confirmed in the last N days — keep it inside the history every timeframe loads so the hash matches across resolutions.")
windowBars = input.int(1200, "Replay window (bars, must exceed 1000)", minval = 1050, group = "Validation")

// ═══════════════════════════════════════════════════════════════════════════
// 1 · PER-TIMEFRAME EVENT BOOK — runs INSIDE request.security on its own TF.
//     Everything is gated on barstate.isconfirmed so ONLY closed HTF bars emit
//     or age events — a forming HTF candle can never freeze a record (no repaint).
// ═══════════════════════════════════════════════════════════════════════════
f_events() =>
    var array<float> shP = array.new<float>()   // swing-high prices
    var array<bool>  shX = array.new<bool>()    // swept?
    var array<bool>  shB = array.new<bool>()    // broken (BOS'd)?
    var array<float> slP = array.new<float>()   // swing-low prices
    var array<bool>  slX = array.new<bool>()
    var array<bool>  slB = array.new<bool>()
    var array<float> eL  = array.new<float>()   // near-edge / level price
    var array<int>   eD  = array.new<int>()     // 1 bullish · 0 bearish
    var array<int>   eK  = array.new<int>()     // 0 sweep 1 BOS 2 CHoCH 3 FVG 4 OB
    var array<int>   eT  = array.new<int>()     // birth time (HTF bar time — chart-independent)
    var array<float> eX  = array.new<float>()   // far edge / invalidation extreme
    var array<bool>  eM  = array.new<bool>()    // mitigated (live)
    var array<bool>  eV  = array.new<bool>()    // invalidated (live)
    var array<int>   eSq = array.new<int>()     // per-TF sequence id (identity disambiguator)
    var int eSeq = 0                            // monotonic event counter
    var int trend = -1                          // structure trend: 1 bull · 0 bear · -1 unset
    var float lastDnHi = na                     // last down-candle range (bullish OB source)
    var float lastDnLo = na
    var float lastUpHi = na                     // last up-candle range (bearish OB source)
    var float lastUpLo = na

    // ta.* are stateful — call EVERY bar (never conditionally), use results inside the guard
    atr  = ta.atr(14)
    ph   = ta.pivothigh(pivLen, pivLen)
    pl   = ta.pivotlow(pivLen, pivLen)
    body = math.abs(close - open)
    disp = body >= atr * DISPBODY or (high - low) >= atr * DISPRNG   // impulse / displacement bar

    if barstate.isconfirmed
        // 1a · lifecycle FIRST (kind-appropriate via each event's own lvl/ext):
        //   mitigated = price touches the level / enters the zone (retest);
        //   invalidated = close beyond the far edge / extreme (zone fill, structure
        //   failure, or sweep reclaim). Never mitigates on its own birth bar.
        if eL.size() > 0
            for i = 0 to eL.size() - 1
                if not eV.get(i)
                    bear = eD.get(i) == 0
                    lvl  = eL.get(i)
                    ext  = eX.get(i)
                    if (bear and high >= lvl) or (not bear and low <= lvl)
                        eM.set(i, true)
                    if (bear and close > ext) or (not bear and close < ext)
                        eV.set(i, true)

        // 1b · register newly-confirmed swings (ph/pl computed above, every bar)
        if not na(ph)
            shP.push(ph), shX.push(false), shB.push(false)
        if not na(pl)
            slP.push(pl), slX.push(false), slB.push(false)

        brkUp = false
        brkDn = false

        // 1c · swing HIGHS → bullish BOS/CHoCH on close-through, bearish sweep on wick+reject
        if shP.size() > 0
            for i = 0 to shP.size() - 1
                if not shB.get(i)
                    sh = shP.get(i)
                    if close > sh
                        shB.set(i, true)
                        knd = trend == 0 ? 2 : 1
                        trend := 1
                        brkUp := true
                        eL.push(sh), eD.push(1), eK.push(knd), eT.push(time), eX.push(sh), eM.push(false), eV.push(false), eSq.push(eSeq)
                        eSeq += 1
                    else if not shX.get(i) and high > sh and close < sh
                        shX.set(i, true)
                        eL.push(sh), eD.push(0), eK.push(0), eT.push(time), eX.push(high), eM.push(false), eV.push(false), eSq.push(eSeq)
                        eSeq += 1

        // 1d · swing LOWS → bearish BOS/CHoCH on close-through, bullish sweep on wick+reject
        if slP.size() > 0
            for i = 0 to slP.size() - 1
                if not slB.get(i)
                    sl = slP.get(i)
                    if close < sl
                        slB.set(i, true)
                        knd = trend == 1 ? 2 : 1
                        trend := 0
                        brkDn := true
                        eL.push(sl), eD.push(0), eK.push(knd), eT.push(time), eX.push(sl), eM.push(false), eV.push(false), eSq.push(eSeq)
                        eSeq += 1
                    else if not slX.get(i) and low < sl and close > sl
                        slX.set(i, true)
                        eL.push(sl), eD.push(1), eK.push(0), eT.push(time), eX.push(low), eM.push(false), eV.push(false), eSq.push(eSeq)
                        eSeq += 1

        // 1e · FVG (kind 3) — 3-candle imbalance on a displacement middle candle.
        //      Gap ≥ FVGMIN×ATR AND the middle (impulse) candle body ≥ IMPMIN×ATR,
        //      so random micro-gaps in chop are skipped. eL = near edge, eX = far.
        imp = math.abs(close[1] - open[1]) >= atr * IMPMIN
        if imp and low > high[2] and (low - high[2]) >= atr * FVGMIN
            eL.push(low), eD.push(1), eK.push(3), eT.push(time), eX.push(high[2]), eM.push(false), eV.push(false), eSq.push(eSeq)
            eSeq += 1
        if imp and high < low[2] and (low[2] - high) >= atr * FVGMIN
            eL.push(high), eD.push(0), eK.push(3), eT.push(time), eX.push(low[2]), eM.push(false), eV.push(false), eSq.push(eSeq)
            eSeq += 1

        // 1f · ORDER BLOCK (kind 4) — last opposing candle before a DISPLACEMENT
        //      break (weak drift breaks emit no OB). eL = near edge, eX = far edge.
        if brkUp and disp and not na(lastDnHi)
            eL.push(lastDnHi), eD.push(1), eK.push(4), eT.push(time), eX.push(lastDnLo), eM.push(false), eV.push(false), eSq.push(eSeq)
            eSeq += 1
        if brkDn and disp and not na(lastUpLo)
            eL.push(lastUpLo), eD.push(0), eK.push(4), eT.push(time), eX.push(lastUpHi), eM.push(false), eV.push(false), eSq.push(eSeq)
            eSeq += 1
        // update last up/down candle AFTER OB creation (breaking bar excluded from its own OB)
        if close < open
            lastDnHi := high
            lastDnLo := low
        else if close > open
            lastUpHi := high
            lastUpLo := low

        // 1g · bound memory (oldest swings / events age out first)
        if shP.size() > MAXSW
            shP.remove(0), shX.remove(0), shB.remove(0)
        if slP.size() > MAXSW
            slP.remove(0), slX.remove(0), slB.remove(0)
        if eL.size() > MAXEV
            eL.remove(0), eD.remove(0), eK.remove(0), eT.remove(0), eX.remove(0), eM.remove(0), eV.remove(0), eSq.remove(0)

    [eL, eD, eK, eT, eX, eM, eV, eSq]

// ═══════════════════════════════════════════════════════════════════════════
// 2 · FETCH FROZEN EVENT BOOKS (one security call per TF) + chart-indep. anchors
//
//     RE10139 fix for high chart timeframes: request.security() of a timeframe
//     BELOW the chart TF replays that lower TF's ENTIRE history in-security
//     (≈6× the chart bars on 1D for the 4H book, ≈30× on 1W), exhausting memory
//     on 1D/1W. So a book is only BUILT-and-MERGED when its native TF ≥ the chart
//     TF; otherwise its request is clamped to the chart TF (a cheap same-TF call)
//     and the book is dropped from the union. Sub-chart events are not shown on a
//     higher chart. The freeze test is a same-chart invariant, so it is unaffected.
// ═══════════════════════════════════════════════════════════════════════════
f_reqtf(string tf) => timeframe.in_seconds(tf) < timeframe.in_seconds() ? timeframe.period : tf
useW  = timeframe.in_seconds("W")   >= timeframe.in_seconds()
useD  = timeframe.in_seconds("D")   >= timeframe.in_seconds()
use4  = timeframe.in_seconds("240") >= timeframe.in_seconds()
[wL,  wD,  wK,  wT,  wX,  wM,  wV,  wS]  = request.security(syminfo.tickerid, f_reqtf("W"),   f_events(), lookahead = barmerge.lookahead_off)
[dL,  dD,  dK,  dT,  dX,  dM,  dV,  dS]  = request.security(syminfo.tickerid, f_reqtf("D"),   f_events(), lookahead = barmerge.lookahead_off)
[h4L, h4D, h4K, h4T, h4X, h4M, h4V, h4S] = request.security(syminfo.tickerid, f_reqtf("240"), f_events(), lookahead = barmerge.lookahead_off)
dayOpen = request.security(syminfo.tickerid, f_reqtf("D"), time, lookahead = barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════════════
// 3 · ONE PERSISTENT EVENT DATABASE — APPEND-ONLY UNION, WRITE-ONCE IDENTITY.
//     Identity = (timeframe, per-TF sequence id) — globally unique, so distinct
//     events NEVER merge (repeated BOS/sweeps, stacked FVG/OB all kept). An event
//     enters once and never leaves; later bars only refresh live flags.
// ═══════════════════════════════════════════════════════════════════════════
var array<float> EL   = array.new<float>()   // near-edge / level price
var array<int>   ED   = array.new<int>()     // 1 bullish · 0 bearish
var array<int>   EKd  = array.new<int>()     // kind 0..4
var array<int>   ETf  = array.new<int>()     // 3 W · 2 D · 1 4H
var array<int>   EBt  = array.new<int>()     // frozen birth time (chart-independent)
var array<float> EL2  = array.new<float>()   // far edge (zones) — = EL for point events
var array<bool>  EM   = array.new<bool>()    // mitigated (live)
var array<bool>  EV   = array.new<bool>()    // invalidated (live)

// REBUILT each bar from the (bounded) per-TF books, so the union never grows
// unbounded (fixes the memory limit). The books are append-only and carry live
// mitigated/invalidated flags, so the rebuilt union is deterministic and
// cross-TF-identical; a confirmed event never moves. No map/identity needed.
f_ingest(bool use, array<float> l, array<int> d, array<int> k, array<int> t, array<float> x, array<bool> m, array<bool> v, int tf) =>
    if use and not na(l) and l.size() > 0
        for i = 0 to l.size() - 1
            EL.push(l.get(i)), ED.push(d.get(i)), EKd.push(k.get(i)), ETf.push(tf), EBt.push(t.get(i)), EL2.push(x.get(i)), EM.push(m.get(i)), EV.push(v.get(i))

EL.clear(), ED.clear(), EKd.clear(), ETf.clear(), EBt.clear(), EL2.clear(), EM.clear(), EV.clear()
f_ingest(useW, wL,  wD,  wK,  wT,  wX,  wM,  wV,  3)
f_ingest(useD, dL,  dD,  dK,  dT,  dX,  dM,  dV,  2)
f_ingest(use4, h4L, h4D, h4K, h4T, h4X, h4M, h4V, 1)

// ═══════════════════════════════════════════════════════════════════════════
// 4 · EVENT DB HASH (canonical time window) + counts. Content hash folds near +
//     far edge, kind, direction, timeframe — so stacked/distinct events differ.
// ═══════════════════════════════════════════════════════════════════════════
canonCut = dayOpen - canonDays * 86400000
f_inWin(int i) => not na(dayOpen) and EBt.get(i) >= canonCut
f_lh(int i) =>
    tn = int(math.round(EL.get(i) / syminfo.mintick))
    tf2 = int(math.round(EL2.get(i) / syminfo.mintick))
    tn * 131 + tf2 * 53 + EKd.get(i) * 23 + ED.get(i) * 17 + ETf.get(i) * 7
f_hash() =>
    h = 0
    if EL.size() > 0
        for i = 0 to EL.size() - 1
            if not EV.get(i) and f_inWin(i)
                h := int(math.abs((h + f_lh(i)) % 99999989))
    h
dbHash = f_hash()

// counts (active = not invalidated)
cActive = 0
cSweep = 0
cBOS = 0
cChoch = 0
cFVG = 0
cOB = 0
cBull = 0
cBear = 0
cMit = 0
cUnmit = 0
if EL.size() > 0
    for i = 0 to EL.size() - 1
        if not EV.get(i)
            cActive += 1
            k = EKd.get(i)
            cOB    += k == 4 ? 1 : 0
            cFVG   += k == 3 ? 1 : 0
            cChoch += k == 2 ? 1 : 0
            cBOS   += k == 1 ? 1 : 0
            cSweep += k == 0 ? 1 : 0
            cBull  += ED.get(i) == 1 ? 1 : 0
            cBear  += ED.get(i) == 0 ? 1 : 0
            cMit   += EM.get(i) ? 1 : 0
            cUnmit += EM.get(i) ? 0 : 1

// ═══════════════════════════════════════════════════════════════════════════
// 4b · TIME-BASED REPLAY / FREEZE TEST — hashes events whose frozen birth TIME is
//      at/before the timestamp of bar (last_bar − windowBars). Birth time is
//      chart-independent and the cutoff is captured once, so the hash sampled
//      now / 500 / 1000 bars ago must match on a non-repainting engine: A=B=C.
// ═══════════════════════════════════════════════════════════════════════════
var int freezeCutT = na
if bar_index == last_bar_index - windowBars
    freezeCutT := time
f_whash(int cutT) =>
    h = 0
    if not na(cutT) and EL.size() > 0
        for i = 0 to EL.size() - 1
            if EBt.get(i) <= cutT
                h := int(math.abs((h + f_lh(i)) % 99999989))
    h
wHash = f_whash(freezeCutT)
// Capture the frozen-window hash at three fixed anchor bars into var scalars — NO
// series-history indexing (wHash[500]/[1000]) that would force Pine to buffer 1000
// bars of every series, including the request.security arrays, and exceed the
// memory limit (RE10139) on deep-history forex. A = B = C ⇒ freeze integrity.
var int rA = na
var int rB = na
var int rC = na
if bar_index == last_bar_index
    rA := wHash
if bar_index == last_bar_index - 500
    rB := wHash
if bar_index == last_bar_index - 1000
    rC := wHash
replayPass = not na(rC) and rA == rB and rB == rC

// ═══════════════════════════════════════════════════════════════════════════
// 5 · RENDERER — READ-ONLY. Eligibility precomputed ONCE per event; cutoffs and
//     the draw pass reuse it (single eligibility scan instead of many).
// ═══════════════════════════════════════════════════════════════════════════
f_show(int tf) => tf == 3 ? showW : tf == 2 ? showD : showH4
f_tag(int tf)  => tf == 3 ? "W" : tf == 2 ? "D" : "4H"
f_ecol(int i)  => EM.get(i) ? colMit : (ED.get(i) == 1 ? colBull : colBear)
f_kshow(int k) => k == 0 ? showSweep : k == 1 ? showBOS : k == 2 ? showChoch : k == 3 ? showFVG : showOB

var array<line>  drawn  = array.new<line>()
var array<label> drawnL = array.new<label>()
var array<box>   drawnBx = array.new<box>()

if barstate.islast
    if drawn.size() > 0
        for i = 0 to drawn.size() - 1
            line.delete(drawn.get(i))
    if drawnL.size() > 0
        for i = 0 to drawnL.size() - 1
            label.delete(drawnL.get(i))
    if drawnBx.size() > 0
        for i = 0 to drawnBx.size() - 1
            box.delete(drawnBx.get(i))
    drawn.clear(), drawnL.clear(), drawnBx.clear()

    n = EL.size()
    // one pass: eligibility per event (reused by cutoffs and draw)
    elig = array.new<bool>(n, false)
    if n > 0
        for i = 0 to n - 1
            ok = f_show(ETf.get(i)) and f_kshow(EKd.get(i))
            if showActive and EV.get(i)
                ok := false
            if hideMit and EM.get(i)
                ok := false
            elig.set(i, ok)
    // cutoffs per (tf,kind): index tf*8+kd, computed from the precomputed elig set
    cuts = array.new<float>(40, na)
    for tf = 1 to 3
        for kd = 0 to 4
            tmp = array.new<float>()
            if n > 0
                for i = 0 to n - 1
                    if elig.get(i) and ETf.get(i) == tf and EKd.get(i) == kd
                        tmp.push(math.abs(close - EL.get(i)))
            if tmp.size() > maxEv and maxEv > 0
                tmp.sort(order.ascending)
                cuts.set(tf * 8 + kd, tmp.get(maxEv - 1))

    if n > 0
        for i = 0 to n - 1
            if elig.get(i)
                cut = cuts.get(ETf.get(i) * 8 + EKd.get(i))
                if na(cut) or math.abs(close - EL.get(i)) <= cut
                    tf  = ETf.get(i)
                    lvl = EL.get(i)
                    col = f_ecol(i)
                    kd  = EKd.get(i)
                    bt  = EBt.get(i)
                    ext = kd == 4 ? extend.right : extend.none   // only Order Blocks project right
                    if kd == 3 or kd == 4
                        top = math.max(lvl, EL2.get(i))
                        bot = math.min(lvl, EL2.get(i))
                        drawnBx.push(box.new(bt, top, time, bot, xloc = xloc.bar_time, extend = ext, border_color = col, border_width = 1, bgcolor = color.new(col, fvgFill)))
                        if showLbl
                            ztxt = kd == 4 ? "OB" : "FVG"
                            drawnL.push(label.new(bar_index + 1, top, f_tag(tf) + " " + ztxt + " " + (ED.get(i) == 1 ? "▲" : "▼") + (EM.get(i) ? " ·mit" : ""), xloc = xloc.bar_index, style = label.style_label_left, color = col, textcolor = color.white, size = size.small))
                    else
                        sty = kd == 0 ? line.style_dashed : line.style_solid
                        wid = kd == 2 ? lineWid + 1 : lineWid
                        drawn.push(line.new(bt, lvl, time, lvl, xloc = xloc.bar_time, extend = ext, color = col, width = wid, style = sty))
                        if showLbl
                            ktxt = kd == 2 ? "CHoCH" : kd == 1 ? "BOS" : "SWEEP"
                            drawnL.push(label.new(bar_index + 1, lvl, f_tag(tf) + " " + ktxt + " " + (ED.get(i) == 1 ? "▲" : "▼") + (EM.get(i) ? " ·mit" : ""), xloc = xloc.bar_index, style = label.style_label_left, color = col, textcolor = color.white, size = size.small))

// ═══════════════════════════════════════════════════════════════════════════
// 6 · DEBUG PANEL — event DB hash + per-kind / lifecycle counts + freeze test
// ═══════════════════════════════════════════════════════════════════════════
var table hud = table.new(position.top_right, 2, 8, bgcolor = color.new(#0a1a3a, 10), border_width = 1, border_color = color.new(color.gray, 60))
if barstate.islast
    table.cell(hud, 0, 0, "EVENT HASH", text_color = color.white, text_size = size.normal)
    table.cell(hud, 1, 0, str.tostring(dbHash), text_color = #00e676, text_size = size.normal)
    table.cell(hud, 0, 1, "Active", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 1, str.tostring(cActive), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 2, "Sw/BOS/CH/FVG/OB", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 2, str.tostring(cSweep) + "/" + str.tostring(cBOS) + "/" + str.tostring(cChoch) + "/" + str.tostring(cFVG) + "/" + str.tostring(cOB), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 3, "Bull / Bear", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 3, str.tostring(cBull) + " / " + str.tostring(cBear), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 4, "Mit / Unmit", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 4, str.tostring(cMit) + " / " + str.tostring(cUnmit), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 5, "Total events", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 5, str.tostring(EL.size()), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 6, "Replay A/B/C", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 6, str.tostring(rA) + "/" + (na(rB) ? "—" : str.tostring(rB)) + "/" + (na(rC) ? "—" : str.tostring(rC)), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 7, "Freeze test", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 7, na(rC) ? "need 1000+ bars" : replayPass ? "PASS ✓" : "FAIL ✗", text_color = na(rC) ? color.gray : replayPass ? #00e676 : #ff1744, text_size = size.normal)
