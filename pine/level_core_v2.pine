//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// LEVEL CORE v2 — Multi-degree, CROSS-TIMEFRAME (Module 1, frozen foundation)
//
//  Levels are sourced from FIXED timeframes (1H / 4H / 1D / 1W) via
//  request.security — NEVER from the chart's own candles. Consequences:
//   • SAME level prices on every chart TF (1m … 1W) — identical, by construction.
//   • Each level's interactions are counted on ITS OWN degree's bars, so its
//     event log & stats are identical no matter which chart you view.
//   • Only degrees ≥ the chart TF are shown (keeps the HTF data complete).
//  Inherits the v1 event engine (validated): immutable anchors, event-sourced
//  stats, closed-bar-only detection (no repaint), zone-while-interacting.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Level Core v2 [multi-degree cross-TF]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=5000)

gD = "Detection"
pivLen  = input.int(5, "Swing size (pivot L/R, per degree)", minval=2, maxval=50, group=gD)
bandPct = input.float(0.40, "Level band (% of price)", minval=0.02, maxval=5.0, step=0.02, group=gD)
maxLvls = input.int(60, "Max levels tracked (centered on price)", minval=8, maxval=120, group=gD)
maxEv   = input.int(40, "Timeline length (events per level)", minval=5, maxval=80, group=gD)
minShow = input.int(1, "Min interactions to show (LIVE always shows)", minval=0, maxval=20, group=gD)

gG = "Degrees"
use1H = input.bool(true, "1H levels", group=gG)
use4H = input.bool(true, "4H levels", group=gG)
use1D = input.bool(true, "1D levels", group=gG)
use1W = input.bool(true, "1W levels", group=gG)

gC = "Confidence Scoring (institutional)"
minConf   = input.float(0.0, "Min confidence to show (LIVE always shows)", minval=0.0, maxval=100.0, step=5.0, group=gC)
topN      = input.int(3, "★ Star the strongest N levels", minval=0, maxval=20, group=gC)
showAudit = input.bool(true, "Show confidence AUDIT breakdown (★ levels, on hover)", group=gC)
decayBars = input.float(150.0, "Strength half-life (bars) — older interactions fade", minval=10.0, maxval=5000.0, group=gC)
sepNorm   = input.float(20.0, "Touch separation norm (bars) — clustered = penalised", minval=1.0, maxval=500.0, group=gC)
dispNorm  = input.float(2.0, "ATR displacement for full credit (band-units)", minval=0.5, maxval=10.0, step=0.5, group=gC)
evidNorm  = input.float(5.0, "Interactions for full 'evidence'", minval=1.0, maxval=30.0, group=gC)
wWin   = input.float(0.28, "Weight: win rate (held vs break)", minval=0.0, maxval=1.0, step=0.02, group=gC)
wRej   = input.float(0.20, "Weight: rejection quality (wick/body)", minval=0.0, maxval=1.0, step=0.02, group=gC)
wDisp  = input.float(0.16, "Weight: ATR displacement after touch", minval=0.0, maxval=1.0, step=0.02, group=gC)
wSweep = input.float(0.12, "Weight: liquidity sweep before reaction", minval=0.0, maxval=1.0, step=0.02, group=gC)
wSep   = input.float(0.12, "Weight: touch separation (anti-cluster)", minval=0.0, maxval=1.0, step=0.02, group=gC)
wEvid  = input.float(0.12, "Weight: evidence (# recent interactions)", minval=0.0, maxval=1.0, step=0.02, group=gC)

gLn = "Appearance — Lines"
lineStyleIn = input.string("Solid", "Line style", options=["Solid", "Dashed", "Dotted"], group=gLn)
lineWidth   = input.int(1, "Line width", minval=1, maxval=6, group=gLn)
emphWidth   = input.int(3, "LIVE / ★ line width", minval=1, maxval=8, group=gLn)
colByDeg    = input.bool(false, "Color lines by degree (TF) instead of R/S", group=gLn)
resCol  = input.color(#ef5350, "Resistance", group=gLn)
supCol  = input.color(#26a69a, "Support", group=gLn)
c1Hcol  = input.color(#787b86, "1H colour (degree mode)", group=gLn)
c4Hcol  = input.color(#42bda8, "4H colour (degree mode)", group=gLn)
c1Dcol  = input.color(#5b9cf6, "1D colour (degree mode)", group=gLn)
c1Wcol  = input.color(#c07cff, "1W colour (degree mode)", group=gLn)
extMode = input.string("Left", "Extend", options=["Left", "Right", "Both", "None"], group=gLn)
extR    = input.int(30, "Extend right (bars)", minval=0, maxval=200, group=gLn)

gZ = "Appearance — Active Zone"
showActiveZone = input.bool(true, "Active zone ON  (OFF → show the line instead)", group=gZ, tooltip="When a level is being touched it expands into a zone. Turn OFF to keep it as a plain regional line at all times.")
zoneCol  = input.color(#ffd24a, "Zone fill", group=gZ)
zoneOp   = input.int(85, "Zone fill transparency", minval=0, maxval=100, group=gZ)
zoneBord = input.int(1, "Zone border width", minval=0, maxval=4, group=gZ)

gLb = "Appearance — Labels"
showLbl    = input.bool(true, "Show labels", group=gLb)
lblSize    = input.string("Small", "Label size", options=["Tiny", "Small", "Normal"], group=gLb)
lblSide    = input.string("Right", "Label side", options=["Right", "Left"], group=gLb)
showConf   = input.bool(true, "Show CONF in label", group=gLb)
showStats  = input.bool(true, "Show event stats line", group=gLb)
showDegTag = input.bool(true, "Show degree tag", group=gLb)
lblOp      = input.int(20, "Label background transparency", minval=0, maxval=100, group=gLb)

gM = "Confluence Merge (liquidity zones)"
mergeOn      = input.bool(true, "Merge clustered levels into one zone", group=gM, tooltip="OFF = every level shows as its own line. ON = nearby levels (a liquidity shelf) collapse into a single zone with combined strength. Underlying levels & memory are preserved.")
mergeBandPct = input.float(0.80, "Merge band (% of price)", minval=0.05, maxval=10.0, step=0.05, group=gM)
conflBonus   = input.float(6.0, "Confluence bonus per extra level (strength)", minval=0.0, maxval=30.0, step=1.0, group=gM)
mergeCol     = input.color(#ff9800, "Liquidity-zone fill", group=gM)
mergeOp      = input.int(80, "Liquidity-zone transparency", minval=0, maxval=100, group=gM)

gNz = "Manual Nudge (LIVE floor / ceiling)"
nudgeCeil  = input.float(0.0, "Nudge nearest RESISTANCE / ceiling (% of price)", minval=-2.0, maxval=2.0, step=0.01, group=gNz, tooltip="Presentation only. Shift the nearest level ABOVE price (the ceiling price is about to hit) up/down a hair to sit it on the exact wick. Does not change the level, its memory, or its score.")
nudgeFloor = input.float(0.0, "Nudge nearest SUPPORT / floor (% of price)", minval=-2.0, maxval=2.0, step=0.01, group=gNz, tooltip="Presentation only. Shift the nearest level BELOW price (the floor price is about to hit).")

gE = "Entry Engine (liquidity-first) — M4"
useEntry    = input.bool(true, "Enable liquidity-first entry signals", group=gE, tooltip="Flow: HTF bias → target liquidity → SWEEP of a strong LIVE level → quality rejection → LTF structure sequence (SHORT: LH then LL · LONG: HL then HH) → signal toward the opposing level. Signals are visual/alerts only — paper trading.")
entryBiasSw = input.int(5, "Bias Swing Size (W/D/4H/1H sequence classifier)", minval=2, maxval=30, group=gE, tooltip="Same HH+HL / LH+LL sequence rule as MS-Core, weighted W .40 D .30 4H .20 1H .10 with a ±0.15 deadband. MIXED bias = no signals.")
maxExecTF   = input.timeframe("5", "Max execution timeframe (engine off above this)", group=gE, tooltip="Execution belongs on 1m–5m. On any chart TF above this the engine stays idle (levels/bias still display).")
entryMinCnf = input.float(40.0, "Min level strength to arm (CONF + confluence)", minval=0.0, maxval=100.0, step=5.0, group=gE, tooltip="The swept level's confidence plus its confluence bonus (neighbours within the merge band) must reach this. Weak levels never arm — they get logged as rejected setups.")
rejMin      = input.float(0.5, "Min rejection quality of the sweep bar (0-1)", minval=0.0, maxval=1.0, step=0.05, group=gE, tooltip="SHORT: (high−close)/range · LONG: (close−low)/range of the sweep bar. Same wick/body measure the event engine logs. Low-quality rejections are logged, not armed.")
ltfPiv      = input.int(2, "LTF pivot size for LH / HL (bars each side)", minval=1, maxval=10, group=gE)
seqWindow   = input.int(20, "Max bars from sweep to entry", minval=3, maxval=100, group=gE)
coolBars    = input.int(10, "Cooldown after a signal (bars)", minval=0, maxval=200, group=gE)
showSwpMark = input.bool(true, "Mark armed sweeps (✕)", group=gE)
showTrdLn   = input.bool(true, "Draw entry / stop / target lines on signal", group=gE)
showEPanel  = input.bool(true, "Show entry-state panel (hover REJECTED = reasons log)", group=gE)

f_sz(s) => s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small
f_degTxt(int d) => d == 0 ? "1H" : d == 1 ? "4H" : d == 2 ? "1D" : "1W"
f_lstyle(s) => s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid
f_ext(s) => s == "Right" ? extend.right : s == "Both" ? extend.both : s == "None" ? extend.none : extend.left
f_degCol(int d) => d == 0 ? c1Hcol : d == 1 ? c4Hcol : d == 2 ? c1Dcol : c1Wcol

// a degree is active only if its timeframe is ≥ the chart timeframe
chartSec = timeframe.in_seconds(timeframe.period)
a1H = use1H and timeframe.in_seconds("60")  >= chartSec
a4H = use4H and timeframe.in_seconds("240") >= chartSec
a1D = use1D and timeframe.in_seconds("D")   >= chartSec
a1W = use1W and timeframe.in_seconds("W")   >= chartSec

type Ev
    int   bar
    int   t
    int   kind        // 1 touch, 2 held, 3 break, 4 retest
    float react       // measured: degree-bar excursion vs level, in band-units
    float rejQ        // measured: rejection quality 0..1 (close pulled back from the extreme)
    bool  swept       // measured: wick swept beyond the level then closed back

type Lvl
    float anchor
    int   deg
    bool  inside
    int   entSide
    float testHi
    float testLo
    bool  brokenLast
    array<Ev> log

var array<Lvl> book = array.new<Lvl>()

f_log(Lvl L, int kind, int bar, int t, float react, float rejQ, bool swept) =>
    array.push(L.log, Ev.new(bar, t, kind, react, rejQ, swept))
    if array.size(L.log) > maxEv
        array.shift(L.log)

f_count(Lvl L, int kind) =>
    int c = 0
    if array.size(L.log) > 0
        for i = 0 to array.size(L.log) - 1
            if array.get(L.log, i).kind == kind
                c += 1
    c

f_create(float px, int deg, int bar, int t) =>
    L = Lvl.new(px, deg, false, 0, na, na, false, array.new<Ev>())
    array.push(L.log, Ev.new(bar, t, 2, 0.0, 0.0, false))     // founding rejection (held)
    array.push(book, L)

// found a level of a given degree; anchor immutable; keep book centered on price
f_found(float px, int deg, int bar, int t) =>
    if not na(px)
        band = px * bandPct / 100.0
        exists = false
        if array.size(book) > 0
            for i = 0 to array.size(book) - 1
                if array.get(book, i).deg == deg and math.abs(array.get(book, i).anchor - px) <= band
                    exists := true
                    break
        if not exists
            if array.size(book) < maxLvls
                f_create(px, deg, bar, t)
            else
                int far = -1
                float fard = math.abs(px - close)
                for i = 0 to array.size(book) - 1
                    d = math.abs(array.get(book, i).anchor - close)
                    if d > fard
                        fard := d
                        far := i
                if far >= 0
                    array.remove(book, far)
                    f_create(px, deg, bar, t)

// run interaction detection for one degree using ITS closed-bar OHLC (identical on any chart TF)
f_interact(int deg, bool newBar, int bar, int t, float dh, float dl, float dc, float dpc) =>
    if newBar and array.size(book) > 0
        for i = 0 to array.size(book) - 1
            L = array.get(book, i)
            if L.deg == deg
                band = L.anchor * bandPct / 100.0
                top = L.anchor + band
                bot = L.anchor - band
                nowIn = dh >= bot and dl <= top
                rct = band <= 0 ? 0.0 : math.max(math.abs(dh - L.anchor), math.abs(dl - L.anchor)) / band
                // measured attributes for scoring (do NOT affect which events fire)
                rng = dh - dl
                swept = (dh > top and dc <= top) or (dl < bot and dc >= bot)
                if nowIn and not L.inside
                    L.entSide := dpc >= L.anchor ? 1 : -1
                    L.testHi := dh
                    L.testLo := dl
                    rejE = rng <= 0 ? 0.0 : (L.entSide <= 0 ? (dh - dc) / rng : (dc - dl) / rng)
                    f_log(L, L.brokenLast ? 4 : 1, bar, t, rct, rejE, swept)
                    L.inside := true
                else if nowIn and L.inside
                    L.testHi := math.max(L.testHi, dh)
                    L.testLo := math.min(L.testLo, dl)
                else if (not nowIn) and L.inside
                    exitSide = dc > top ? 1 : dc < bot ? -1 : L.entSide
                    rejX = rng <= 0 ? 0.0 : (L.entSide <= 0 ? (dh - dc) / rng : (dc - dl) / rng)
                    if exitSide == L.entSide
                        f_log(L, 2, bar, t, rct, rejX, swept)
                        L.brokenLast := false
                    else
                        f_log(L, 3, bar, t, rct, rejX, swept)
                        L.brokenLast := true
                    L.inside := false
                    L.testHi := na
                    L.testLo := na
                array.set(book, i, L)   // void terminator: keeps the branchy if in statement position (avoids CE10235)

// ── SCORING LAYER — every factor is a pure reduction over the event log ──────
// touch separation: reward interactions spread over time, penalise clustered ones
f_separation(Lvl L) =>
    n = array.size(L.log)
    float s = 1.0
    if n >= 3
        span = array.get(L.log, n - 1).bar - array.get(L.log, 0).bar
        avgGap = span / (n - 1)
        s := math.min(avgGap / sepNorm, 1.0)
    s

// REAL qualified-interaction count from the event log (no estimates): an event
// qualifies if it is the first, or sits >= sepNorm bars after the last QUALIFIED
// one — i.e. a genuinely separate visit, not a clustered re-hit. Greedy, deterministic.
f_qualified(Lvl L) =>
    n = array.size(L.log)
    int q = 0
    int lastQ = -2147483647
    if n > 0
        for i = 0 to n - 1
            b = array.get(L.log, i).bar
            if q == 0 or (b - lastQ) >= sepNorm
                q += 1
                lastQ := b
    q

// SINGLE SOURCE of the score AND its audit breakdown. Returns:
// [conf, winF, rejF, dispF, sweepF, sepF, evidF, degW, nEv, avgW, held, brk]
// avgW = average recency weight (the decay indicator: 1 = all fresh, →0 = old).
f_audit(Lvl L) =>
    n = array.size(L.log)
    float conf = 0.0
    float winF = 0.5
    float rejF = 0.0
    float dispF = 0.0
    float sweepF = 0.0
    float sepF = 1.0
    float evidF = 0.0
    float avgW = 0.0
    int held = 0
    int brk = 0
    float degW = L.deg == 3 ? 1.0 : L.deg == 2 ? 0.85 : L.deg == 1 ? 0.70 : 0.55
    if n > 0
        float wsum = 0.0
        float rejW = 0.0
        float dispW = 0.0
        float sweepW = 0.0
        for i = 0 to n - 1
            ev = array.get(L.log, i)
            age = math.max(0, bar_index - ev.bar)
            w = 1.0 / (1.0 + age / decayBars)          // recency decay
            wsum := wsum + w
            rejW := rejW + w * ev.rejQ
            dispW := dispW + w * math.min(ev.react / dispNorm, 1.0)
            if ev.swept
                sweepW := sweepW + w
            if ev.kind == 2
                held := held + 1
            if ev.kind == 3
                brk := brk + 1
        winF   := (held + brk) > 0 ? held / (held + brk) : 0.5
        rejF   := wsum > 0 ? rejW / wsum : 0.0
        dispF  := wsum > 0 ? dispW / wsum : 0.0
        sweepF := wsum > 0 ? math.min(sweepW / wsum * 2.0, 1.0) : 0.0
        sepF   := f_separation(L)
        evidF  := math.min(wsum / evidNorm, 1.0)
        avgW   := wsum / n
        wtot   = wWin + wRej + wDisp + wSweep + wSep + wEvid
        raw    = wtot > 0 ? (winF*wWin + rejF*wRej + dispF*wDisp + sweepF*wSweep + sepF*wSep + evidF*wEvid) / wtot : 0.0
        conf   := math.min(math.max(raw * degW * 100.0, 0.0), 100.0)
    [conf, winF, rejF, dispF, sweepF, sepF, evidF, degW, n, avgW, held, brk]

// score only (thin wrapper over the single source)
f_conf(Lvl L) =>
    [cf, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11] = f_audit(L)
    cf

// point-contribution of one component to the final confidence (they sum to CONF)
f_pts(float f, float w, float wtot, float dg) => wtot > 0 ? f * w / wtot * dg * 100.0 : 0.0

// ── per-degree HTF data (prior CLOSED bar → non-repainting) ──────────────────
[ph1, pl1] = request.security(syminfo.tickerid, "60",  [ta.pivothigh(high, pivLen, pivLen), ta.pivotlow(low, pivLen, pivLen)], lookahead=barmerge.lookahead_off)
[h1, l1, c1, pc1] = request.security(syminfo.tickerid, "60",  [high[1], low[1], close[1], close[2]], lookahead=barmerge.lookahead_on)
[ph4, pl4] = request.security(syminfo.tickerid, "240", [ta.pivothigh(high, pivLen, pivLen), ta.pivotlow(low, pivLen, pivLen)], lookahead=barmerge.lookahead_off)
[h4, l4, c4, pc4] = request.security(syminfo.tickerid, "240", [high[1], low[1], close[1], close[2]], lookahead=barmerge.lookahead_on)
[phd, pld] = request.security(syminfo.tickerid, "D",   [ta.pivothigh(high, pivLen, pivLen), ta.pivotlow(low, pivLen, pivLen)], lookahead=barmerge.lookahead_off)
[hd, ld, cd, pcd] = request.security(syminfo.tickerid, "D",   [high[1], low[1], close[1], close[2]], lookahead=barmerge.lookahead_on)
[phw, plw] = request.security(syminfo.tickerid, "W",   [ta.pivothigh(high, pivLen, pivLen), ta.pivotlow(low, pivLen, pivLen)], lookahead=barmerge.lookahead_off)
[hw, lw, cw, pcw] = request.security(syminfo.tickerid, "W",   [high[1], low[1], close[1], close[2]], lookahead=barmerge.lookahead_on)

n1 = ta.change(time("60"))  != 0
n4 = ta.change(time("240")) != 0
nd = ta.change(time("D"))   != 0
nw = ta.change(time("W"))   != 0

// found anchors from each active degree's confirmed pivots
if a1H
    f_found(ph1, 0, bar_index, time)
    f_found(pl1, 0, bar_index, time)
if a4H
    f_found(ph4, 1, bar_index, time)
    f_found(pl4, 1, bar_index, time)
if a1D
    f_found(phd, 2, bar_index, time)
    f_found(pld, 2, bar_index, time)
if a1W
    f_found(phw, 3, bar_index, time)
    f_found(plw, 3, bar_index, time)

// interactions on each active degree's closed bars
if a1H
    f_interact(0, n1, bar_index, time, h1, l1, c1, pc1)
if a4H
    f_interact(1, n4, bar_index, time, h4, l4, c4, pc4)
if a1D
    f_interact(2, nd, bar_index, time, hd, ld, cd, pcd)
if a1W
    f_interact(3, nw, bar_index, time, hw, lw, cw, pcw)

// ── M4: ENTRY ENGINE (liquidity-first) — read-only over the frozen level book ─
// Bias: same HH+HL / LH+LL sequence classifier as MS-Core, on W/D/4H/1H closed
// bars, weighted W .40 D .30 4H .20 1H .10, deadband ±0.15 → +1 / -1 / 0(MIXED).
f_seqBias() =>
    _ph = ta.pivothigh(high, entryBiasSw, entryBiasSw)
    _pl = ta.pivotlow(low,  entryBiasSw, entryBiasSw)
    var float _lastPH = na
    var float _lastPL = na
    var int   _hi = 0
    var int   _lo = 0
    if not na(_ph)
        _hi := (na(_lastPH) or _ph > _lastPH) ? 1 : -1
        _lastPH := _ph
    if not na(_pl)
        _lo := (na(_lastPL) or _pl < _lastPL) ? -1 : 1
        _lastPL := _pl
    _hi == 1 and _lo == 1 ? 1 : _hi == -1 and _lo == -1 ? -1 : 0

f_seqBiasPrev() =>
    int _b = f_seqBias()
    _b[1]

ebW = request.security(syminfo.tickerid, "W",   f_seqBiasPrev(), lookahead=barmerge.lookahead_on)
ebD = request.security(syminfo.tickerid, "D",   f_seqBiasPrev(), lookahead=barmerge.lookahead_on)
eb4 = request.security(syminfo.tickerid, "240", f_seqBiasPrev(), lookahead=barmerge.lookahead_on)
eb1 = request.security(syminfo.tickerid, "60",  f_seqBiasPrev(), lookahead=barmerge.lookahead_on)
entryScore = ebW * 0.40 + ebD * 0.30 + eb4 * 0.20 + eb1 * 0.10
entryDir   = entryScore > 0.15 ? 1 : entryScore < -0.15 ? -1 : 0

// nearest level INDICES above / below price (true anchors — nudge never touches this)
f_nearestIdx() =>
    int _up = -1
    int _dn = -1
    float _upA = na
    float _dnA = na
    if array.size(book) > 0
        for i = 0 to array.size(book) - 1
            a = array.get(book, i).anchor
            if a >= close and (na(_upA) or a < _upA)
                _upA := a
                _up := i
            if a < close and (na(_dnA) or a > _dnA)
                _dnA := a
                _dn := i
    [_up, _dn]

// level strength for arming: its confidence + confluence bonus for neighbours
// within the merge band (same formula family as the merged-cluster STR)
f_lvlStrength(int idx) =>
    L = array.get(book, idx)
    c = f_conf(L)
    int nb = 0
    bandM = L.anchor * mergeBandPct / 100.0
    for k = 0 to array.size(book) - 1
        if k != idx and math.abs(array.get(book, k).anchor - L.anchor) <= bandM
            nb += 1
    math.min(100.0, c + conflBonus * nb)

// rejected-setups log (rolling, capped) — reasons visible on the panel hover
var array<string> rejLog = array.new<string>()
var array<int>    rejTot = array.new<int>(1, 0)
f_logRej(string why) =>
    array.push(rejLog, str.format_time(time, "MM-dd HH:mm") + "  " + why)
    if array.size(rejLog) > 30
        array.shift(rejLog)
    array.set(rejTot, 0, array.get(rejTot, 0) + 1)

// LTF micro-pivots for the structure sequence (LH / HL)
phL = ta.pivothigh(high, ltfPiv, ltfPiv)
plL = ta.pivotlow(low,  ltfPiv, ltfPiv)

// execution-TF guard: engine runs only on execution timeframes (default ≤ 5m)
execOK = chartSec <= timeframe.in_seconds(maxExecTF)

// state machine: 0 IDLE · 1 SWEPT (await LH/HL) · 2 STRUCT (await LL/HH break)
var int   eSt       = 0
var int   eDirL     = 0      // -1 short / +1 long
var float eAnchor   = na     // swept level
var float eSwHi     = na     // sweep bar extremes
var float eSwLo     = na
var int   eSwBar    = 0
var float eSeqLo    = na     // running extremes since the sweep
var float eSeqHi    = na
var float eStructRef = na    // frozen break level once LH/HL confirms
var float eLHval    = na     // the LH/HL pivot (panel display)
var int   eCool     = 0
var int   eSigCnt   = 0
bool sigLong  = false
bool sigShort = false
float sigStop = na
float sigTgt  = na

if useEntry and execOK and barstate.isconfirmed
    [iUp, iDn] = f_nearestIdx()
    float nUp = iUp >= 0 ? array.get(book, iUp).anchor : na
    float nDn = iDn >= 0 ? array.get(book, iDn).anchor : na
    // running extremes while a setup is live
    if eSt > 0
        eSeqLo := math.min(eSeqLo, low)
        eSeqHi := math.max(eSeqHi, high)
    // global resets for any live setup: bias flip, window expiry, sweep-extreme reclaim
    if eSt > 0
        dTag = eDirL == -1 ? "SHORT" : "LONG"
        if entryDir != eDirL
            f_logRej(dTag + " @" + str.tostring(eAnchor, format.mintick) + " — bias flipped")
            eSt := 0
        else if bar_index - eSwBar > seqWindow
            f_logRej(dTag + " @" + str.tostring(eAnchor, format.mintick) + (eSt == 1 ? " — no LH/HL in window" : " — no break in window"))
            eSt := 0
        else if eDirL == -1 and close > eSwHi
            f_logRej(dTag + " @" + str.tostring(eAnchor, format.mintick) + " — invalidated: close above sweep high")
            eSt := 0
        else if eDirL == 1 and close < eSwLo
            f_logRej(dTag + " @" + str.tostring(eAnchor, format.mintick) + " — invalidated: close below sweep low")
            eSt := 0
    // STATE 1 → LH (short) / HL (long) micro-pivot must confirm AFTER the sweep bar
    if eSt == 1
        if eDirL == -1 and not na(phL) and (bar_index - ltfPiv) > eSwBar
            if phL < eSwHi
                eLHval := phL
                eStructRef := eSeqLo
                eSt := 2
            else
                f_logRej("SHORT @" + str.tostring(eAnchor, format.mintick) + " — structure failed: pivot ≥ sweep high")
                eSt := 0
        else if eDirL == 1 and not na(plL) and (bar_index - ltfPiv) > eSwBar
            if plL > eSwLo
                eLHval := plL
                eStructRef := eSeqHi
                eSt := 2
            else
                f_logRej("LONG @" + str.tostring(eAnchor, format.mintick) + " — structure failed: pivot ≤ sweep low")
                eSt := 0
    // STATE 2 → LL (short) / HH (long): close through the frozen structure level
    if eSt == 2
        if eDirL == -1 and close < eStructRef
            sigShort := true
        else if eDirL == 1 and close > eStructRef
            sigLong := true
    // SIGNAL: draw + cooldown
    if sigShort or sigLong
        sigStop := sigShort ? eSwHi : eSwLo
        sigTgt  := sigShort ? nDn : nUp
        rr = na(sigTgt) or math.abs(sigStop - close) == 0 ? na : math.abs(close - sigTgt) / math.abs(sigStop - close)
        txt = (sigShort ? "▼ SHORT" : "▲ LONG") + "  @" + str.tostring(close, format.mintick) + "\nsweep " + str.tostring(eAnchor, format.mintick) + " → " + (sigShort ? "LH " : "HL ") + str.tostring(eLHval, format.mintick) + " → " + (sigShort ? "LL" : "HH") + "\nstop " + str.tostring(sigStop, format.mintick) + (na(sigTgt) ? "" : " · tgt " + str.tostring(sigTgt, format.mintick)) + (na(rr) ? "" : " · R " + str.tostring(rr, "#.0"))
        label.new(bar_index, sigShort ? high : low, txt, xloc=xloc.bar_index, style=sigShort ? label.style_label_down : label.style_label_up, color=sigShort ? color.new(#ef5350, 10) : color.new(#26a69a, 10), textcolor=color.white, size=size.small)
        if showTrdLn
            line.new(bar_index, close, bar_index + 12, close, xloc=xloc.bar_index, color=color.gray, width=1, style=line.style_solid)
            line.new(bar_index, sigStop, bar_index + 12, sigStop, xloc=xloc.bar_index, color=#ef5350, width=1, style=line.style_dotted)
            if not na(sigTgt)
                line.new(bar_index, sigTgt, bar_index + 12, sigTgt, xloc=xloc.bar_index, color=#26a69a, width=1, style=line.style_dotted)
        eSigCnt := eSigCnt + 1
        eCool := bar_index + coolBars
        eSt := 0
    // IDLE: watch for a sweep of the LIVE level in the bias direction — with
    // strength + rejection-quality gates (skips are logged, never silently dropped)
    if eSt == 0 and not (sigShort or sigLong) and bar_index >= eCool and entryDir != 0
        rng = high - low
        if entryDir == -1 and iUp >= 0 and high > nUp and close <= nUp
            strengthS = f_lvlStrength(iUp)
            rqS = rng <= 0 ? 0.0 : (high - close) / rng
            if strengthS < entryMinCnf
                f_logRej("SHORT sweep @" + str.tostring(nUp, format.mintick) + " skipped — weak level (STR " + str.tostring(math.round(strengthS)) + " < " + str.tostring(math.round(entryMinCnf)) + ")")
            else if rqS < rejMin
                f_logRej("SHORT sweep @" + str.tostring(nUp, format.mintick) + " skipped — weak rejection (" + str.tostring(rqS, "#.00") + " < " + str.tostring(rejMin, "#.00") + ")")
            else
                eSt := 1
                eDirL := -1
                eAnchor := nUp
                eSwHi := high
                eSwLo := low
                eSwBar := bar_index
                eSeqLo := low
                eSeqHi := high
                if showSwpMark
                    label.new(bar_index, high, "✕", xloc=xloc.bar_index, style=label.style_none, textcolor=#ef5350, size=size.small)
        else if entryDir == 1 and iDn >= 0 and low < nDn and close >= nDn
            strengthL = f_lvlStrength(iDn)
            rqL = rng <= 0 ? 0.0 : (close - low) / rng
            if strengthL < entryMinCnf
                f_logRej("LONG sweep @" + str.tostring(nDn, format.mintick) + " skipped — weak level (STR " + str.tostring(math.round(strengthL)) + " < " + str.tostring(math.round(entryMinCnf)) + ")")
            else if rqL < rejMin
                f_logRej("LONG sweep @" + str.tostring(nDn, format.mintick) + " skipped — weak rejection (" + str.tostring(rqL, "#.00") + " < " + str.tostring(rejMin, "#.00") + ")")
            else
                eSt := 1
                eDirL := 1
                eAnchor := nDn
                eSwHi := high
                eSwLo := low
                eSwBar := bar_index
                eSeqLo := low
                eSeqHi := high
                if showSwpMark
                    label.new(bar_index, low, "✕", xloc=xloc.bar_index, style=label.style_none, textcolor=#26a69a, size=size.small)

alertcondition(sigLong,  "M4 LONG (liquidity-first)",  "Liquidity-first LONG: floor swept + HL→HH structure confirmed")
alertcondition(sigShort, "M4 SHORT (liquidity-first)", "Liquidity-first SHORT: ceiling swept + LH→LL structure confirmed")

var table eT = table.new(position.bottom_right, 2, 4, border_width=1)
if useEntry and showEPanel and barstate.islast
    ebTxt = entryDir == 1 ? "BULL" : entryDir == -1 ? "BEAR" : "MIXED"
    ebCol = entryDir == 1 ? #26a69a : entryDir == -1 ? #ef5350 : color.new(color.gray, 20)
    left = seqWindow - (bar_index - eSwBar)
    stTxt = not execOK ? "OFF — chart TF > " + maxExecTF + "m limit" : eSt == 1 ? (eDirL == -1 ? "SWEPT ▼ await LH (" : "SWEPT ▲ await HL (") + str.tostring(left) + ")" : eSt == 2 ? (eDirL == -1 ? "LH ✓ await LL < " : "HL ✓ await HH > ") + str.tostring(eStructRef, format.mintick) + " (" + str.tostring(left) + ")" : bar_index < eCool ? "COOLDOWN " + str.tostring(eCool - bar_index) : "IDLE — watching"
    string rejTip = "REJECTED SETUPS (latest first not guaranteed — chronological):\n"
    if array.size(rejLog) > 0
        for ri = 0 to array.size(rejLog) - 1
            rejTip := rejTip + array.get(rejLog, ri) + "\n"
    else
        rejTip := rejTip + "none yet"
    table.cell(eT, 0, 0, "ENTRY BIAS", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(eT, 1, 0, ebTxt + " (" + str.tostring(entryScore, "#.00") + ")", text_color=color.white, bgcolor=ebCol, text_size=size.small)
    table.cell(eT, 0, 1, "STATE", text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(eT, 1, 1, stTxt, text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(eT, 0, 2, "SIGNALS", text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(eT, 1, 2, str.tostring(eSigCnt), text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(eT, 0, 3, "REJECTED", text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small, tooltip=rejTip)
    table.cell(eT, 1, 3, str.tostring(array.get(rejTot, 0)), text_color=color.orange, bgcolor=color.new(color.black, 40), text_size=size.small, tooltip=rejTip)

// ── RENDER ───────────────────────────────────────────────────────────────────
var array<line>  dLine = array.new<line>()
var array<label> dLab  = array.new<label>()
var array<box>   dBox  = array.new<box>()
f_kindTxt(int k) => k == 2 ? "✓ held" : k == 3 ? "✗ break" : k == 4 ? "↻ retest" : "• touch"

if barstate.islast
    while array.size(dLine) > 0
        line.delete(array.pop(dLine))
    while array.size(dLab) > 0
        label.delete(array.pop(dLab))
    while array.size(dBox) > 0
        box.delete(array.pop(dBox))
    x1 = bar_index - math.min(400, bar_index)
    x2 = bar_index + extR
    int naIdx = -1
    float naD = 1.0e20
    int nbIdx = -1
    float nbD = 1.0e20
    if array.size(book) > 0
        for i = 0 to array.size(book) - 1
            a = array.get(book, i).anchor
            if a >= close and (a - close) < naD
                naD := a - close
                naIdx := i
            if a < close and (close - a) < nbD
                nbD := close - a
                nbIdx := i
    // confidence per level + rank: find the Nth-highest score = star threshold
    float starThr = 1.0e20
    if topN > 0 and array.size(book) > 0
        confs = array.new_float()
        for i = 0 to array.size(book) - 1
            array.push(confs, f_conf(array.get(book, i)))
        array.sort(confs, order.descending)
        idx = math.min(topN, array.size(confs)) - 1
        if idx >= 0
            starThr := array.get(confs, idx)
    if array.size(book) > 0
        for i = 0 to array.size(book) - 1
            L = array.get(book, i)
            bounces = f_count(L, 2)
            breaks  = f_count(L, 3)
            retests = f_count(L, 4)
            events  = array.size(L.log)
            live = i == naIdx or i == nbIdx
            [conf, winF, rejF, dispF, sweepF, sepF, evidF, degW, nEv, avgW, held, brk] = f_audit(L)
            starred = topN > 0 and conf >= starThr
            if (conf >= minConf or live) and (events >= minShow or live)
                // CONFLUENCE MERGE (inline, no parallel arrays → crash-proof): absorb this level
                // if a stronger candidate sits within the merge band; else it's the cluster's line.
                merged = false
                clCount = 1
                if mergeOn
                    bandM = L.anchor * mergeBandPct / 100.0
                    for k = 0 to array.size(book) - 1
                        if k != i
                            Lk = array.get(book, k)
                            ck = f_conf(Lk)
                            livek = k == naIdx or k == nbIdx
                            candk = (ck >= minConf or livek) and (array.size(Lk.log) >= minShow or livek)
                            if candk and math.abs(Lk.anchor - L.anchor) <= bandM
                                clCount := clCount + 1
                                if ck > conf or (ck == conf and k < i)
                                    merged := true
                if mergeOn and merged
                    continue
                clStr = math.min(100.0, conf + conflBonus * (clCount - 1))
                isCluster = mergeOn and clCount > 1
                isRes = L.anchor > close
                col = colByDeg ? f_degCol(L.deg) : (isRes ? resCol : supCol)
                decided = bounces + breaks
                band = L.anchor * bandPct / 100.0
                lw = (live or starred or isCluster) ? emphWidth : lineWidth
                // manual nudge — presentation only, applies to the LIVE ceiling / floor
                nOff = (i == naIdx ? nudgeCeil : i == nbIdx ? nudgeFloor : 0.0) * L.anchor / 100.0
                drawA = L.anchor + nOff
                if L.inside and showActiveZone
                    zt = (na(L.testHi) ? L.anchor + band : math.max(L.testHi, L.anchor + band)) + nOff
                    zb = (na(L.testLo) ? L.anchor - band : math.min(L.testLo, L.anchor - band)) + nOff
                    array.push(dBox, box.new(x1, zt, x2, zb, border_color=zoneBord > 0 ? color.new(zoneCol, 40) : color.new(zoneCol, 100), bgcolor=color.new(zoneCol, zoneOp), border_width=zoneBord))
                else
                    array.push(dLine, line.new(x1, drawA, x2, drawA, color=col, width=lw, extend=f_ext(extMode), style=f_lstyle(lineStyleIn)))
                if showLbl
                    bornT = array.size(L.log) > 0 ? array.get(L.log, 0).t : time
                    string tl = "LEVEL " + str.tostring(L.anchor, format.mintick) + "  [" + f_degTxt(L.deg) + " degree]\n" + (isRes ? "resistance" : "support") + " · born " + str.format_time(bornT, "yyyy-MM-dd") + "\n———————————————\n"
                    st = math.max(0, array.size(L.log) - 15)
                    if array.size(L.log) > 0
                        for e = st to array.size(L.log) - 1
                            ev = array.get(L.log, e)
                            tl := tl + str.format_time(ev.t, "yy-MM-dd HH:mm") + "  " + f_kindTxt(ev.kind) + "  (" + str.tostring(ev.react, "#.0") + "×)\n"
                    wrtxt = decided > 0 ? str.tostring(math.round(bounces / decided * 100)) + "%" : "n/a"
                    // AUDIT breakdown (★ levels): every component's point-contribution, summing to CONF
                    if showAudit and starred
                        wtot = wWin + wRej + wDisp + wSweep + wSep + wEvid
                        qual = f_qualified(L)
                        sub = f_pts(winF, wWin, wtot, 1.0) + f_pts(rejF, wRej, wtot, 1.0) + f_pts(dispF, wDisp, wtot, 1.0) + f_pts(sweepF, wSweep, wtot, 1.0) + f_pts(sepF, wSep, wtot, 1.0) + f_pts(evidF, wEvid, wtot, 1.0)
                        tfPts = sub * (degW - 1.0)
                        tl := tl + "———— AUDIT (calculation order) ————\n"
                        tl := tl + "1 interactions  " + str.tostring(nEv) + " ev · qualified " + str.tostring(qual) + "  (≥" + str.tostring(sepNorm, "#") + " bars apart)\n"
                        tl := tl + "2 decay         avg-weight " + str.tostring(avgW, "#.00") + "  (older discounted)\n"
                        tl := tl + "3 rejection     " + str.tostring(rejF, "#.00") + "  → +" + str.tostring(f_pts(rejF, wRej, wtot, 1.0), "#.0") + "\n"
                        tl := tl + "4 displacement  " + str.tostring(dispF, "#.00") + "  → +" + str.tostring(f_pts(dispF, wDisp, wtot, 1.0), "#.0") + "\n"
                        tl := tl + "5 sweep         " + str.tostring(sweepF, "#.00") + "  → +" + str.tostring(f_pts(sweepF, wSweep, wtot, 1.0), "#.0") + "\n"
                        tl := tl + "6 win rate      " + str.tostring(math.round(winF * 100)) + "%  → +" + str.tostring(f_pts(winF, wWin, wtot, 1.0), "#.0") + "\n"
                        tl := tl + "7 separation    " + str.tostring(sepF, "#.00") + "  → +" + str.tostring(f_pts(sepF, wSep, wtot, 1.0), "#.0") + "\n"
                        tl := tl + "8 evidence      " + str.tostring(evidF, "#.00") + "  → +" + str.tostring(f_pts(evidF, wEvid, wtot, 1.0), "#.0") + "\n"
                        tl := tl + "  subtotal      " + str.tostring(sub, "#.0") + " pts\n"
                        tl := tl + "9 timeframe " + f_degTxt(L.deg) + "  ×" + str.tostring(degW, "#.00") + "  → " + (tfPts >= 0 ? "+" : "") + str.tostring(tfPts, "#.0") + " pts\n"
                        tl := tl + "10 FINAL CONF   " + str.tostring(math.round(conf)) + "  (= subtotal " + (tfPts >= 0 ? "+ " : "− ") + str.tostring(math.abs(tfPts), "#.0") + ")\n"
                    if isCluster
                        tl := tl + "———— ⧉ MERGED CLUSTER · STR " + str.tostring(math.round(clStr)) + " ————\n" + str.tostring(clCount) + " levels within " + str.tostring(mergeBandPct, "#.00") + "% of price:\n"
                        for k = 0 to array.size(book) - 1
                            Lk = array.get(book, k)
                            if math.abs(Lk.anchor - L.anchor) <= L.anchor * mergeBandPct / 100.0
                                tl := tl + "  " + str.tostring(Lk.anchor, format.mintick) + "  " + f_degTxt(Lk.deg) + " · CONF " + str.tostring(math.round(f_conf(Lk))) + " · " + str.tostring(array.size(Lk.log)) + " ev\n"
                    ltag = (starred ? "★ " : "") + (live ? "◄ LIVE  " : "")
                    degPart  = showDegTag ? "  " + f_degTxt(L.deg) : ""
                    confPart = showConf ? (isCluster ? "  ·  STR " + str.tostring(math.round(clStr)) + " ⧉×" + str.tostring(clCount) : "  ·  CONF " + str.tostring(math.round(conf))) : ""
                    statLine = showStats ? "\n" + str.tostring(events) + " ev · " + str.tostring(bounces) + "✓/" + str.tostring(breaks) + "✗ · win " + wrtxt + (retests > 0 ? " · " + str.tostring(retests) + "↻" : "") : ""
                    head = ltag + str.tostring(L.anchor, format.mintick) + degPart + " " + (isRes ? "RES" : "SUP") + confPart + statLine
                    lblX = lblSide == "Left" ? x1 : x2
                    lblStyle = lblSide == "Left" ? label.style_label_right : label.style_label_left
                    array.push(dLab, label.new(lblX, drawA, head, xloc=xloc.bar_index, style=lblStyle, color=color.new(col, live ? 0 : lblOp), textcolor=color.white, size=f_sz(lblSize), tooltip=tl))
