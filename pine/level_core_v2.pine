//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// LEVEL CORE v2 — Multi-degree, CROSS-TIMEFRAME (Module 1, frozen foundation)
//
//  Levels are sourced from FIXED timeframes (1H / 4H / 1D / 1W) via
//  request.security — NEVER from the chart's own candles. Consequences:
//   • SAME level prices on every chart TF (1m … 1W) — identical, by construction.
//   • Each level's interactions are counted on ITS OWN degree's bars, so its
//     event log & stats are identical no matter which chart you view.
//   • Only degrees ≥ the chart TF are shown (keeps the HTF data complete).
//  Inherits the v1 event engine (validated): immutable anchors, event-sourced
//  stats, closed-bar-only detection (no repaint), zone-while-interacting.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Level Core v2 [multi-degree cross-TF]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=5000)

gD = "Detection"
pivLen  = input.int(5, "Swing size (pivot L/R, per degree)", minval=2, maxval=50, group=gD)
bandPct = input.float(0.40, "Level band (% of price)", minval=0.02, maxval=5.0, step=0.02, group=gD)
maxLvls = input.int(60, "Max levels tracked (centered on price)", minval=8, maxval=120, group=gD)
maxEv   = input.int(40, "Timeline length (events per level)", minval=5, maxval=80, group=gD)
minShow = input.int(1, "Min interactions to show (LIVE always shows)", minval=0, maxval=20, group=gD)

gG = "Degrees"
use1H = input.bool(true, "1H levels", group=gG)
use4H = input.bool(true, "4H levels", group=gG)
use1D = input.bool(true, "1D levels", group=gG)
use1W = input.bool(true, "1W levels", group=gG)

gC = "Confidence Scoring (institutional)"
minConf   = input.float(0.0, "Min confidence to show (LIVE always shows)", minval=0.0, maxval=100.0, step=5.0, group=gC)
topN      = input.int(3, "★ Star the strongest N levels", minval=0, maxval=20, group=gC)
showAudit = input.bool(true, "Show confidence AUDIT breakdown (★ levels, on hover)", group=gC)
decayBars = input.float(150.0, "Strength half-life (degree-bars) — older interactions fade", minval=10.0, maxval=5000.0, group=gC, tooltip="Measured in the LEVEL'S OWN degree bars (a 1D level ages in days, a 1W level in weeks) via event timestamps — so a level's confidence is identical on every chart timeframe.")
sepNorm   = input.float(20.0, "Touch separation norm (degree-bars) — clustered = penalised", minval=1.0, maxval=500.0, group=gC, tooltip="Also in the level's own degree bars, so the qualified-touch count and separation score are the same on 1m or 1D charts.")
dispNorm  = input.float(2.0, "ATR displacement for full credit (band-units)", minval=0.5, maxval=10.0, step=0.5, group=gC)
evidNorm  = input.float(5.0, "Interactions for full 'evidence'", minval=1.0, maxval=30.0, group=gC)
wWin   = input.float(0.28, "Weight: win rate (held vs break)", minval=0.0, maxval=1.0, step=0.02, group=gC)
wRej   = input.float(0.20, "Weight: rejection quality (wick/body)", minval=0.0, maxval=1.0, step=0.02, group=gC)
wDisp  = input.float(0.16, "Weight: ATR displacement after touch", minval=0.0, maxval=1.0, step=0.02, group=gC)
wSweep = input.float(0.12, "Weight: liquidity sweep before reaction", minval=0.0, maxval=1.0, step=0.02, group=gC)
wSep   = input.float(0.12, "Weight: touch separation (anti-cluster)", minval=0.0, maxval=1.0, step=0.02, group=gC)
wEvid  = input.float(0.12, "Weight: evidence (# recent interactions)", minval=0.0, maxval=1.0, step=0.02, group=gC)

gLn = "Appearance — Lines"
lineStyleIn = input.string("Solid", "Line style", options=["Solid", "Dashed", "Dotted"], group=gLn)
lineWidth   = input.int(1, "Line width", minval=1, maxval=6, group=gLn)
emphWidth   = input.int(3, "LIVE / ★ line width", minval=1, maxval=8, group=gLn)
colByDeg    = input.bool(false, "Color lines by degree (TF) instead of R/S", group=gLn)
resCol  = input.color(#ef5350, "Resistance", group=gLn)
supCol  = input.color(#26a69a, "Support", group=gLn)
c1Hcol  = input.color(#787b86, "1H colour (degree mode)", group=gLn)
c4Hcol  = input.color(#42bda8, "4H colour (degree mode)", group=gLn)
c1Dcol  = input.color(#5b9cf6, "1D colour (degree mode)", group=gLn)
c1Wcol  = input.color(#c07cff, "1W colour (degree mode)", group=gLn)
extMode = input.string("Left", "Extend", options=["Left", "Right", "Both", "None"], group=gLn)
extR    = input.int(30, "Extend right (bars)", minval=0, maxval=200, group=gLn)

gZ = "Appearance — Active Zone"
showActiveZone = input.bool(true, "Active zone ON  (OFF → show the line instead)", group=gZ, tooltip="When a level is being touched it expands into a zone. Turn OFF to keep it as a plain regional line at all times.")
zoneCol  = input.color(#ffd24a, "Zone fill", group=gZ)
zoneOp   = input.int(85, "Zone fill transparency", minval=0, maxval=100, group=gZ)
zoneBord = input.int(1, "Zone border width", minval=0, maxval=4, group=gZ)

gLb = "Appearance — Labels"
showLbl    = input.bool(true, "Show labels", group=gLb)
lblSize    = input.string("Small", "Label size", options=["Tiny", "Small", "Normal"], group=gLb)
lblSide    = input.string("Right", "Label side", options=["Right", "Left"], group=gLb)
showConf   = input.bool(true, "Show CONF in label", group=gLb)
showStats  = input.bool(true, "Show event stats line", group=gLb)
showDegTag = input.bool(true, "Show degree tag", group=gLb)
lblOp      = input.int(20, "Label background transparency", minval=0, maxval=100, group=gLb)

gM = "Confluence Merge (liquidity zones)"
mergeOn      = input.bool(true, "Merge clustered levels into one zone", group=gM, tooltip="OFF = every level shows as its own line. ON = nearby levels (a liquidity shelf) collapse into a single zone with combined strength. Underlying levels & memory are preserved.")
mergeBandPct = input.float(0.80, "Merge band (% of price)", minval=0.05, maxval=10.0, step=0.05, group=gM)
conflBonus   = input.float(6.0, "Confluence bonus per extra level (strength)", minval=0.0, maxval=30.0, step=1.0, group=gM)
mergeCol     = input.color(#ff9800, "Liquidity-zone fill", group=gM)
mergeOp      = input.int(80, "Liquidity-zone transparency", minval=0, maxval=100, group=gM)

gNz = "Manual Nudge (LIVE floor / ceiling)"
nudgeCeil  = input.float(0.0, "Nudge nearest RESISTANCE / ceiling (% of price)", minval=-2.0, maxval=2.0, step=0.01, group=gNz, tooltip="Presentation only. Shift the nearest level ABOVE price (the ceiling price is about to hit) up/down a hair to sit it on the exact wick. Does not change the level, its memory, or its score.")
nudgeFloor = input.float(0.0, "Nudge nearest SUPPORT / floor (% of price)", minval=-2.0, maxval=2.0, step=0.01, group=gNz, tooltip="Presentation only. Shift the nearest level BELOW price (the floor price is about to hit).")

gP = "Position Layer (HTF bias + regime)"
posMomLen = input.int(50, "HTF momentum EMA length (per 1W/1D/4H)", minval=5, maxval=400, group=gP, tooltip="Each HTF votes its HH/HL/LH/LL structure ONLY if momentum agrees: price above this EMA = bullish momentum, below = bearish. Momentum that OPPOSES the structure vetoes that timeframe's vote.")
erLen     = input.int(20, "Regime efficiency-ratio lookback (Daily bars)", minval=5, maxval=200, group=gP)
erTrend   = input.float(0.35, "Trending efficiency ratio (0–1) — churn cutoff", minval=0.05, maxval=0.95, step=0.05, group=gP, tooltip="Kaufman efficiency ratio per HTF = |net move| / |sum of bar moves|. Below this a topping/bottoming structure is read as DISTRIBUTION / ACCUMULATION (churn), not a clean trend.")
erChop    = input.float(0.12, "Dead-structure floor (efficiency ratio 0–1)", minval=0.02, maxval=0.60, step=0.02, group=gP, tooltip="Even clean HH+HL / LH+LL structure is downgraded to RANGE when efficiency is below this — a low-volatility grind is not a tradable trend. Volatility gate on directional bias.")

gE = "Entry Engine (liquidity-first) — M4"
useEntry    = input.bool(true, "Enable liquidity-first entry signals", group=gE, tooltip="Flow: HTF bias → target liquidity → SWEEP of a strong LIVE level → quality rejection → LTF structure sequence (SHORT: LH then LL · LONG: HL then HH) → signal toward the opposing level. Signals are visual/alerts only — paper trading.")
entryBiasSw = input.int(5, "Bias Swing Size (W/D/4H/1H sequence classifier)", minval=2, maxval=30, group=gE, tooltip="Same HH+HL / LH+LL sequence rule as MS-Core, weighted W .40 D .30 4H .20 1H .10 with a ±0.15 deadband. MIXED bias = no signals.")
maxExecTF   = input.timeframe("5", "Max execution timeframe (engine off above this)", group=gE, tooltip="Execution belongs on 1m–5m. On any chart TF above this the engine stays idle (levels/bias still display).")
entryMinCnf = input.float(40.0, "Min level strength to arm (CONF + confluence)", minval=0.0, maxval=100.0, step=5.0, group=gE, tooltip="The swept level's confidence plus its confluence bonus (neighbours within the merge band) must reach this. Weak levels never arm — they get logged as rejected setups.")
rejMin      = input.float(0.5, "Min rejection quality of the sweep bar (0-1)", minval=0.0, maxval=1.0, step=0.05, group=gE, tooltip="SHORT: (high−close)/range · LONG: (close−low)/range of the sweep bar. Same wick/body measure the event engine logs. Low-quality rejections are logged, not armed.")
minSweepATR = input.float(0.25, "Min sweep depth beyond level (× ATR)", minval=0.0, maxval=5.0, step=0.05, group=gE, tooltip="The wick must pierce the swept level by at least this many ATRs before it counts as a real liquidity grab. Filters the micro-pokes that produced too many signals.")
atrLen      = input.int(14, "ATR length (sweep-depth normalization)", minval=2, maxval=100, group=gE)
internalPiv = input.int(3, "Internal structure pivot (BOS / CHoCH size)", minval=1, maxval=10, group=gE, tooltip="Confirmation is a real internal break: after the sweep, price must CLOSE through the last internal swing (a pivot of this size) in the bias direction — a bearish break for shorts, a bullish break for longs.")
useLocFilter = input.bool(true, "Require premium / discount location", group=gE, tooltip="SHORT only when the swept level sits in the PREMIUM (upper half) of the recent range; LONG only in the DISCOUNT (lower half). Blocks longs at range highs and shorts at range lows.")
locLookback = input.int(50, "Premium / discount range lookback (bars)", minval=10, maxval=500, group=gE)
seqWindow   = input.int(20, "Max bars from sweep to structure break", minval=3, maxval=100, group=gE)
coolBars    = input.int(10, "Cooldown after a signal (bars)", minval=0, maxval=200, group=gE)
showSwpMark = input.bool(true, "Mark armed sweeps (✕)", group=gE)
showTrdLn   = input.bool(true, "Draw entry / stop / target lines on signal", group=gE)
showEPanel  = input.bool(true, "Show entry-state panel (hover REJECTED = reasons log)", group=gE)

gCZ = "Claude Zone (ranked view)"
viewMode   = input.string("All levels", "View", options=["All levels", "Leading (ranked)", "Claude Zone (3)", "Claude Line only"], group=gCZ, tooltip="All = every level (nearest maxLvls). Leading = only the N strongest each side. Claude Zone = 3 lines (support, resistance, Claude Line). Claude Line only = nothing but the Claude Line — cleanest chart.")
leadN      = input.int(3, "Leading levels per side", minval=1, maxval=20, group=gCZ)
showClaude = input.bool(true, "Show Claude Line (equilibrium of the alpha range)", group=gCZ, tooltip="The center line between the strongest support cluster below price and the strongest resistance cluster above. Fair-value magnet: price tends to bounce it or break-and-retest it, then travel.")
midMode    = input.string("Equilibrium 50%", "Middle =", options=["Equilibrium 50%", "Snap to nearest strong level"], group=gCZ)
showPD     = input.bool(true, "Shade premium / discount", group=gCZ)
gateCZ     = input.bool(true, "Bias by MARKET STATE (range = mean-revert · trend = continuation)", group=gCZ)
claudeCol  = input.color(#ffd24a, "Claude Line colour", group=gCZ)

gLE = "Location Engine (auction range)"
auctionTF    = input.timeframe("D", "Auction timeframe (fixed — the auction you trade around)", group=gLE, tooltip="The Claude Zone = the active dealing range on THIS timeframe, read as single HTF swing values (reach-independent) → identical on every chart TF. 1D = daily auction · 1W = macro.")
auctionSwing = input.int(5, "Auction swing size (pivot L/R)", minval=2, maxval=50, group=gLE)
approachPct  = input.float(10.0, "Approaching threshold (% of range width)", minval=1.0, maxval=45.0, step=1.0, group=gLE)
showAuMeta   = input.bool(true, "Show auction state/version/age on the Claude Line", group=gLE)

gMC = "Market Context Engine (external 2nd source)"
useContext = input.bool(true, "Enable market context confirmation", group=gMC, tooltip="An INDEPENDENT second direction source: the SAME structure classifier applied to EXTERNAL data (asset-class leader + market-cap tide) — NO moving average, oscillator, or this chart's own price. A TRUE direction (BULL/BEAR) is declared ONLY when Structure and Context AGREE; disagreement = RANGE (a trap — waiting is a position).")
ctxTF     = input.timeframe("D", "Context timeframe", group=gMC, tooltip="The timeframe on which the leader/tide structure is read. Independent of the chart TF (single HTF values → stable).")
leaderSym = input.symbol("BINANCE:BTCUSDT", "Leader (drives the asset class)", group=gMC, tooltip="Crypto: BTC. The dominant instrument the class follows.")
tideSym   = input.symbol("CRYPTOCAP:TOTAL2", "Tide (total market cap ex-BTC)", group=gMC, tooltip="Crypto: TOTAL2 (altcoin tide). For indices/FX, pick the relevant breadth/complex proxy.")
useRS     = input.bool(true, "Show relative strength vs leader", group=gMC, tooltip="Qualitative annotation only (this asset's structure vs the leader's) — never a vote. LEADING/LAGGING/IN-LINE/DIVERGING.")

gZL = "Appearance — Zone / Leading lines"
czCeilCol  = input.color(#ef5350, "Ceiling (upper boundary)", inline="ce", group=gZL)
czCeilW    = input.int(3, "w", minval=1, maxval=8, inline="ce", group=gZL)
czCeilSty  = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], inline="ce", group=gZL)
czFloorCol = input.color(#26a69a, "Floor (lower boundary)", inline="fl", group=gZL)
czFloorW   = input.int(3, "w", minval=1, maxval=8, inline="fl", group=gZL)
czFloorSty = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], inline="fl", group=gZL)
claudeW    = input.int(2, "Claude Line width", minval=1, maxval=8, inline="cl", group=gZL)
claudeSty  = input.string("Dashed", "", options=["Solid", "Dashed", "Dotted"], inline="cl", group=gZL)
leadResCol = input.color(#ef5350, "Leading resistance", inline="lr", group=gZL)
leadSupCol = input.color(#26a69a, "Leading support", inline="lr", group=gZL)
leadW      = input.int(1, "Leading width", minval=1, maxval=8, inline="lw2", group=gZL)
leadSty    = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], inline="lw2", group=gZL)
leadFade   = input.bool(true, "Fade further leading lines", group=gZL)
showZoneLbl = input.bool(true, "Show zone / leading labels", group=gZL)

f_sz(s) => s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small
f_degTxt(int d) => d == 0 ? "1H" : d == 1 ? "4H" : d == 2 ? "1D" : "1W"
f_lstyle(s) => s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid
f_ext(s) => s == "Right" ? extend.right : s == "Both" ? extend.both : s == "None" ? extend.none : extend.left
f_degCol(int d) => d == 0 ? c1Hcol : d == 1 ? c4Hcol : d == 2 ? c1Dcol : c1Wcol

// a degree is active only if its timeframe is ≥ the chart timeframe
chartSec = timeframe.in_seconds(timeframe.period)
a1H = use1H and timeframe.in_seconds("60")  >= chartSec
a4H = use4H and timeframe.in_seconds("240") >= chartSec
a1D = use1D and timeframe.in_seconds("D")   >= chartSec
a1W = use1W and timeframe.in_seconds("W")   >= chartSec

type Ev
    int   bar
    int   t
    int   kind        // 1 touch, 2 held, 3 break, 4 retest
    float react       // measured: degree-bar excursion vs level, in band-units
    float rejQ        // measured: rejection quality 0..1 (close pulled back from the extreme)
    bool  swept       // measured: wick swept beyond the level then closed back

type Lvl
    float anchor
    int   deg
    bool  inside
    int   entSide
    float testHi
    float testLo
    bool  brokenLast
    array<Ev> log

var array<Lvl> book = array.new<Lvl>()

// TF-invariant "now" (1H-aligned epoch ms): recency decay is measured against this,
// not against chart bar_index, so a level's age is identical on every chart timeframe.
nowRef = time - time % 3600000

// milliseconds per bar of a level's OWN degree (1H/4H/1D/1W). Every time-based measure
// (decay, separation, qualified spacing) is expressed in the level's degree-bars via
// event timestamps → TF-invariant, never in chart bars.
f_degMs(int deg) => deg == 0 ? 3600000.0 : deg == 1 ? 14400000.0 : deg == 2 ? 86400000.0 : 604800000.0

f_log(Lvl L, int kind, int bar, int t, float react, float rejQ, bool swept) =>
    array.push(L.log, Ev.new(bar, t, kind, react, rejQ, swept))
    if array.size(L.log) > maxEv
        array.shift(L.log)

f_count(Lvl L, int kind) =>
    int c = 0
    if array.size(L.log) > 0
        for i = 0 to array.size(L.log) - 1
            if array.get(L.log, i).kind == kind
                c += 1
    c

f_create(float px, int deg, int bar, int t) =>
    L = Lvl.new(px, deg, false, 0, na, na, false, array.new<Ev>())
    array.push(L.log, Ev.new(bar, t, 2, 0.0, 0.0, false))     // founding rejection (held)
    array.push(book, L)

// found a level of a given degree; anchor immutable. NO eviction: the book holds the
// full distinct HTF-sourced set (hard safety cap only). The render caps the DISPLAY to
// the maxLvls nearest price — so cost stays bounded without a per-bar eviction scan.
f_found(float px, int deg, int bar, int t) =>
    if not na(px)
        band = px * bandPct / 100.0
        exists = false
        if array.size(book) > 0
            for i = 0 to array.size(book) - 1
                if array.get(book, i).deg == deg and math.abs(array.get(book, i).anchor - px) <= band
                    exists := true
                    break
        if not exists and array.size(book) < 480
            f_create(px, deg, bar, t)

// run interaction detection for one degree using ITS closed-bar OHLC (identical on any chart TF)
f_interact(int deg, bool newBar, int bar, int t, float dh, float dl, float dc, float dpc) =>
    if newBar and array.size(book) > 0
        for i = 0 to array.size(book) - 1
            L = array.get(book, i)
            if L.deg == deg
                band = L.anchor * bandPct / 100.0
                top = L.anchor + band
                bot = L.anchor - band
                nowIn = dh >= bot and dl <= top
                rct = band <= 0 ? 0.0 : math.max(math.abs(dh - L.anchor), math.abs(dl - L.anchor)) / band
                // measured attributes for scoring (do NOT affect which events fire)
                rng = dh - dl
                swept = (dh > top and dc <= top) or (dl < bot and dc >= bot)
                if nowIn and not L.inside
                    L.entSide := dpc >= L.anchor ? 1 : -1
                    L.testHi := dh
                    L.testLo := dl
                    rejE = rng <= 0 ? 0.0 : (L.entSide <= 0 ? (dh - dc) / rng : (dc - dl) / rng)
                    f_log(L, L.brokenLast ? 4 : 1, bar, t, rct, rejE, swept)
                    L.inside := true
                else if nowIn and L.inside
                    L.testHi := math.max(L.testHi, dh)
                    L.testLo := math.min(L.testLo, dl)
                else if (not nowIn) and L.inside
                    exitSide = dc > top ? 1 : dc < bot ? -1 : L.entSide
                    rejX = rng <= 0 ? 0.0 : (L.entSide <= 0 ? (dh - dc) / rng : (dc - dl) / rng)
                    if exitSide == L.entSide
                        f_log(L, 2, bar, t, rct, rejX, swept)
                        L.brokenLast := false
                    else
                        f_log(L, 3, bar, t, rct, rejX, swept)
                        L.brokenLast := true
                    L.inside := false
                    L.testHi := na
                    L.testLo := na
                array.set(book, i, L)   // void terminator: keeps the branchy if in statement position (avoids CE10235)

// ── SCORING LAYER — every factor is a pure reduction over the event log ──────
// touch separation: reward interactions spread over time, penalise clustered ones
f_separation(Lvl L) =>
    n = array.size(L.log)
    float s = 1.0
    if n >= 3
        span = (array.get(L.log, n - 1).t - array.get(L.log, 0).t) / f_degMs(L.deg)   // degree-bars, TF-invariant
        avgGap = span / (n - 1)
        s := math.min(avgGap / sepNorm, 1.0)
    s

// REAL qualified-interaction count from the event log (no estimates): an event
// qualifies if it is the first, or sits >= sepNorm bars after the last QUALIFIED
// one — i.e. a genuinely separate visit, not a clustered re-hit. Greedy, deterministic.
f_qualified(Lvl L) =>
    n = array.size(L.log)
    int q = 0
    float lastQ = 0.0
    if n > 0
        for i = 0 to n - 1
            b = array.get(L.log, i).t
            if q == 0 or (b - lastQ) / f_degMs(L.deg) >= sepNorm   // spacing in degree-bars, TF-invariant
                q += 1
                lastQ := b
    q

// SINGLE SOURCE of the score AND its audit breakdown. Returns:
// [conf, winF, rejF, dispF, sweepF, sepF, evidF, degW, nEv, avgW, held, brk]
// avgW = average recency weight (the decay indicator: 1 = all fresh, →0 = old).
f_audit(Lvl L) =>
    n = array.size(L.log)
    float conf = 0.0
    float winF = 0.5
    float rejF = 0.0
    float dispF = 0.0
    float sweepF = 0.0
    float sepF = 1.0
    float evidF = 0.0
    float avgW = 0.0
    int held = 0
    int brk = 0
    float degW = L.deg == 3 ? 1.0 : L.deg == 2 ? 0.85 : L.deg == 1 ? 0.70 : 0.55
    if n > 0
        float wsum = 0.0
        float rejW = 0.0
        float dispW = 0.0
        float sweepW = 0.0
        for i = 0 to n - 1
            ev = array.get(L.log, i)
            age = math.max(0.0, (nowRef - ev.t) / f_degMs(L.deg))   // age in degree-bars, TF-invariant
            w = 1.0 / (1.0 + age / decayBars)          // recency decay
            wsum := wsum + w
            rejW := rejW + w * ev.rejQ
            dispW := dispW + w * math.min(ev.react / dispNorm, 1.0)
            if ev.swept
                sweepW := sweepW + w
            if ev.kind == 2
                held := held + 1
            if ev.kind == 3
                brk := brk + 1
        winF   := (held + brk) > 0 ? held / (held + brk) : 0.5
        rejF   := wsum > 0 ? rejW / wsum : 0.0
        dispF  := wsum > 0 ? dispW / wsum : 0.0
        sweepF := wsum > 0 ? math.min(sweepW / wsum * 2.0, 1.0) : 0.0
        sepF   := f_separation(L)
        evidF  := math.min(wsum / evidNorm, 1.0)
        avgW   := wsum / n
        wtot   = wWin + wRej + wDisp + wSweep + wSep + wEvid
        raw    = wtot > 0 ? (winF*wWin + rejF*wRej + dispF*wDisp + sweepF*wSweep + sepF*wSep + evidF*wEvid) / wtot : 0.0
        conf   := math.min(math.max(raw * degW * 100.0, 0.0), 100.0)
    [conf, winF, rejF, dispF, sweepF, sepF, evidF, degW, n, avgW, held, brk]

// score only (thin wrapper over the single source)
f_conf(Lvl L) =>
    [cf, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11] = f_audit(L)
    cf

// point-contribution of one component to the final confidence (they sum to CONF)
f_pts(float f, float w, float wtot, float dg) => wtot > 0 ? f * w / wtot * dg * 100.0 : 0.0

// ── per-degree HTF data (prior CLOSED bar → non-repainting) ──────────────────
[h1, l1, c1, pc1] = request.security(syminfo.tickerid, "60",  [high[1], low[1], close[1], close[2]], lookahead=barmerge.lookahead_on)
[h4, l4, c4, pc4] = request.security(syminfo.tickerid, "240", [high[1], low[1], close[1], close[2]], lookahead=barmerge.lookahead_on)
[hd, ld, cd, pcd] = request.security(syminfo.tickerid, "D",   [high[1], low[1], close[1], close[2]], lookahead=barmerge.lookahead_on)
[hw, lw, cw, pcw] = request.security(syminfo.tickerid, "W",   [high[1], low[1], close[1], close[2]], lookahead=barmerge.lookahead_on)

// COMPLETE anchor set per degree, accumulated INSIDE each degree's OWN context so it is
// driven by that degree's full bar history — NOT by how far back the chart reaches.
// (This is why 1m used to show almost nothing: it only walked ~3.5 days of chart bars,
// so it never created the older HTF pivots. The 1D-context accumulator sees them all.)
f_pushUniq(array<float> a, float px) =>
    if not na(px)
        bnd = px * bandPct / 100.0
        seen = false
        if array.size(a) > 0
            for i = 0 to array.size(a) - 1
                if math.abs(array.get(a, i) - px) <= bnd
                    seen := true
                    break
        if not seen
            array.push(a, px)
    array.size(a)
f_degAnchors() =>
    var array<float> a = array.new<float>()
    ph = ta.pivothigh(high, pivLen, pivLen)
    pl = ta.pivotlow(low,  pivLen, pivLen)
    f_pushUniq(a, ph)
    f_pushUniq(a, pl)
    a
aVals1 = request.security(syminfo.tickerid, "60",  f_degAnchors(), lookahead=barmerge.lookahead_off)
aVals4 = request.security(syminfo.tickerid, "240", f_degAnchors(), lookahead=barmerge.lookahead_off)
aValsD = request.security(syminfo.tickerid, "D",   f_degAnchors(), lookahead=barmerge.lookahead_off)
aValsW = request.security(syminfo.tickerid, "W",   f_degAnchors(), lookahead=barmerge.lookahead_off)

n1 = ta.change(time("60"))  != 0
n4 = ta.change(time("240")) != 0
nd = ta.change(time("D"))   != 0
nw = ta.change(time("W"))   != 0

// seed the book ONCE with each degree's COMPLETE anchor set (HTF-sourced). Anchors are
// appended in detection order, so we process only indices not yet seeded → O(anchors)
// total across the whole chart, NOT O(bars × anchors). This is the RE10110 fix.
f_seedFrom(array<float> arr, int deg, int from) =>
    int r = from
    if not na(arr)                          // request.security arrays are na until HTF has data
        n = array.size(arr)
        if n > from
            for i = from to n - 1
                f_found(array.get(arr, i), deg, bar_index, time)
        r := n
    r
var int sd1 = 0
var int sd4 = 0
var int sdD = 0
var int sdW = 0
// Seed EVERY degree regardless of chart TF → the book is identical on every chart, so
// the Claude Zone (strongest floor/ceiling → Claude Line) is byte-stable across TFs.
// The "only show degrees ≥ chart TF" rule is applied at DISPLAY time, not here.
sd1 := f_seedFrom(aVals1, 0, sd1)
sd4 := f_seedFrom(aVals4, 1, sd4)
sdD := f_seedFrom(aValsD, 2, sdD)
sdW := f_seedFrom(aValsW, 3, sdW)

// interactions on every degree's closed bars (all degrees, all chart TFs)
f_interact(0, n1, bar_index, time, h1, l1, c1, pc1)
f_interact(1, n4, bar_index, time, h4, l4, c4, pc4)
f_interact(2, nd, bar_index, time, hd, ld, cd, pcd)
f_interact(3, nw, bar_index, time, hw, lw, cw, pcw)

// ══ POSITION LAYER — HTF MARKET-STATE ENGINE (governs the whole system) ═══════
// Per HTF (1W/1D/4H) classify the MARKET STATE from HH/HL/LH/LL progression +
// swing expansion + momentum + volatility (efficiency ratio). Bias is DERIVED
// from state — directional only in TRENDING / PULLBACK; TRANSITION / DISTRIBUTION
// / ACCUMULATION / RANGE are non-directional. 2/3 HTF agreement then CONFIRMS the
// direction (it is the confirmation filter, not the primary decision). This is the
// ONLY source of bias; the execution layer consumes it and never creates it.
// state codes: 0 RANGE · 1 TRENDING · 2 PULLBACK · 3 TRANSITION · 4 DISTRIBUTION · 5 ACCUMULATION
f_state() =>
    _ph = ta.pivothigh(high, entryBiasSw, entryBiasSw)
    _pl = ta.pivotlow(low,  entryBiasSw, entryBiasSw)
    var float _h1 = na
    var float _h2 = na
    var float _l1 = na
    var float _l2 = na
    if not na(_ph)
        _h2 := _h1
        _h1 := _ph
    if not na(_pl)
        _l2 := _l1
        _l1 := _pl
    _hh = not na(_h1) and not na(_h2) and _h1 > _h2      // higher high
    _lh = not na(_h1) and not na(_h2) and _h1 < _h2      // lower high
    _hl = not na(_l1) and not na(_l2) and _l1 > _l2      // higher low
    _ll = not na(_l1) and not na(_l2) and _l1 < _l2      // lower low
    _e  = ta.ema(close, posMomLen)                       // call ta.ema once (every bar)
    _m  = close > _e ? 1 : close < _e ? -1 : 0           // momentum
    _dir = math.abs(close - close[erLen])
    _vol = math.sum(math.abs(close - close[1]), erLen)
    _er  = _vol == 0 ? 0.0 : _dir / _vol                 // efficiency ratio = volatility/strength
    var int _tm = 0                                       // trend memory (last clean structure)
    _su = _hh and _hl                                     // clean bullish structure
    _sd = _lh and _ll                                     // clean bearish structure
    if _su
        _tm := 1
    if _sd
        _tm := -1
    int _st = 0
    int _bv = 0
    if _su
        if _er < erChop
            _st := 0                                      // dead grind → range (volatility gate)
        else
            _st := _m >= 0 ? 1 : 2                        // momentum with = TREND, against = PULLBACK
            _bv := 1
    else if _sd
        if _er < erChop
            _st := 0
        else
            _st := _m <= 0 ? 1 : 2
            _bv := -1
    else if _hh and _ll
        _st := 3                                          // broadening = volatile TRANSITION
    else if _lh and _hl
        if _tm == 1 and _er < erTrend and _m <= 0
            _st := 4                                      // coil at highs after up-trend = DISTRIBUTION
        else if _tm == -1 and _er < erTrend and _m >= 0
            _st := 5                                      // coil at lows after down-trend = ACCUMULATION
        else
            _st := 3                                      // contracting coil = TRANSITION
    else
        _st := 0                                          // no two-sided structure yet = RANGE
    int _ln = _bv != 0 ? _bv : (_st == 4 ? -1 : _st == 5 ? 1 : 0)   // directional lean (incl. D/A)
    [_st, _bv, _ln, _er]

f_statePrev() =>
    [_s, _b, _l, _e] = f_state()
    [_s[1], _b[1], _l[1], _e[1]]

// market state per HTF (state code · bias vote · lean · efficiency), prior CLOSED bar
[stW, bvW, lnW, erWv] = request.security(syminfo.tickerid, "W",   f_statePrev(), lookahead=barmerge.lookahead_on)
[stD, bvD, lnD, erDv] = request.security(syminfo.tickerid, "D",   f_statePrev(), lookahead=barmerge.lookahead_on)
[st4, bv4, ln4, er4v] = request.security(syminfo.tickerid, "240", f_statePrev(), lookahead=barmerge.lookahead_on)

// 2/3 CONFIRMATION of the state-derived votes (directional only from TREND/PULLBACK)
bulls = (bvW == 1 ? 1 : 0) + (bvD == 1 ? 1 : 0) + (bv4 == 1 ? 1 : 0)
bears = (bvW == -1 ? 1 : 0) + (bvD == -1 ? 1 : 0) + (bv4 == -1 ? 1 : 0)
posDir   = bulls >= 2 ? 1 : bears >= 2 ? -1 : 0   // confirmed direction (else neutral)
posAgree = math.max(bulls, bears)

// SYSTEM market state (precedence): confirmed dir → TRENDING if ≥2 agreeing HTFs are
// TREND else PULLBACK; no confirmed dir → conflict=TRANSITION, else surface D/A, else RANGE
trendAgree = posDir == 1 ? ((stW == 1 and bvW == 1 ? 1 : 0) + (stD == 1 and bvD == 1 ? 1 : 0) + (st4 == 1 and bv4 == 1 ? 1 : 0)) : posDir == -1 ? ((stW == 1 and bvW == -1 ? 1 : 0) + (stD == 1 and bvD == -1 ? 1 : 0) + (st4 == 1 and bv4 == -1 ? 1 : 0)) : 0
int sysState = 0
if posDir != 0
    sysState := trendAgree >= 2 ? 1 : 2
else if bulls > 0 and bears > 0
    sysState := 3
else if stW == 4 or stD == 4 or st4 == 4
    sysState := 4
else if stW == 5 or stD == 5 or st4 == 5
    sysState := 5
else
    sysState := 0
sysLean = posDir != 0 ? posDir : (sysState == 4 ? -1 : sysState == 5 ? 1 : 0)   // incl. topping/bottoming lean
erSys   = (erWv + erDv + er4v) / 3.0                                             // trending regime = TREND/PULLBACK (sysState 1/2)

f_stName(int s) => s == 1 ? "TRENDING" : s == 2 ? "PULLBACK" : s == 3 ? "TRANSITION" : s == 4 ? "DISTRIBUTION" : s == 5 ? "ACCUMULATION" : "RANGE"

// the execution layer reads ONLY this confirmed bias — it does not compute its own
entryDir = posDir

// ══ MARKET CONTEXT ENGINE — orthogonal EXTERNAL 2nd direction source ═════════════
// Independence BY CONSTRUCTION: the SAME structure classifier (f_state) applied to
// OTHER symbols (asset-class leader + market-cap tide) — never this chart's price,
// and no MA / oscillator / trend indicator. Its verdict is source-independent from
// the Structure engine (posDir), so agreement between the two is genuine confluence,
// not two views of the same series. Reads the prior CLOSED ctxTF bar (non-repaint).
[ctxStL, ctxBvL, ctxLnL, ctxErL] = request.security(leaderSym, ctxTF, f_statePrev(), lookahead=barmerge.lookahead_on)
[ctxStT, ctxBvT, ctxLnT, ctxErT] = request.security(tideSym,  ctxTF, f_statePrev(), lookahead=barmerge.lookahead_on)
// context direction: leader AND tide must agree (else neutral). External-only vote.
ctxDir = not useContext ? posDir : (ctxBvL == 1 and ctxBvT == 1) ? 1 : (ctxBvL == -1 and ctxBvT == -1) ? -1 : 0
// relative strength: this asset's structure vs the leader's — qualitative annotation, NEVER a vote
rsTag = not (useContext and useRS) ? "" : (posDir == ctxBvL and posDir != 0) ? "IN-LINE" : (posDir != 0 and ctxBvL == 0) ? "LEADING" : (posDir == 0 and ctxBvL != 0) ? "LAGGING" : (posDir != 0 and ctxBvL != 0 and posDir != ctxBvL) ? "DIVERGING" : "FLAT"

// ══ TRUE DIRECTION — the two INDEPENDENT engines must AGREE ══════════════════════
// Confidence comes from independent sources agreeing (IMIS §3). BULL/BEAR only when
// Structure (internal price) AND Context (external leader+tide) point the same way;
// opposition = CONFLICT (trap); anything else = RANGE. The system prefers RANGE.
ctxAgree    = posDir != 0 and posDir == ctxDir
ctxConflict = posDir != 0 and ctxDir != 0 and posDir != ctxDir
dirVerdict  = not useContext ? posDir : (ctxAgree ? posDir : 0)
dirTxt      = dirVerdict == 1 ? "BULL" : dirVerdict == -1 ? "BEAR" : "RANGE"
// ── publish to the data window (machine-readable for other IMIS consumers) ──
plot(ctxDir,     "ctx.direction",  display=display.data_window)
plot(dirVerdict, "true.direction", display=display.data_window)
alertcondition(ta.change(dirVerdict) != 0, "True direction change", "IMIS: true market direction changed (Structure × Context agreement)")

// ══ LOCATION ENGINE — active dealing range (the auction), reach-independent + stable ══
// Reads the last 3 CONFIRMED swings each side on a FIXED auction TF via ta.valuewhen
// (single HTF values Pine computes over the auction TF's OWN full history → identical on
// every chart TF, no accumulated book). Publishes UB/LB/EQ, premium/discount, zone state,
// and versioned auction transitions for ANY IMIS consumer. The Claude Zone is one consumer.
// rolling list of the last AU_KEEP confirmed swings (newest first), accumulated INSIDE the
// auction TF's own context → reach-independent, identical on every chart TF.
f_auSwHi() =>
    var array<float> hs = array.new<float>()
    ph = ta.pivothigh(high, auctionSwing, auctionSwing)
    if not na(ph)
        array.unshift(hs, ph)
        if array.size(hs) > 40
            array.pop(hs)
    hs
f_auSwLo() =>
    var array<float> ls = array.new<float>()
    pl = ta.pivotlow(low, auctionSwing, auctionSwing)
    if not na(pl)
        array.unshift(ls, pl)
        if array.size(ls) > 40
            array.pop(ls)
    ls
auHi = request.security(syminfo.tickerid, auctionTF, f_auSwHi(), lookahead=barmerge.lookahead_off)
auLo = request.security(syminfo.tickerid, auctionTF, f_auSwLo(), lookahead=barmerge.lookahead_off)

// nearest confirmed swing ≥ price (ceiling) / ≤ price (floor), over the whole swing list
f_nearAbove(array<float> a, float px) =>
    float r = na
    if not na(a) and array.size(a) > 0
        for i = 0 to array.size(a) - 1
            v = array.get(a, i)
            if not na(v) and v >= px and (na(r) or v < r)
                r := v
    r
f_nearBelow(array<float> a, float px) =>
    float r = na
    if not na(a) and array.size(a) > 0
        for i = 0 to array.size(a) - 1
            v = array.get(a, i)
            if not na(v) and v <= px and (na(r) or v > r)
                r := v
    r
locUB = f_nearAbove(auHi, close)   // active upper boundary
locLB = f_nearBelow(auLo, close)   // active lower boundary
locEQ = na(locUB) or na(locLB) ? na : (locUB + locLB) / 2.0
locPremium = not na(locEQ) and close >= locEQ
locRangeW  = na(locUB) or na(locLB) ? na : locUB - locLB
// zone state: 0 INSIDE · 1 APPROACH_CEIL · 2 APPROACH_FLOOR · 3 EXPANSION_UP · 4 EXPANSION_DOWN · 5 UNDEFINED
int locState = 5
if not na(locUB) and not na(locLB)
    thr = locRangeW * approachPct / 100.0
    locState := (locUB - close) <= thr ? 1 : (close - locLB) <= thr ? 2 : 0
else if na(locUB) and not na(locLB)
    locState := 3
else if na(locLB) and not na(locUB)
    locState := 4
f_locStateTxt(int s) => s == 1 ? "APPROACHING CEILING" : s == 2 ? "APPROACHING FLOOR" : s == 3 ? "EXPANSION UP" : s == 4 ? "EXPANSION DOWN" : s == 5 ? "UNDEFINED" : (locPremium ? "INSIDE · PREMIUM" : "INSIDE · DISCOUNT")

// ── Auction Version / Age / Transition (published from day one) ──
var float pUB = na
var float pLB = na
var int   auctionVer  = 0
var int   auctionBar  = 0
var int   auctionTrans = 0   // this-bar: 0 none·1 new ceiling·2 new floor·3 accept up·4 accept down·5 both
auctionTrans := 0
if barstate.isconfirmed
    ubChg = (na(locUB) != na(pUB)) or (not na(locUB) and not na(pUB) and locUB != pUB)
    lbChg = (na(locLB) != na(pLB)) or (not na(locLB) and not na(pLB) and locLB != pLB)
    if ubChg or lbChg
        auctionVer  := auctionVer + 1
        auctionBar  := bar_index
        auctionTrans := ubChg and lbChg ? 5 : (na(locUB) and not na(pUB)) ? 3 : (na(locLB) and not na(pLB)) ? 4 : ubChg ? 1 : 2
        pUB := locUB
        pLB := locLB
auctionAge = bar_index - auctionBar

// ── ATTENTION verdict: exactly 2 words — direction + what to do ──
// direction (UP/DOWN/RANGE) from the true-direction combiner · attention state from
// agreement + auction location: STAY AWAY = conflict (trap); GET READY = true direction
// AND price at a favourable location (bull cheap/at floor · bear rich/at ceiling — where the
// limit order belongs); WAIT = agreement but price extended (don't chase), or plain RANGE.
dirWord  = dirVerdict == 1 ? "UP" : dirVerdict == -1 ? "DOWN" : "RANGE"
favLong  = dirVerdict == 1 and (not locPremium or locState == 2)
favShort = dirVerdict == -1 and (locPremium or locState == 1)
attnTxt  = ctxConflict ? "STAY AWAY" : (favLong or favShort) ? "GET READY" : "WAIT"

// ── publish to the data window (machine-readable for other IMIS consumers) ──
plot(locUB,      "loc.UB",                 display=display.data_window)
plot(locLB,      "loc.LB",                 display=display.data_window)
plot(locEQ,      "loc.EQ (Claude Line)",   display=display.data_window)
plot(auctionVer, "loc.auctionVersion",     display=display.data_window)
plot(auctionAge, "loc.auctionAge",         display=display.data_window)
plot(locState,   "loc.zoneState",          display=display.data_window)
alertcondition(auctionTrans != 0, "Auction transition", "IMIS Location Engine: active auction changed (new version)")

// nearest level INDICES above / below price (true anchors — nudge never touches this)
f_nearestIdx() =>
    int _up = -1
    int _dn = -1
    float _upA = na
    float _dnA = na
    if array.size(book) > 0
        for i = 0 to array.size(book) - 1
            a = array.get(book, i).anchor
            if a >= close and (na(_upA) or a < _upA)
                _upA := a
                _up := i
            if a < close and (na(_dnA) or a > _dnA)
                _dnA := a
                _dn := i
    [_up, _dn]

// level strength for arming: its confidence + confluence bonus for neighbours
// within the merge band (same formula family as the merged-cluster STR)
f_lvlStrength(int idx) =>
    L = array.get(book, idx)
    c = f_conf(L)
    int nb = 0
    bandM = L.anchor * mergeBandPct / 100.0
    for k = 0 to array.size(book) - 1
        if k != idx and math.abs(array.get(book, k).anchor - L.anchor) <= bandM
            nb += 1
    math.min(100.0, c + conflBonus * nb)

// rejected-setups log (rolling, capped) — reasons visible on the panel hover
var array<string> rejLog = array.new<string>()
var array<int>    rejTot = array.new<int>(1, 0)
f_logRej(string why) =>
    array.push(rejLog, str.format_time(time, "MM-dd HH:mm") + "  " + why)
    if array.size(rejLog) > 30
        array.shift(rejLog)
    array.set(rejTot, 0, array.get(rejTot, 0) + 1)

// ── internal market structure (chart / execution TF) — real BOS / CHoCH ──────
// Track the last confirmed internal swing high & low; a CLOSE beyond one is an
// internal structure break (fired once per swing). Non-repainting: the pivots
// confirm internalPiv bars late and are only read after they confirm.
iPH = ta.pivothigh(high, internalPiv, internalPiv)
iPL = ta.pivotlow(low,  internalPiv, internalPiv)
var float iSwHi   = na
var float iSwLo   = na
var bool  iHiUsed = true
var bool  iLoUsed = true
var int   iTrend  = 0
if not na(iPH)
    iSwHi   := iPH
    iHiUsed := false
if not na(iPL)
    iSwLo   := iPL
    iLoUsed := false
brokeHiNow = not na(iSwHi) and not iHiUsed and close > iSwHi
brokeLoNow = not na(iSwLo) and not iLoUsed and close < iSwLo
// classify the break: CHoCH (flips internal trend) vs BOS (continuation)
bool chochUp = false
bool chochDn = false
if brokeHiNow
    chochUp := iTrend <= 0
    iTrend  := 1
    iHiUsed := true
if brokeLoNow
    chochDn := iTrend >= 0
    iTrend  := -1
    iLoUsed := true

// ATR (sweep-depth threshold) + premium / discount range on the execution TF
atrE  = ta.atr(atrLen)
rngHi = ta.highest(high, locLookback)
rngLo = ta.lowest(low,  locLookback)
eqM   = (rngHi + rngLo) / 2.0

// opposing-liquidity target (draw on liquidity): nearest STRONG opposing level;
// fall back to the range extreme (the sell-/buy-side pool) when none qualifies.
f_oppLiq(int dir, float fromPx) =>
    float best = na
    if array.size(book) > 0
        for i = 0 to array.size(book) - 1
            a = array.get(book, i).anchor
            if dir == -1 and a < fromPx and f_lvlStrength(i) >= entryMinCnf and (na(best) or a > best)
                best := a
            if dir == 1 and a > fromPx and f_lvlStrength(i) >= entryMinCnf and (na(best) or a < best)
                best := a
    na(best) ? (dir == -1 ? rngLo : rngHi) : best

// execution-TF guard: engine runs only on execution timeframes (default ≤ 5m)
execOK = chartSec <= timeframe.in_seconds(maxExecTF)

// state machine: 0 IDLE · 1 SWEPT (await internal BOS/CHoCH in bias direction)
var int   eSt        = 0
var int   eDirL      = 0     // -1 short / +1 long
var float eAnchor    = na    // swept level
var float eSwHi      = na    // sweep bar extremes
var float eSwLo      = na
var int   eSwBar     = 0
var float eStructRef = na    // the internal swing that was broken (display)
var string eBreakK   = ""    // "CHoCH" / "BOS" (display)
var int   eCool      = 0
var int   eSigCnt    = 0
bool sigLong  = false
bool sigShort = false
float sigStop = na
float sigTgt  = na

if useEntry and execOK and barstate.isconfirmed
    [iUp, iDn] = f_nearestIdx()
    float nUp = iUp >= 0 ? array.get(book, iUp).anchor : na
    float nDn = iDn >= 0 ? array.get(book, iDn).anchor : na
    // resets for a live setup: bias flip, window expiry, sweep-extreme reclaim
    if eSt == 1
        dTag = eDirL == -1 ? "SHORT" : "LONG"
        if entryDir != eDirL
            f_logRej(dTag + " @" + str.tostring(eAnchor, format.mintick) + " — bias flipped")
            eSt := 0
        else if bar_index - eSwBar > seqWindow
            f_logRej(dTag + " @" + str.tostring(eAnchor, format.mintick) + " — no internal break in window")
            eSt := 0
        else if eDirL == -1 and close > eSwHi
            f_logRej(dTag + " @" + str.tostring(eAnchor, format.mintick) + " — invalidated: close above sweep high")
            eSt := 0
        else if eDirL == 1 and close < eSwLo
            f_logRej(dTag + " @" + str.tostring(eAnchor, format.mintick) + " — invalidated: close below sweep low")
            eSt := 0
    // CONFIRM: a real internal BOS/CHoCH in the bias direction, after the sweep bar
    if eSt == 1 and bar_index > eSwBar
        if eDirL == -1 and brokeLoNow
            sigShort := true
            eStructRef := iSwLo
            eBreakK := chochDn ? "CHoCH" : "BOS"
        else if eDirL == 1 and brokeHiNow
            sigLong := true
            eStructRef := iSwHi
            eBreakK := chochUp ? "CHoCH" : "BOS"
    // SIGNAL: draw + cooldown. Target = opposing liquidity (draw), not nearest level.
    if sigShort or sigLong
        sigStop := sigShort ? eSwHi : eSwLo
        sigTgt  := f_oppLiq(eDirL, close)
        rr = na(sigTgt) or math.abs(sigStop - close) == 0 ? na : math.abs(close - sigTgt) / math.abs(sigStop - close)
        txt = (sigShort ? "▼ SHORT" : "▲ LONG") + "  @" + str.tostring(close, format.mintick) + "\nsweep " + str.tostring(eAnchor, format.mintick) + " → internal " + eBreakK + " " + str.tostring(eStructRef, format.mintick) + "\nstop " + str.tostring(sigStop, format.mintick) + (na(sigTgt) ? "" : " · tgt " + str.tostring(sigTgt, format.mintick)) + (na(rr) ? "" : " · R " + str.tostring(rr, "#.0"))
        label.new(bar_index, sigShort ? high : low, txt, xloc=xloc.bar_index, style=sigShort ? label.style_label_down : label.style_label_up, color=sigShort ? color.new(#ef5350, 10) : color.new(#26a69a, 10), textcolor=color.white, size=size.small)
        if showTrdLn
            line.new(bar_index, close, bar_index + 12, close, xloc=xloc.bar_index, color=color.gray, width=1, style=line.style_solid)
            line.new(bar_index, sigStop, bar_index + 12, sigStop, xloc=xloc.bar_index, color=#ef5350, width=1, style=line.style_dotted)
            if not na(sigTgt)
                line.new(bar_index, sigTgt, bar_index + 12, sigTgt, xloc=xloc.bar_index, color=#26a69a, width=1, style=line.style_dotted)
        eSigCnt := eSigCnt + 1
        eCool := bar_index + coolBars
        eSt := 0
    // IDLE: watch for a QUALIFIED sweep of the LIVE level in the bias direction.
    // Gates (each failure logged, never silent): ATR sweep depth · premium/discount
    // location · level strength · sweep-bar rejection quality.
    if eSt == 0 and not (sigShort or sigLong) and bar_index >= eCool and entryDir != 0
        rng = high - low
        if entryDir == -1 and iUp >= 0 and high > nUp and close <= nUp
            depth = high - nUp
            strengthS = f_lvlStrength(iUp)
            rqS = rng <= 0 ? 0.0 : (high - close) / rng
            if depth < minSweepATR * atrE
                f_logRej("SHORT sweep @" + str.tostring(nUp, format.mintick) + " skipped — shallow (" + str.tostring(atrE > 0 ? depth / atrE : 0.0, "#.00") + " < " + str.tostring(minSweepATR, "#.00") + " ATR)")
            else if useLocFilter and nUp < eqM
                f_logRej("SHORT sweep @" + str.tostring(nUp, format.mintick) + " skipped — not in premium (below range mid)")
            else if strengthS < entryMinCnf
                f_logRej("SHORT sweep @" + str.tostring(nUp, format.mintick) + " skipped — weak level (STR " + str.tostring(math.round(strengthS)) + " < " + str.tostring(math.round(entryMinCnf)) + ")")
            else if rqS < rejMin
                f_logRej("SHORT sweep @" + str.tostring(nUp, format.mintick) + " skipped — weak rejection (" + str.tostring(rqS, "#.00") + " < " + str.tostring(rejMin, "#.00") + ")")
            else
                eSt := 1
                eDirL := -1
                eAnchor := nUp
                eSwHi := high
                eSwLo := low
                eSwBar := bar_index
                if showSwpMark
                    label.new(bar_index, high, "✕", xloc=xloc.bar_index, style=label.style_none, textcolor=#ef5350, size=size.small)
        else if entryDir == 1 and iDn >= 0 and low < nDn and close >= nDn
            depth = nDn - low
            strengthL = f_lvlStrength(iDn)
            rqL = rng <= 0 ? 0.0 : (close - low) / rng
            if depth < minSweepATR * atrE
                f_logRej("LONG sweep @" + str.tostring(nDn, format.mintick) + " skipped — shallow (" + str.tostring(atrE > 0 ? depth / atrE : 0.0, "#.00") + " < " + str.tostring(minSweepATR, "#.00") + " ATR)")
            else if useLocFilter and nDn > eqM
                f_logRej("LONG sweep @" + str.tostring(nDn, format.mintick) + " skipped — not in discount (above range mid)")
            else if strengthL < entryMinCnf
                f_logRej("LONG sweep @" + str.tostring(nDn, format.mintick) + " skipped — weak level (STR " + str.tostring(math.round(strengthL)) + " < " + str.tostring(math.round(entryMinCnf)) + ")")
            else if rqL < rejMin
                f_logRej("LONG sweep @" + str.tostring(nDn, format.mintick) + " skipped — weak rejection (" + str.tostring(rqL, "#.00") + " < " + str.tostring(rejMin, "#.00") + ")")
            else
                eSt := 1
                eDirL := 1
                eAnchor := nDn
                eSwHi := high
                eSwLo := low
                eSwBar := bar_index
                if showSwpMark
                    label.new(bar_index, low, "✕", xloc=xloc.bar_index, style=label.style_none, textcolor=#26a69a, size=size.small)

alertcondition(sigLong,  "M4 LONG (liquidity-first)",  "Liquidity-first LONG: floor swept + HL→HH structure confirmed")
alertcondition(sigShort, "M4 SHORT (liquidity-first)", "Liquidity-first SHORT: ceiling swept + LH→LL structure confirmed")

var table eT = table.new(position.bottom_right, 2, 7, border_width=1)
if useEntry and showEPanel and barstate.islast
    ebTxt = posDir == 1 ? "BULL" : posDir == -1 ? "BEAR" : "NEUTRAL"
    ebCol = posDir == 1 ? #26a69a : posDir == -1 ? #ef5350 : color.new(color.gray, 20)
    // context + true-direction verdict (the two independent engines)
    ctxTxt = not useContext ? "OFF" : ctxDir == 1 ? "BULL" : ctxDir == -1 ? "BEAR" : "MIXED"
    ctxCol = not useContext ? color.new(color.gray, 40) : ctxDir == 1 ? #26a69a : ctxDir == -1 ? #ef5350 : color.new(color.gray, 20)
    dCol   = dirVerdict == 1 ? #26a69a : dirVerdict == -1 ? #ef5350 : (ctxConflict ? color.new(#ff9800, 5) : color.new(color.gray, 10))
    dSub   = dirWord + " · " + attnTxt
    string ctxTip = "MARKET CONTEXT ENGINE — external, INDEPENDENT of this chart's price (no MA/oscillator)\nLeader  " + f_stName(ctxStL) + "  vote " + str.tostring(ctxBvL) + "\nTide    " + f_stName(ctxStT) + "  vote " + str.tostring(ctxBvT) + (useRS ? "\nRel. strength vs leader: " + rsTag : "") + "\n→ context " + ctxTxt + "  (leader AND tide must agree)"
    string dirTip = "TRUE DIRECTION — declared only when the two INDEPENDENT engines AGREE:\nStructure (internal HH/HL price) = " + ebTxt + "\nContext (external leader+tide)   = " + ctxTxt + "\n" + (ctxConflict ? "CONFLICT → stand aside (potential trap). Waiting is a position." : dirVerdict == 0 ? "No agreement → RANGE." : "AGREEMENT → " + dirTxt + ".")
    string biasTip = "POSITION LAYER — bias DERIVED from HTF market state; 2/3 agreement CONFIRMS\n1W  " + f_stName(stW) + "  vote " + str.tostring(bvW) + " · eff " + str.tostring(erWv, "#.00") + "\n1D  " + f_stName(stD) + "  vote " + str.tostring(bvD) + " · eff " + str.tostring(erDv, "#.00") + "\n4H  " + f_stName(st4) + "  vote " + str.tostring(bv4) + " · eff " + str.tostring(er4v, "#.00") + "\n→ " + ebTxt + "  (" + str.tostring(posAgree) + "/3 agree)  ·  only TREND/PULLBACK vote directionally"
    sName = f_stName(sysState)
    sDir  = sysLean == 1 ? " ▲" : sysLean == -1 ? " ▼" : ""
    sCol  = sysState == 1 ? (posDir == 1 ? #26a69a : #ef5350) : sysState == 2 ? color.new(#42bda8, 10) : sysState == 4 ? color.new(#ef5350, 30) : sysState == 5 ? color.new(#26a69a, 30) : color.new(color.gray, 20)
    stateTip = "MARKET STATE = " + sName + sDir + "\nHH/HL/LH/LL progression + swing expansion + momentum + volatility (efficiency " + str.tostring(erSys, "#.00") + ").\nTRENDING=with momentum · PULLBACK=counter-move in trend (buy the dip) · TRANSITION=structure shifting · DISTRIBUTION=topping · ACCUMULATION=bottoming · RANGE=balanced.\nDirectional bias only in TRENDING/PULLBACK; the rest are neutral (context/lean)."
    left = seqWindow - (bar_index - eSwBar)
    stTxt = not execOK ? "OFF — chart TF > " + maxExecTF + "m limit" : eSt == 1 ? (eDirL == -1 ? "SWEPT ▼ await bearish break (" : "SWEPT ▲ await bullish break (") + str.tostring(left) + ")" : bar_index < eCool ? "COOLDOWN " + str.tostring(eCool - bar_index) : "IDLE — watching"
    string rejTip = "REJECTED SETUPS (latest first not guaranteed — chronological):\n"
    if array.size(rejLog) > 0
        for ri = 0 to array.size(rejLog) - 1
            rejTip := rejTip + array.get(rejLog, ri) + "\n"
    else
        rejTip := rejTip + "none yet"
    table.cell(eT, 0, 0, "DIRECTION", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.small, tooltip=dirTip)
    table.cell(eT, 1, 0, dSub, text_color=color.white, bgcolor=dCol, text_size=size.small, tooltip=dirTip)
    table.cell(eT, 0, 1, "STRUCTURE", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small, tooltip=biasTip)
    table.cell(eT, 1, 1, ebTxt + "  " + str.tostring(posAgree) + "/3", text_color=color.white, bgcolor=ebCol, text_size=size.small, tooltip=biasTip)
    table.cell(eT, 0, 2, "CONTEXT", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small, tooltip=ctxTip)
    table.cell(eT, 1, 2, ctxTxt + (useRS and useContext ? "  " + rsTag : ""), text_color=color.white, bgcolor=ctxCol, text_size=size.small, tooltip=ctxTip)
    table.cell(eT, 0, 3, "MARKET STATE", text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small, tooltip=stateTip)
    table.cell(eT, 1, 3, sName + sDir, text_color=color.white, bgcolor=sCol, text_size=size.small, tooltip=stateTip)
    table.cell(eT, 0, 4, "EXEC", text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(eT, 1, 4, stTxt, text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(eT, 0, 5, "SIGNALS", text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(eT, 1, 5, str.tostring(eSigCnt), text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(eT, 0, 6, "REJECTED", text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small, tooltip=rejTip)
    table.cell(eT, 1, 6, str.tostring(array.get(rejTot, 0)), text_color=color.orange, bgcolor=color.new(color.black, 40), text_size=size.small, tooltip=rejTip)

// ── RENDER ───────────────────────────────────────────────────────────────────
var array<line>  dLine = array.new<line>()
var array<label> dLab  = array.new<label>()
var array<box>   dBox  = array.new<box>()
f_kindTxt(int k) => k == 2 ? "✓ held" : k == 3 ? "✗ break" : k == 4 ? "↻ retest" : "• touch"

if barstate.islast
    while array.size(dLine) > 0
        line.delete(array.pop(dLine))
    while array.size(dLab) > 0
        label.delete(array.pop(dLab))
    while array.size(dBox) > 0
        box.delete(array.pop(dBox))
    x1 = bar_index - math.min(400, bar_index)
    x2 = bar_index + extR
    int naIdx = -1
    float naD = 1.0e20
    int nbIdx = -1
    float nbD = 1.0e20
    if array.size(book) > 0
        for i = 0 to array.size(book) - 1
            dg = array.get(book, i).deg
            dOn = dg == 0 ? a1H : dg == 1 ? a4H : dg == 2 ? a1D : a1W
            a = array.get(book, i).anchor
            if dOn and a >= close and (a - close) < naD
                naD := a - close
                naIdx := i
            if dOn and a < close and (close - a) < nbD
                nbD := close - a
                nbIdx := i
    // confidence per level + rank: find the Nth-highest score = star threshold
    float starThr = 1.0e20
    if topN > 0 and array.size(book) > 0
        confs = array.new_float()
        for i = 0 to array.size(book) - 1
            array.push(confs, f_conf(array.get(book, i)))
        array.sort(confs, order.descending)
        idx = math.min(topN, array.size(confs)) - 1
        if idx >= 0
            starThr := array.get(confs, idx)
    // DISPLAY cap: the book holds the full HTF-sourced set, but draw only the maxLvls
    // nearest price (+ always LIVE). TF-invariant: close on the last bar = current price.
    float distThr = 1.0e20
    if array.size(book) > maxLvls
        dists = array.new_float()
        for i = 0 to array.size(book) - 1
            array.push(dists, math.abs(array.get(book, i).anchor - close))
        array.sort(dists, order.ascending)
        distThr := array.get(dists, maxLvls - 1)
    // ── CLAUDE ZONE = LOCATION ENGINE (stable auction range). The 3 lines come straight
    // from the auction boundaries — identical on every chart TF, no touch-cluster book. ──
    float aFloor    = locLB
    float aCeil     = locUB
    float claudeMid = locEQ
    if array.size(book) > 0
        for i = 0 to array.size(book) - 1
            L = array.get(book, i)
            bounces = f_count(L, 2)
            breaks  = f_count(L, 3)
            retests = f_count(L, 4)
            events  = array.size(L.log)
            live = i == naIdx or i == nbIdx
            [conf, winF, rejF, dispF, sweepF, sepF, evidF, degW, nEv, avgW, held, brk] = f_audit(L)
            starred = topN > 0 and conf >= starThr
            degOn = L.deg == 0 ? a1H : L.deg == 1 ? a4H : L.deg == 2 ? a1D : a1W   // display only degrees ≥ chart TF
            // only "All levels" draws the per-level touch book; Leading/Zone/Line-only are
            // auction-line based (drawn after the loop) so the per-level loop stays silent.
            zoneOnly = viewMode != "All levels"
            passView = zoneOnly ? false : (math.abs(L.anchor - close) <= distThr)
            liveShow = live and not zoneOnly
            if degOn and (conf >= minConf or liveShow) and (events >= minShow or liveShow) and (passView or liveShow)
                // CONFLUENCE MERGE (inline, no parallel arrays → crash-proof): absorb this level
                // if a stronger candidate sits within the merge band; else it's the cluster's line.
                merged = false
                clCount = 1
                if mergeOn
                    bandM = L.anchor * mergeBandPct / 100.0
                    for k = 0 to array.size(book) - 1
                        if k != i
                            Lk = array.get(book, k)
                            ck = f_conf(Lk)
                            livek = k == naIdx or k == nbIdx
                            candk = (ck >= minConf or livek) and (array.size(Lk.log) >= minShow or livek)
                            if candk and math.abs(Lk.anchor - L.anchor) <= bandM
                                clCount := clCount + 1
                                if ck > conf or (ck == conf and k < i)
                                    merged := true
                if mergeOn and merged
                    continue
                clStr = math.min(100.0, conf + conflBonus * (clCount - 1))
                isCluster = mergeOn and clCount > 1
                isRes = L.anchor > close
                col = colByDeg ? f_degCol(L.deg) : (isRes ? resCol : supCol)
                decided = bounces + breaks
                band = L.anchor * bandPct / 100.0
                linW = (live or starred or isCluster) ? emphWidth : lineWidth
                // manual nudge — presentation only, applies to the LIVE ceiling / floor
                nOff = (i == naIdx ? nudgeCeil : i == nbIdx ? nudgeFloor : 0.0) * L.anchor / 100.0
                drawA = L.anchor + nOff
                if L.inside and showActiveZone
                    zt = (na(L.testHi) ? L.anchor + band : math.max(L.testHi, L.anchor + band)) + nOff
                    zb = (na(L.testLo) ? L.anchor - band : math.min(L.testLo, L.anchor - band)) + nOff
                    array.push(dBox, box.new(x1, zt, x2, zb, border_color=zoneBord > 0 ? color.new(zoneCol, 40) : color.new(zoneCol, 100), bgcolor=color.new(zoneCol, zoneOp), border_width=zoneBord))
                else
                    array.push(dLine, line.new(x1, drawA, x2, drawA, color=col, width=linW, extend=f_ext(extMode), style=f_lstyle(lineStyleIn)))
                if showLbl
                    bornT = array.size(L.log) > 0 ? array.get(L.log, 0).t : time
                    string tl = "LEVEL " + str.tostring(L.anchor, format.mintick) + "  [" + f_degTxt(L.deg) + " degree]\n" + (isRes ? "resistance" : "support") + " · born " + str.format_time(bornT, "yyyy-MM-dd") + "\n———————————————\n"
                    st = math.max(0, array.size(L.log) - 15)
                    if array.size(L.log) > 0
                        for e = st to array.size(L.log) - 1
                            ev = array.get(L.log, e)
                            tl := tl + str.format_time(ev.t, "yy-MM-dd HH:mm") + "  " + f_kindTxt(ev.kind) + "  (" + str.tostring(ev.react, "#.0") + "×)\n"
                    wrtxt = decided > 0 ? str.tostring(math.round(bounces / decided * 100)) + "%" : "n/a"
                    // AUDIT breakdown (★ levels): every component's point-contribution, summing to CONF
                    if showAudit and starred
                        wtot = wWin + wRej + wDisp + wSweep + wSep + wEvid
                        qual = f_qualified(L)
                        sub = f_pts(winF, wWin, wtot, 1.0) + f_pts(rejF, wRej, wtot, 1.0) + f_pts(dispF, wDisp, wtot, 1.0) + f_pts(sweepF, wSweep, wtot, 1.0) + f_pts(sepF, wSep, wtot, 1.0) + f_pts(evidF, wEvid, wtot, 1.0)
                        tfPts = sub * (degW - 1.0)
                        tl := tl + "———— AUDIT (calculation order) ————\n"
                        tl := tl + "1 interactions  " + str.tostring(nEv) + " ev · qualified " + str.tostring(qual) + "  (≥" + str.tostring(sepNorm, "#") + " bars apart)\n"
                        tl := tl + "2 decay         avg-weight " + str.tostring(avgW, "#.00") + "  (older discounted)\n"
                        tl := tl + "3 rejection     " + str.tostring(rejF, "#.00") + "  → +" + str.tostring(f_pts(rejF, wRej, wtot, 1.0), "#.0") + "\n"
                        tl := tl + "4 displacement  " + str.tostring(dispF, "#.00") + "  → +" + str.tostring(f_pts(dispF, wDisp, wtot, 1.0), "#.0") + "\n"
                        tl := tl + "5 sweep         " + str.tostring(sweepF, "#.00") + "  → +" + str.tostring(f_pts(sweepF, wSweep, wtot, 1.0), "#.0") + "\n"
                        tl := tl + "6 win rate      " + str.tostring(math.round(winF * 100)) + "%  → +" + str.tostring(f_pts(winF, wWin, wtot, 1.0), "#.0") + "\n"
                        tl := tl + "7 separation    " + str.tostring(sepF, "#.00") + "  → +" + str.tostring(f_pts(sepF, wSep, wtot, 1.0), "#.0") + "\n"
                        tl := tl + "8 evidence      " + str.tostring(evidF, "#.00") + "  → +" + str.tostring(f_pts(evidF, wEvid, wtot, 1.0), "#.0") + "\n"
                        tl := tl + "  subtotal      " + str.tostring(sub, "#.0") + " pts\n"
                        tl := tl + "9 timeframe " + f_degTxt(L.deg) + "  ×" + str.tostring(degW, "#.00") + "  → " + (tfPts >= 0 ? "+" : "") + str.tostring(tfPts, "#.0") + " pts\n"
                        tl := tl + "10 FINAL CONF   " + str.tostring(math.round(conf)) + "  (= subtotal " + (tfPts >= 0 ? "+ " : "− ") + str.tostring(math.abs(tfPts), "#.0") + ")\n"
                    if isCluster
                        tl := tl + "———— ⧉ MERGED CLUSTER · STR " + str.tostring(math.round(clStr)) + " ————\n" + str.tostring(clCount) + " levels within " + str.tostring(mergeBandPct, "#.00") + "% of price:\n"
                        for k = 0 to array.size(book) - 1
                            Lk = array.get(book, k)
                            if math.abs(Lk.anchor - L.anchor) <= L.anchor * mergeBandPct / 100.0
                                tl := tl + "  " + str.tostring(Lk.anchor, format.mintick) + "  " + f_degTxt(Lk.deg) + " · CONF " + str.tostring(math.round(f_conf(Lk))) + " · " + str.tostring(array.size(Lk.log)) + " ev\n"
                    ltag = (starred ? "★ " : "") + (live ? "◄ LIVE  " : "")
                    degPart  = showDegTag ? "  " + f_degTxt(L.deg) : ""
                    confPart = showConf ? (isCluster ? "  ·  STR " + str.tostring(math.round(clStr)) + " ⧉×" + str.tostring(clCount) : "  ·  CONF " + str.tostring(math.round(conf))) : ""
                    statLine = showStats ? "\n" + str.tostring(events) + " ev · " + str.tostring(bounces) + "✓/" + str.tostring(breaks) + "✗ · win " + wrtxt + (retests > 0 ? " · " + str.tostring(retests) + "↻" : "") : ""
                    head = ltag + str.tostring(L.anchor, format.mintick) + degPart + " " + (isRes ? "RES" : "SUP") + confPart + statLine
                    lblX = lblSide == "Left" ? x1 : x2
                    lblStyle = lblSide == "Left" ? label.style_label_right : label.style_label_left
                    array.push(dLab, label.new(lblX, drawA, head, xloc=xloc.bar_index, style=lblStyle, color=color.new(col, live ? 0 : lblOp), textcolor=color.white, size=f_sz(lblSize), tooltip=tl))
    // ── CLAUDE ZONE = Location Engine boundaries (auction floor/ceiling) + Leading swings ──
    zoneOn = viewMode == "Claude Zone (3)"
    leadOn = viewMode == "Leading (ranked)"
    if zoneOn and not na(aFloor)
        array.push(dLine, line.new(x1, aFloor, x2, aFloor, color=czFloorCol, width=czFloorW, extend=f_ext(extMode), style=f_lstyle(czFloorSty)))
        if showZoneLbl
            array.push(dLab, label.new(x2, aFloor, "◄ FLOOR " + str.tostring(aFloor, format.mintick) + "  (auction " + auctionTF + ")", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(czFloorCol, 0), textcolor=color.white, size=f_sz(lblSize)))
    if zoneOn and not na(aCeil)
        array.push(dLine, line.new(x1, aCeil, x2, aCeil, color=czCeilCol, width=czCeilW, extend=f_ext(extMode), style=f_lstyle(czCeilSty)))
        if showZoneLbl
            array.push(dLab, label.new(x2, aCeil, "◄ CEILING " + str.tostring(aCeil, format.mintick) + "  (auction " + auctionTF + ")", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(czCeilCol, 0), textcolor=color.white, size=f_sz(lblSize)))
    // Leading (ranked): the nearest leadN confirmed auction swings each side of price (stable)
    if leadOn
        int nUpDrawn = 0
        if not na(auHi) and array.size(auHi) > 0
            srt = array.copy(auHi)
            array.sort(srt, order.ascending)
            for i = 0 to array.size(srt) - 1
                v = array.get(srt, i)
                if not na(v) and v >= close and nUpDrawn < leadN
                    fade = leadFade ? math.min(70, nUpDrawn * 22) : 0
                    array.push(dLine, line.new(x1, v, x2, v, color=color.new(leadResCol, fade), width=leadW, extend=f_ext(extMode), style=f_lstyle(leadSty)))
                    if showZoneLbl
                        array.push(dLab, label.new(x2, v, str.tostring(v, format.mintick) + " RES", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(leadResCol, math.min(80, fade + lblOp)), textcolor=color.white, size=f_sz(lblSize)))
                    nUpDrawn += 1
        int nDnDrawn = 0
        if not na(auLo) and array.size(auLo) > 0
            srt2 = array.copy(auLo)
            array.sort(srt2, order.descending)
            for i = 0 to array.size(srt2) - 1
                v = array.get(srt2, i)
                if not na(v) and v <= close and nDnDrawn < leadN
                    fade = leadFade ? math.min(70, nDnDrawn * 22) : 0
                    array.push(dLine, line.new(x1, v, x2, v, color=color.new(leadSupCol, fade), width=leadW, extend=f_ext(extMode), style=f_lstyle(leadSty)))
                    if showZoneLbl
                        array.push(dLab, label.new(x2, v, str.tostring(v, format.mintick) + " SUP", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(leadSupCol, math.min(80, fade + lblOp)), textcolor=color.white, size=f_sz(lblSize)))
                    nDnDrawn += 1
    if showClaude and not na(claudeMid)
        pd = close >= claudeMid ? "PREMIUM · lean short" : "DISCOUNT · lean long"
        beh = not gateCZ ? "" : (sysState == 1 or sysState == 2) ? "  ·  TREND → continuation only" : "  ·  RANGE → mean-revert"
        meta = showAuMeta ? "\n" + f_locStateTxt(locState) + "  ·  v" + str.tostring(auctionVer) + " · age " + str.tostring(auctionAge) : ""
        // the 2-word story: direction + what to do (both independent engines must agree)
        verdict = "\n▸ " + dirWord + " · " + attnTxt
        array.push(dLine, line.new(x1, claudeMid, x2, claudeMid, color=claudeCol, width=claudeW, extend=f_ext(extMode), style=f_lstyle(claudeSty)))
        array.push(dLab, label.new(x2, claudeMid, "CLAUDE LINE " + str.tostring(claudeMid, format.mintick) + "\n" + pd + beh + meta + verdict, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(claudeCol, 0), textcolor=color.black, size=f_sz(lblSize)))
        if showPD and viewMode != "Claude Line only" and not na(aFloor) and not na(aCeil)
            array.push(dBox, box.new(x1, aCeil, x2, claudeMid, border_color=color.new(czCeilCol, 100), bgcolor=color.new(czCeilCol, 92)))
            array.push(dBox, box.new(x1, claudeMid, x2, aFloor, border_color=color.new(czFloorCol, 100), bgcolor=color.new(czFloorCol, 92)))
