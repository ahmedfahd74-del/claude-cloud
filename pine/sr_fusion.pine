// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// (Stryk Ranges portions © Es-Sniper, MPL 2.0) and CC BY-NC-SA 4.0
// (Auto Support & Resistance portions © ForexCracked). Merged build for personal use.
//
// STRYK S/R FUSION — one engine:
//   · Auto S/R zones (chart TF + two HTFs) with touch strength, break-flip, aging
//   · DWM (prev completed Day/Week/Month) high/low + Asian range
//   · Market structure: BOS / CHoCH / MSS with sweep + displacement strong pivots
//   · Volume participation oscillator + zone-expansion candles
//   · AI CONTEXT BRAIN: weighs every signal above into one explainable bias,
//     confidence, and next action — evaluated every bar close (optional intrabar)
// Non-repainting on closed bars. HTF reads use confirmed prior-period values.

//@version=6
indicator("Stryk S/R Fusion — AI Context Engine  [v1.0]", "Fusion v1.0", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 5000)

// ════════════════════════════════════════════════════════════════════════════
// 0 · MASTER SWITCHBOARD
// ════════════════════════════════════════════════════════════════════════════
g0 = "0 · Master switchboard"
mLvlAll   = input.bool(true, "Levels — all", group = g0, tooltip = "Master hide for every on-chart level. Dashboard unaffected.")
mLvlSR    = input.bool(true, "      Auto S/R zones", group = g0)
mLvlDwm   = input.bool(true, "      DWM high/low", group = g0)
mLvlAsian = input.bool(true, "      Asian range", group = g0)
mLvlMs    = input.bool(true, "      Market structure (BOS / CHoCH)", group = g0)

// Global extension: how far every level object reaches. "Both sides" uses the
// native infinite extension so lines/zones span the whole chart.
gX = "0b · Level extension (global)"
extMode = input.string("Right (N bars)", "Extend levels", group = gX,
     options = ["Period only", "Right (N bars)", "To last bar", "Right ∞", "Both sides ∞"],
     tooltip = "Period only = each level lives inside its own period. Right (N bars) = project N bars past the newest bar. Both sides ∞ = full-chart rays in both directions.")
extBars = input.int(20, "N bars (for Right (N bars))", minval = 0, maxval = 500, group = gX)
extInf   = extMode == "Right ∞" or extMode == "Both sides ∞"
extBoth  = extMode == "Both sides ∞"
extLine  = extBoth ? extend.both : extInf ? extend.right : extend.none
extBox   = extBoth ? extend.both : extInf ? extend.right : extend.none
barMs    = timeframe.in_seconds() * 1000
extProjMs = extMode == "Right (N bars)" ? extBars * barMs : 0
extProjBars = extMode == "Right (N bars)" ? extBars : 0

// ════════════════════════════════════════════════════════════════════════════
// 1 · AUTO S/R ZONES (chart TF + two HTFs) — FXC engine, accuracy-upgraded
// ════════════════════════════════════════════════════════════════════════════
gL = "1 · Auto S/R zones — chart timeframe"
srOn     = input.bool(true, "Enable auto S/R zones", group = gL)
pivLen   = input.int(10, "Pivot strength (bars)", minval = 3, maxval = 50, group = gL, tooltip = "Bars required on each side of a swing to confirm. Non-repainting: a level appears only after confirmation.")
mergeF   = input.float(0.5, "Merge distance (x ATR)", minval = 0.1, step = 0.1, group = gL)
zoneF    = input.float(0.15, "Zone height (x ATR)", minval = 0.05, step = 0.05, group = gL)
zoneCapF = input.float(0.6, "Max zone height (x ATR)", minval = 0.1, step = 0.05, group = gL, tooltip = "UPGRADE: merged zones can no longer inflate without limit — the band is capped at this many ATR.")
maxSide  = input.int(5, "Max levels per side", minval = 2, maxval = 10, group = gL)
touchGap = input.int(3, "Touch debounce (bars)", minval = 1, maxval = 20, group = gL)

gM = "2 · Auto S/R zones — higher timeframes"
useH1    = input.bool(true, "HTF 1", inline = "h1", group = gM)
htf1     = input.timeframe("240", "", inline = "h1", group = gM)
useH2    = input.bool(true, "HTF 2", inline = "h2", group = gM)
htf2     = input.timeframe("D", "", inline = "h2", group = gM)
pivLenH  = input.int(5, "HTF pivot strength (bars)", minval = 3, maxval = 20, group = gM)
maxSideH = input.int(3, "Max HTF levels per side (each TF)", minval = 1, maxval = 6, group = gM)

gB = "3 · Breaks & aging"
brkF      = input.float(0.1, "Break buffer (x ATR)", minval = 0.0, step = 0.05, group = gB)
brkConfN  = input.int(1, "Break confirmation (closes)", minval = 1, maxval = 5, group = gB, tooltip = "UPGRADE: a zone flips only after this many consecutive closes beyond it. 1 = classic single-close break; 2+ filters fake breaks.")
maxAge    = input.int(500, "Max age of weak levels (bars)", minval = 50, group = gB)
keepStrng = input.bool(true, "Keep strong levels (4-5 stars) until broken", group = gB)

gS = "4 · S/R style"
supCol   = input.color(color.new(#2dd4bf, 78), "Support", inline = "c", group = gS)
resCol   = input.color(color.new(#e84e89, 78), "Resistance", inline = "c", group = gS)
srShowTxt = input.bool(true, "Zone TF tags", inline = "st", group = gS)
srMidLn   = input.bool(false, "Zone mid-lines", inline = "st", group = gS)

atrC = ta.atr(14)
showSR = mLvlAll and mLvlSR and srOn

tfName(string tf) =>
    out = tf
    if tf == "D" or tf == "1D"
        out := "1D"
    else if tf == "W" or tf == "1W"
        out := "1W"
    else
        mins = math.round(str.tonumber(tf))
        if not na(mins)
            out := mins >= 60 ? str.tostring(mins / 60) + "H" : str.tostring(mins) + "m"
    out

var array<box>   zBox   = array.new<box>()
var array<line>  zMidLn = array.new<line>()
var array<float> zMid   = array.new<float>()
var array<int>   zDir   = array.new<int>()    //  1 support, -1 resistance
var array<int>   zTouch = array.new<int>()
var array<int>   zLast  = array.new<int>()
var array<int>   zRank  = array.new<int>()    //  0 chart, 1 HTF1, 2 HTF2
var array<int>   zBrkN  = array.new<int>()    //  consecutive closes beyond (break confirm)

strengthOf(t) => math.min(t, 5)

paint(i) =>
    b    = array.get(zBox, i)
    d    = array.get(zDir, i)
    r    = array.get(zRank, i)
    s    = strengthOf(array.get(zTouch, i))
    base = d > 0 ? supCol : resCol
    box.set_bgcolor(b, color.new(base, 88 - s * 6))
    box.set_border_color(b, color.new(base, r > 0 ? 15 : 30))
    box.set_border_width(b, r > 0 ? 2 : 1)
    box.set_text(b, srShowTxt ? (r == 1 ? tfName(htf1) : r == 2 ? tfName(htf2) : "") : "")
    box.set_text_color(b, color.new(base, 25))
    box.set_text_size(b, size.tiny)
    box.set_text_halign(b, text.align_right)
    ml = array.get(zMidLn, i)
    if not na(ml)
        line.set_color(ml, srMidLn ? color.new(base, 40) : color.new(base, 100))
        line.set_y1(ml, array.get(zMid, i))
        line.set_y2(ml, array.get(zMid, i))

// UPGRADES vs original: touch-weighted merge mid (proven levels barely move,
// new pivots refine toward the cluster), capped zone height, break-confirm
// counter reset, mid-line object, native both-side extension.
addLevel(float price, int dir, int rank, float zHeight, float mergeDist, int leftBars) =>
    merged = false
    n = array.size(zMid)
    if n > 0
        for i = 0 to n - 1
            if not merged and math.abs(price - array.get(zMid, i)) <= mergeDist
                t = array.get(zTouch, i)
                array.set(zTouch, i, t + 1)
                array.set(zLast, i, bar_index)
                array.set(zMid, i, (array.get(zMid, i) * t + price) / (t + 1))
                if rank > array.get(zRank, i)
                    array.set(zRank, i, rank)
                b = array.get(zBox, i)
                mid = array.get(zMid, i)
                cap = zoneCapF * atrC * 0.5
                box.set_top(b, math.min(math.max(box.get_top(b), mid + zHeight), mid + cap))
                box.set_bottom(b, math.max(math.min(box.get_bottom(b), mid - zHeight), mid - cap))
                paint(i)
                merged := true
    if not merged
        lft = math.max(bar_index - leftBars, 0)
        bx = box.new(lft, price + zHeight, bar_index + extProjBars, price - zHeight,
             border_width = 1, extend = extBox)
        ml = srMidLn ? line.new(lft, price, bar_index + extProjBars, price,
             color = color.new(color.gray, 100), width = 1, style = line.style_dotted,
             extend = extLine) : line(na)
        array.push(zBox, bx)
        array.push(zMidLn, ml)
        array.push(zMid, price)
        array.push(zDir, dir)
        array.push(zTouch, 1)
        array.push(zLast, bar_index)
        array.push(zRank, rank)
        array.push(zBrkN, 0)
        paint(array.size(zMid) - 1)

removeZone(i) =>
    box.delete(array.get(zBox, i))
    ml = array.get(zMidLn, i)
    if not na(ml)
        line.delete(ml)
    array.remove(zBox, i), array.remove(zMidLn, i), array.remove(zMid, i)
    array.remove(zDir, i), array.remove(zTouch, i), array.remove(zLast, i)
    array.remove(zRank, i), array.remove(zBrkN, i)

ph = ta.pivothigh(pivLen, pivLen)
pl = ta.pivotlow(pivLen, pivLen)
if showSR and not na(ph) and not na(atrC)
    addLevel(ph, -1, 0, zoneF * atrC, mergeF * atrC, pivLen)
if showSR and not na(pl) and not na(atrC)
    addLevel(pl, 1, 0, zoneF * atrC, mergeF * atrC, pivLen)

[ph1, pl1, atr1] = request.security(syminfo.tickerid, htf1, [ta.pivothigh(pivLenH, pivLenH), ta.pivotlow(pivLenH, pivLenH), ta.atr(14)], lookahead = barmerge.lookahead_off)
[ph2, pl2, atr2] = request.security(syminfo.tickerid, htf2, [ta.pivothigh(pivLenH, pivLenH), ta.pivotlow(pivLenH, pivLenH), ta.atr(14)], lookahead = barmerge.lookahead_off)
okH1 = useH1 and timeframe.in_seconds() < timeframe.in_seconds(htf1)
okH2 = useH2 and timeframe.in_seconds() < timeframe.in_seconds(htf2)
lag1 = math.round(pivLenH * timeframe.in_seconds(htf1) / timeframe.in_seconds())
lag2 = math.round(pivLenH * timeframe.in_seconds(htf2) / timeframe.in_seconds())
var float doneH1hi = na
var float doneH1lo = na
var float doneH2hi = na
var float doneH2lo = na
if showSR and okH1 and not na(ph1) and ph1 != doneH1hi and not na(atr1)
    addLevel(ph1, -1, 1, zoneF * atr1, mergeF * atr1, lag1)
    doneH1hi := ph1
if showSR and okH1 and not na(pl1) and pl1 != doneH1lo and not na(atr1)
    addLevel(pl1, 1, 1, zoneF * atr1, mergeF * atr1, lag1)
    doneH1lo := pl1
if showSR and okH2 and not na(ph2) and ph2 != doneH2hi and not na(atr2)
    addLevel(ph2, -1, 2, zoneF * atr2, mergeF * atr2, lag2)
    doneH2hi := ph2
if showSR and okH2 and not na(pl2) and pl2 != doneH2lo and not na(atr2)
    addLevel(pl2, 1, 2, zoneF * atr2, mergeF * atr2, lag2)
    doneH2lo := pl2

// manage: touches, confirmed breaks (flip), aging
newBreak = false
if array.size(zMid) > 0 and not na(atrC)
    i = array.size(zMid) - 1
    while i >= 0
        b   = array.get(zBox, i)
        d   = array.get(zDir, i)
        r   = array.get(zRank, i)
        top = box.get_top(b)
        bot = box.get_bottom(b)
        touched = d > 0 ? (low <= top and close >= bot) : (high >= bot and close <= top)
        if touched and bar_index - array.get(zLast, i) > touchGap
            array.set(zTouch, i, array.get(zTouch, i) + 1)
            array.set(zLast, i, bar_index)
            paint(i)
        beyond = d > 0 ? close < bot - brkF * atrC : close > top + brkF * atrC
        // UPGRADE: N consecutive closes beyond → confirmed break; any close
        // back inside resets the counter (fake-break filter).
        bn = beyond ? array.get(zBrkN, i) + 1 : 0
        array.set(zBrkN, i, bn)
        if bn >= brkConfN and barstate.isconfirmed
            array.set(zDir, i, -d)
            array.set(zTouch, i, 1)
            array.set(zLast, i, bar_index)
            array.set(zBrkN, i, 0)
            paint(i)
            newBreak := true
        s = strengthOf(array.get(zTouch, i))
        exempt = r > 0 or (keepStrng and s >= 4)
        if not exempt and bar_index - array.get(zLast, i) > maxAge
            removeZone(i)
        else if barstate.islast or barstate.isconfirmed
            // PERF UPGRADE: right-edge maintenance once per closed bar / last
            // bar, not every tick; infinite modes need no per-bar updates.
            if not extInf
                box.set_right(b, bar_index + extProjBars)
                ml = array.get(zMidLn, i)
                if not na(ml)
                    line.set_x2(ml, bar_index + extProjBars)
        i := i - 1

capSide(int dir, int rank, int cap) =>
    count = 0
    n = array.size(zDir)
    if n > 0
        for i = 0 to n - 1
            if array.get(zDir, i) == dir and array.get(zRank, i) == rank
                count := count + 1
    while count > cap
        worst = -1
        worstScore = 1.0e15
        for i = 0 to array.size(zDir) - 1
            if array.get(zDir, i) == dir and array.get(zRank, i) == rank
                score = array.get(zTouch, i) * 1000000.0 + array.get(zLast, i)
                if score < worstScore
                    worstScore := score
                    worst := i
        if worst >= 0
            removeZone(worst)
        count := count - 1
capSide(1, 0, maxSide)
capSide(-1, 0, maxSide)
capSide(1, 1, maxSideH)
capSide(-1, 1, maxSideH)
capSide(1, 2, maxSideH)
capSide(-1, 2, maxSideH)

// nearest S/R — computed EVERY bar (the AI brain reads it, not just the panel)
float nearS = na
float nearR = na
int nearST = 0
int nearRT = 0
int nearSR_ = 0
int nearRR_ = 0
if array.size(zMid) > 0
    for i = 0 to array.size(zMid) - 1
        m = array.get(zMid, i)
        if m < close and (na(nearS) or m > nearS)
            nearS := m
            nearST := strengthOf(array.get(zTouch, i))
            nearSR_ := array.get(zRank, i)
        if m > close and (na(nearR) or m < nearR)
            nearR := m
            nearRT := strengthOf(array.get(zTouch, i))
            nearRR_ := array.get(zRank, i)

// ════════════════════════════════════════════════════════════════════════════
// 5 · VOLUME PARTICIPATION
// ════════════════════════════════════════════════════════════════════════════
g_volosc = "5 · Volume participation"
showVolOsc = input.bool(true, "Enable volume participation", group = g_volosc)
volOscEmaLen = input.int(20, "Volume EMA length", minval = 1, group = g_volosc)
volOscLook = input.int(100, "Vol-osc lookback", minval = 10, maxval = 500, group = g_volosc)
volOscHigh = input.int(60, "Vol-osc high", minval = 50, maxval = 100, group = g_volosc)
volOscLow = input.int(40, "Vol-osc low", minval = 0, maxval = 50, group = g_volosc)
volBgOn = input.bool(true, "Background tint at extremes", group = g_volosc)
volBgHigh = input.int(80, "BG tint high", minval = 50, maxval = 100, group = g_volosc)
volBgLow = input.int(20, "BG tint low", minval = 0, maxval = 50, group = g_volosc)
volBgTransp = input.int(85, "BG tint transparency", minval = 50, maxval = 98, group = g_volosc)
volOscGreen = input.color(#00bcd4, "High color", group = g_volosc)
volOscYellow = input.color(#ffd700, "Mid color", group = g_volosc)
volOscRed = input.color(#9c27b0, "Low color", group = g_volosc)

volEma = ta.ema(volume, volOscEmaLen)
volEmaAvg = ta.sma(volEma, volOscLook)
volEmaMax = ta.highest(volEma, volOscLook)
volEmaMin = ta.lowest(volEma, volOscLook)
volAbove = volEma >= volEmaAvg
volOscA = volAbove and volEmaMax != volEmaAvg ? 50.0 + (volEma - volEmaAvg) / (volEmaMax - volEmaAvg) * 50.0 : 50.0
volOscB = not volAbove and volEmaAvg != volEmaMin ? 50.0 - (volEmaAvg - volEma) / (volEmaAvg - volEmaMin) * 50.0 : 50.0
volOscVal = math.max(0, math.min(100, volAbove ? volOscA : volOscB))
volOscLightColor = volOscVal >= volOscHigh ? volOscGreen : volOscVal <= volOscLow ? volOscRed : volOscYellow
bgShade = showVolOsc and volBgOn and volOscVal >= volBgHigh ? color.new(volOscGreen, volBgTransp) : showVolOsc and volBgOn and volOscVal <= volBgLow ? color.new(volOscRed, volBgTransp) : na
bgcolor(bgShade, title = "Volume Extreme Shader")

// ════════════════════════════════════════════════════════════════════════════
// 6 · ASIAN RANGE
// ════════════════════════════════════════════════════════════════════════════
g_dwm = "6 · Asian range"
asianOn = input.bool(true, "Show Asian session range", group = g_dwm)
showAsian = mLvlAll and mLvlAsian and asianOn
asianStart = input.string("2000", "Asian start (HHMM)", inline = "atime", group = g_dwm)
asianEnd = input.string("0400", "end", inline = "atime", group = g_dwm)
asianColor = input.color(#e040fb, "Asian range color", group = g_dwm)
asianWidth = input.int(2, "Line width", minval = 1, maxval = 3, group = g_dwm)
asianStyleS = input.string("Solid", "Line style", options = ["Solid", "Dashed", "Dotted"], group = g_dwm)
showAsianLabels = input.bool(false, "Show Asia H/L labels", group = g_dwm)
asianEndOfDay = input.bool(true, "Extend to end of trading day", group = g_dwm)
asianEndOfChart = input.bool(false, "Extend to end of chart", group = g_dwm, tooltip = "Overrides end-of-day. The global 'Both sides ∞' extension also applies to Asian lines.")
asianShow = input.int(4, "Asian sessions to show", minval = 1, maxval = 20, group = g_dwm)
f_lstyle(string s) => s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid
asianStyle = f_lstyle(asianStyleS)

f_hhmm(s) => str.tonumber(str.substring(s, 0, 2)) * 60 + str.tonumber(str.substring(s, 2, 4))
aStart = f_hhmm(asianStart)
aEnd = f_hhmm(asianEnd)
curMin = hour * 60 + minute
inAsian = aStart > aEnd ? (curMin >= aStart or curMin < aEnd) : (curMin >= aStart and curMin < aEnd)
newAsian = inAsian and not inAsian[1]
endAsian = not inAsian and inAsian[1]
var float asianHi = na
var float asianLo = na
var int asianStartBar = na
var int asianStartTime = na
var array<line> asianHiLines = array.new<line>()
var array<line> asianLoLines = array.new<line>()
var array<label> asianHiLbls = array.new<label>()
var array<label> asianLoLbls = array.new<label>()
if newAsian
    asianHi := high
    asianLo := low
    asianStartBar := bar_index
    asianStartTime := time
else if inAsian
    asianHi := math.max(asianHi, high)
    asianLo := math.min(asianLo, low)
var line liveHiLine = na
var line liveLoLine = na
if showAsian and inAsian
    if newAsian
        liveHiLine := line.new(asianStartBar, asianHi, bar_index, asianHi, color = color.new(asianColor, 35), width = asianWidth, style = line.style_dotted)
        liveLoLine := line.new(asianStartBar, asianLo, bar_index, asianLo, color = color.new(asianColor, 35), width = asianWidth, style = line.style_dotted)
    if not na(liveHiLine)
        line.set_xy1(liveHiLine, asianStartBar, asianHi)
        line.set_xy2(liveHiLine, bar_index, asianHi)
        line.set_xy1(liveLoLine, asianStartBar, asianLo)
        line.set_xy2(liveLoLine, bar_index, asianLo)
var line activeHiLine = na
var line activeLoLine = na
if newAsian
    activeHiLine := na
    activeLoLine := na
bool newTradingDay = timeframe.change("D")
if newTradingDay
    activeHiLine := line(na)
    activeLoLine := line(na)
    if not na(liveHiLine)
        line.delete(liveHiLine)
        line.delete(liveLoLine)
        liveHiLine := na
        liveLoLine := na
if showAsian and endAsian and not na(asianHi)
    if not na(liveHiLine)
        line.delete(liveHiLine)
        line.delete(liveLoLine)
        liveHiLine := na
        liveLoLine := na
    line hiLn = line.new(asianStartTime, asianHi, time, asianHi, xloc = xloc.bar_time, color = asianColor, width = asianWidth, style = asianStyle, extend = extLine)
    line loLn = line.new(asianStartTime, asianLo, time, asianLo, xloc = xloc.bar_time, color = asianColor, width = asianWidth, style = asianStyle, extend = extLine)
    if asianEndOfDay
        activeHiLine := hiLn
        activeLoLine := loLn
    array.push(asianHiLines, hiLn)
    array.push(asianLoLines, loLn)
    array.push(asianHiLbls, label.new(time, asianHi, "Asia High", xloc = xloc.bar_time, textcolor = color.white, size = size.small))
    array.push(asianLoLbls, label.new(time, asianLo, "Asia Low", xloc = xloc.bar_time, textcolor = color.white, size = size.small))
    while array.size(asianHiLines) > asianShow
        line.delete(array.shift(asianHiLines))
        line.delete(array.shift(asianLoLines))
    while array.size(asianHiLbls) > asianShow
        label.delete(array.shift(asianHiLbls))
        label.delete(array.shift(asianLoLbls))
asProjMs = extProjMs
if not extInf
    if asianEndOfChart and array.size(asianHiLines) > 0
        for i = 0 to array.size(asianHiLines) - 1
            line.set_x2(array.get(asianHiLines, i), time + asProjMs)
            line.set_x2(array.get(asianLoLines, i), time + asProjMs)
    else if asianEndOfDay and not na(activeHiLine)
        line.set_x2(activeHiLine, time + asProjMs)
        line.set_x2(activeLoLine, time + asProjMs)
if array.size(asianHiLbls) > 0 and barstate.islast
    aBg = showAsianLabels ? asianColor : color.new(asianColor, 100)
    aTx = showAsianLabels ? color.white : color.new(color.white, 100)
    for i = 0 to array.size(asianHiLbls) - 1
        hLn = array.get(asianHiLines, i)
        hLb = array.get(asianHiLbls, i)
        lLb = array.get(asianLoLbls, i)
        label.set_xy(hLb, line.get_x2(hLn), line.get_y1(hLn))
        label.set_xy(lLb, line.get_x2(hLn), line.get_y1(array.get(asianLoLines, i)))
        label.set_style(hLb, label.style_label_left)
        label.set_style(lLb, label.style_label_left)
        label.set_color(hLb, aBg)
        label.set_color(lLb, aBg)
        label.set_textcolor(hLb, aTx)
        label.set_textcolor(lLb, aTx)

// ════════════════════════════════════════════════════════════════════════════
// 7 · DWM HL (previous completed Day/Week/Month, merge-proof, non-repainting)
// ════════════════════════════════════════════════════════════════════════════
g_hl = "7 · DWM high/low"
dwmHLOn = input.bool(true, "Show DWM HL lines", group = g_hl)
showDwmHL = mLvlAll and mLvlDwm and dwmHLOn
dwmHLDaily        = input.bool(true,  "Daily HL",   inline = "dwmD", group = g_hl)
dwmHLDailyColor   = input.color(#ffffff, "",         inline = "dwmD", group = g_hl)
dwmHLDailyW       = input.int(2, "Width",  minval = 1, maxval = 4, inline = "dwmD", group = g_hl)
dwmHLDailyShow    = input.int(1, "Show",   minval = 1, inline = "dwmD", group = g_hl)
dwmHLWeekly       = input.bool(true,  "Weekly HL",  inline = "dwmW", group = g_hl)
dwmHLWeeklyColor  = input.color(#ffd700, "",         inline = "dwmW", group = g_hl)
dwmHLWeeklyW      = input.int(2, "Width",  minval = 1, maxval = 4, inline = "dwmW", group = g_hl)
dwmHLWeeklyShow   = input.int(1, "Show",   minval = 1, inline = "dwmW", group = g_hl)
dwmHLMonthly      = input.bool(true,  "Monthly HL", inline = "dwmM", group = g_hl)
dwmHLMonthlyColor = input.color(#2962ff, "",         inline = "dwmM", group = g_hl)
dwmHLMonthlyW     = input.int(2, "Width",  minval = 1, maxval = 4, inline = "dwmM", group = g_hl)
dwmHLMonthlyShow  = input.int(1, "Show",   minval = 1, inline = "dwmM", group = g_hl)
dwmStyleS         = input.string("Solid", "Line style", options = ["Solid", "Dashed", "Dotted"], group = g_hl)
weekStartDay      = input.string("Sunday", "Week starts on", options = ["Sunday", "Monday"], group = g_hl)
sessOpenHr        = input.int(17, "Session opens at (hour, exchange time)", minval = 0, maxval = 23, group = g_hl)
dwmHLGradient     = input.bool(true, "Fade older HL lines", group = g_hl)
dwmHLLabels       = input.bool(false, "Show D/W/M name labels", group = g_hl)
priceScale        = mLvlAll and mLvlDwm and input.bool(false, "Day/Week prices on the price scale", group = g_hl)
dwmStyle = f_lstyle(dwmStyleS)
showDwmBias = input.bool(true, "Show DWM bias rows in dashboard", group = g_hl)
rangeInside = input.color(#2962ff, "Range pos: in-range", inline = "rng", group = g_hl)
rangeAbove  = input.color(#00ff88, "above", inline = "rng", group = g_hl)
rangeBelow  = input.color(#ff3355, "below", inline = "rng", group = g_hl)

exTz      = syminfo.timezone
_modNow   = hour(time, exTz) * 60 + minute(time, exTz)
_modPrev  = na(time[1]) ? na : hour(time[1], exTz) * 60 + minute(time[1], exTz)
sessOpenM = sessOpenHr * 60
sessNew   = na(_modPrev) or (_modNow >= sessOpenM and _modPrev < sessOpenM)
var float dHiCur = na
var float dLoCur = na
var float dHiPrev = na
var float dLoPrev = na
var int   dOpenCurT   = na
var int   dOpenPrevT  = na
var int   dClosePrevT = na
if sessNew
    dHiPrev     := dHiCur
    dLoPrev     := dLoCur
    dOpenPrevT  := dOpenCurT
    dClosePrevT := time[1]
    dOpenCurT   := time
    dHiCur := high
    dLoCur := low
else
    dHiCur := na(dHiCur) ? high : math.max(dHiCur, high)
    dLoCur := na(dLoCur) ? low  : math.min(dLoCur, low)
dayNew = sessNew and not na(dHiPrev)
wkDow  = weekStartDay == "Monday" ? dayofweek.monday : dayofweek.sunday
wkRoll = sessNew and dayofweek(time, exTz) == wkDow
var float wkHi = na
var float wkLo = na
var float priorWkHi = na
var float priorWkLo = na
var int   wkCurStartT  = na
var int   wkPrevStartT = na
var int   wkPrevEndT   = na
if wkRoll
    priorWkHi    := wkHi
    priorWkLo    := wkLo
    wkPrevStartT := wkCurStartT
    wkPrevEndT   := time[1]
    wkCurStartT  := time
    wkHi := high
    wkLo := low
else
    wkHi := na(wkHi) ? high : math.max(wkHi, high)
    wkLo := na(wkLo) ? low : math.min(wkLo, low)
[pmH, pmL, pmOpenT, pmCloseT] = request.security(syminfo.tickerid, "M", [high[1], low[1], time[1], time_close[1]], lookahead = barmerge.lookahead_on)
monNew = not na(pmOpenT) and pmOpenT != pmOpenT[1]

f_rngPct(_hi, _lo) => _hi > _lo ? (close - _lo) / (_hi - _lo) * 100.0 : na
asPct = f_rngPct(asianHi, asianLo)
dPct  = f_rngPct(dHiPrev, dLoPrev)
wPct  = f_rngPct(priorWkHi, priorWkLo)
mPct  = f_rngPct(pmH, pmL)

canShowDaily   = dwmHLDaily   and timeframe.isintraday
canShowWeekly  = dwmHLWeekly  and timeframe.isintraday
canShowMonthly = dwmHLMonthly and not timeframe.ismonthly
f_drawDWM(bool _isNew, int _anchorT, int _endT, float _h, float _l, int _show, color _color, int _width, string _lblName) =>
    var _highs   = array.new<line>()
    var _lows    = array.new<line>()
    var _ends    = array.new<int>()
    var _hLbls   = array.new<label>()
    var _lLbls   = array.new<label>()
    if _isNew and not na(_h) and not na(_l) and not na(_anchorT)
        nh = line.new(_anchorT, _h, _anchorT, _h, xloc = xloc.bar_time, color = _color, style = dwmStyle, width = _width, extend = extLine)
        nl = line.new(_anchorT, _l, _anchorT, _l, xloc = xloc.bar_time, color = _color, style = dwmStyle, width = _width, extend = extLine)
        array.push(_highs, nh)
        array.push(_lows, nl)
        array.push(_ends, _endT)
        array.push(_hLbls, label.new(_anchorT, _h, "", xloc = xloc.bar_time, textcolor = color.white, size = size.small))
        array.push(_lLbls, label.new(_anchorT, _l, "", xloc = xloc.bar_time, textcolor = color.white, size = size.small))
        if array.size(_highs) > _show
            line.delete(array.shift(_highs))
            line.delete(array.shift(_lows))
            array.shift(_ends)
            label.delete(array.shift(_hLbls))
            label.delete(array.shift(_lLbls))
        if dwmHLGradient
            _size = array.size(_highs)
            for i = 0 to _size - 1
                _t = math.min(95, (_size - 1 - i) * 20)
                line.set_color(array.get(_highs, i), color.new(_color, _t))
                line.set_color(array.get(_lows, i), color.new(_color, _t))
    _n = array.size(_highs)
    if _n > 0 and barstate.islast
        projT = time + extProjMs
        for i = 0 to _n - 1
            ownEnd = array.get(_ends, i)
            _x2 = extMode == "Period only" ? (na(ownEnd) ? time : ownEnd) : math.max(projT, time)
            hLn = array.get(_highs, i)
            lLn = array.get(_lows,  i)
            if not extInf
                line.set_x2(hLn, _x2)
                line.set_x2(lLn, _x2)
            hLb = array.get(_hLbls, i)
            lLb = array.get(_lLbls, i)
            _hBg = dwmHLLabels ? _color : color.new(_color, 100)
            _hTx = dwmHLLabels ? color.white : color.new(color.white, 100)
            label.set_xy(hLb, _x2, line.get_y1(hLn))
            label.set_xy(lLb, _x2, line.get_y1(lLn))
            label.set_text(hLb, _lblName + " High")
            label.set_text(lLb, _lblName + " Low")
            label.set_style(hLb, label.style_label_left)
            label.set_style(lLb, label.style_label_left)
            label.set_color(hLb, _hBg)
            label.set_color(lLb, _hBg)
            label.set_textcolor(hLb, _hTx)
            label.set_textcolor(lLb, _hTx)
if showDwmHL and canShowMonthly
    f_drawDWM(monNew, pmOpenT, pmCloseT, pmH, pmL, dwmHLMonthlyShow, dwmHLMonthlyColor, dwmHLMonthlyW, "Month")
if showDwmHL and canShowWeekly
    f_drawDWM(wkRoll, wkPrevStartT, wkPrevEndT, priorWkHi, priorWkLo, dwmHLWeeklyShow, dwmHLWeeklyColor, dwmHLWeeklyW, "Week")
if showDwmHL and canShowDaily
    f_drawDWM(dayNew, dOpenPrevT, dClosePrevT, dHiPrev, dLoPrev, dwmHLDailyShow, dwmHLDailyColor, dwmHLDailyW, "Day")
plot(priceScale and canShowDaily  ? dHiPrev   : na, "Day High",  color = dwmHLDailyColor,  display = display.price_scale, editable = false)
plot(priceScale and canShowDaily  ? dLoPrev   : na, "Day Low",   color = dwmHLDailyColor,  display = display.price_scale, editable = false)
plot(priceScale and canShowWeekly ? priorWkHi : na, "Week High", color = dwmHLWeeklyColor, display = display.price_scale, editable = false)
plot(priceScale and canShowWeekly ? priorWkLo : na, "Week Low",  color = dwmHLWeeklyColor, display = display.price_scale, editable = false)

// ════════════════════════════════════════════════════════════════════════════
// 7b · ZONE EXPANSION ENGINE (yellow candle on in-zone range+volume expansion)
// ════════════════════════════════════════════════════════════════════════════
g_zone = "7b · Zone expansion engine"
zoneOn        = input.bool(false, "Zone engine (yellow on in-zone expansion)", group = g_zone, tooltip = "Builds a band of ± half-width % of each period's OWN range around every D/W/M and Asian high/low; averages range + volume over the first in-zone closes, then paints the first candle that expands past that baseline on BOTH range and volume.")
zonePaint     = input.bool(true, "Paint expansion candles yellow", group = g_zone)
zonePct       = input.float(12.5, "Zone half-width (% of period range)", minval = 1.0, maxval = 50.0, step = 0.5, group = g_zone)
zoneMinBars   = input.int(3, "Baseline bars (in-zone closes)", minval = 2, maxval = 50, group = g_zone)
zoneRangeMult = input.float(1.3, "Expansion: range vs baseline", minval = 1.0, maxval = 5.0, step = 0.1, group = g_zone)
zoneVolMult   = input.float(1.5, "Expansion: volume vs baseline", minval = 1.0, maxval = 5.0, step = 0.1, group = g_zone)
zoneYellow_c  = input.color(#ffd166, "Zone yellow", group = g_zone)

f_inBand(float _c, float _w, bool _gate, bool _isHigh) => _gate and not na(_c) and (_isHigh ? (close <= _c and close >= _c - _w) : (close >= _c and close <= _c + _w))
zFrac    = zonePct / 100.0
wDailyZ  = zFrac * (dHiPrev   - dLoPrev)
wWeeklyZ = zFrac * (priorWkHi - priorWkLo)
wMonthlyZ = zFrac * (pmH      - pmL)
wAsianZ  = zFrac * (asianHi   - asianLo)
gDailyZ  = dwmHLOn and dwmHLDaily
gWeeklyZ = dwmHLOn and dwmHLWeekly
gMonthlyZ = dwmHLOn and dwmHLMonthly
gAsianZ  = asianOn and not inAsian
inZone = f_inBand(dHiPrev, wDailyZ, gDailyZ, true) or f_inBand(dLoPrev, wDailyZ, gDailyZ, false) or f_inBand(priorWkHi, wWeeklyZ, gWeeklyZ, true) or f_inBand(priorWkLo, wWeeklyZ, gWeeklyZ, false) or f_inBand(pmH, wMonthlyZ, gMonthlyZ, true) or f_inBand(pmL, wMonthlyZ, gMonthlyZ, false) or f_inBand(asianHi, wAsianZ, gAsianZ, true) or f_inBand(asianLo, wAsianZ, gAsianZ, false)
var bool  zoneActive = false
var int   zoneBars = 0
var float zSumRange = 0.0
var float zSumVol = 0.0
var float zBaseRange = na
var float zBaseVol = na
var bool  zoneYellow = false
if zoneOn
    if inZone and not zoneActive
        zoneActive := true
        zoneBars := 0
        zSumRange := 0.0
        zSumVol := 0.0
        zBaseRange := na
        zBaseVol := na
        zoneYellow := false
    if zoneActive and inZone
        if zoneBars < zoneMinBars
            zSumRange := zSumRange + (high - low)
            zSumVol := zSumVol + volume
            zoneBars := zoneBars + 1
            if zoneBars == zoneMinBars
                zBaseRange := zSumRange / zoneMinBars
                zBaseVol := zSumVol / zoneMinBars
        else
            if not zoneYellow and (high - low) > zBaseRange * zoneRangeMult and volume > zBaseVol * zoneVolMult
                zoneYellow := true
    if zoneActive and not inZone
        zoneActive := false
        zoneYellow := false
zoneFired = zoneOn and zoneYellow and not zoneYellow[1]
candleCol = zoneOn and zoneYellow and zonePaint ? zoneYellow_c : na
plotcandle(open, high, low, close, "Zone expansion candles", color = candleCol, wickcolor = candleCol, bordercolor = candleCol)

// ════════════════════════════════════════════════════════════════════════════
// 8 · MARKET STRUCTURE (BOS / CHoCH / MSS / SWEEP / STRONG PIVOT)
// ════════════════════════════════════════════════════════════════════════════
g_ict = "8 · Market structure"
ictOn      = mLvlAll and mLvlMs and input.bool(true, "Enable market structure", group = g_ict)
ictLen     = input.int(13, "Swing length", minval = 1, maxval = 50, group = g_ict)
ictBOS     = input.bool(true, "Show BOS (continuation)", group = g_ict)
ictCHOCH   = input.bool(true, "Show CHoCH (reversal)", group = g_ict)
ictShowLbl = input.bool(true, "Label breaks (BOS / CHoCH / MSS)", group = g_ict)
ictExtend  = input.int(10, "Line extend (bars)", minval = 0, maxval = 500, group = g_ict)
ictEos     = input.bool(true, "Extend lines to end of session", group = g_ict)
ictWidth   = input.int(1, "Line width", minval = 1, maxval = 4, group = g_ict)
ictBullCol = input.color(#00e676, "Bull break", inline = "ictc", group = g_ict)
ictBearCol = input.color(#ff1744, "Bear break", inline = "ictc", group = g_ict)
swpOn       = input.bool(true, "Enable sweep + displacement engine", group = g_ict)
swpSwing    = input.bool(true,  "Sweep source: swing pivots", inline = "swps1", group = g_ict)
swpAsian    = input.bool(true,  "Asian H/L", inline = "swps1", group = g_ict)
swpDay      = input.bool(true,  "Sweep source: prev Day H/L", inline = "swps2", group = g_ict)
swpWeek     = input.bool(false, "prev Week H/L", inline = "swps2", group = g_ict)
swpAtrLen   = input.int(14, "ATR length", minval = 1, group = g_ict)
swpDispMult = input.float(1.5, "Displacement body ≥ k × ATR", minval = 0.5, maxval = 5.0, step = 0.1, group = g_ict)
swpWindow   = input.int(5, "Displacement window (bars after sweep)", minval = 1, maxval = 50, group = g_ict)
mssWindow   = input.int(40, "MSS window (bars: strong pivot → CHoCH)", minval = 5, maxval = 300, group = g_ict)
swpShow     = input.int(6, "Strong pivots to keep", minval = 1, maxval = 50, group = g_ict)
swpBoxOn    = input.bool(true, "Show raid box on sweep", group = g_ict)
swpCol      = input.color(#ff6a00, "Strong pivot", inline = "swpc", group = g_ict)
swpBoxCol   = input.color(color.new(#e63030, 82), "Raid box", inline = "swpc", group = g_ict)

swpAtr = ta.atr(swpAtrLen)
ictPh  = ta.pivothigh(high, ictLen, ictLen)
ictPl  = ta.pivotlow(low, ictLen, ictLen)
var float ictLsh = na
var int   ictLshBar = na
var bool  ictLshBroken = false
var float ictLsl = na
var int   ictLslBar = na
var bool  ictLslBroken = false
var int   ictDir = 0
if not na(ictPh)
    ictLsh := ictPh
    ictLshBar := bar_index - ictLen
    ictLshBroken := false
if not na(ictPl)
    ictLsl := ictPl
    ictLslBar := bar_index - ictLen
    ictLslBroken := false

f_sweep(bool _gate, float _lvl, bool _isHigh) =>
    var bool  _pend = false
    var float _ext  = na
    var int   _sBar = na
    var float _sLvl = na
    bool _sweepNew = false
    bool _fired    = false
    if _pend and (na(_lvl) or _lvl != _sLvl)
        _pend := false
    bool _raid = _gate and not na(_lvl) and (_isHigh ? high > _lvl and close < _lvl : low < _lvl and close > _lvl)
    if _raid
        if _pend
            _ext := _isHigh ? math.max(_ext, high) : math.min(_ext, low)
        else
            _pend := true
            _sweepNew := true
            _sLvl := _lvl
            _ext  := _isHigh ? high : low
            _sBar := bar_index
    if _pend and bar_index - _sBar > swpWindow
        _pend := false
    if _pend and (_isHigh ? close > _sLvl : close < _sLvl)
        _pend := false
    if _pend
        float _body   = math.abs(close - open)
        bool  _oppDir = _isHigh ? close < open : close > open
        if _oppDir and _body >= swpDispMult * swpAtr
            _fired := true
            _pend  := false
    [_sweepNew, _fired, _ext, _sBar, _sLvl]

var array<line>  spLines  = array.new<line>()
var array<label> spLabels = array.new<label>()
var array<box>   spBoxes  = array.new<box>()
var array<line>  spActive = array.new<line>()
var int lastSpHiBar = na
var int lastSpLoBar = na
var array<line> ictActive = array.new<line>()
if ictEos and timeframe.change("D")
    while array.size(ictActive) > 0
        line.delete(array.shift(ictActive))
    array.clear(spActive)
ictX2 = ictEos ? bar_index : bar_index + ictExtend

f_spFire(bool _fired, float _ext, int _sBar, float _lvl, bool _isHigh, string _tag) =>
    if _fired
        line ln = line.new(_sBar, _ext, ictX2, _ext, color = swpCol, width = ictWidth + 1, style = line.style_solid)
        array.push(spLines, ln)
        array.push(spLabels, label.new(_sBar, _ext, "SP ✓ " + _tag, style = _isHigh ? label.style_label_down : label.style_label_up, color = color.new(swpCol, 15), textcolor = color.white, size = size.small))
        if ictEos
            array.push(spActive, ln)
        if swpBoxOn
            array.push(spBoxes, box.new(_sBar, _isHigh ? _ext : _lvl, bar_index, _isHigh ? _lvl : _ext, border_color = color.new(swpBoxCol, 40), bgcolor = swpBoxCol))
        while array.size(spLines) > swpShow
            line.delete(array.shift(spLines))
            label.delete(array.shift(spLabels))
        while array.size(spBoxes) > swpShow
            box.delete(array.shift(spBoxes))

gAsianSwp = asianOn and not inAsian
msGate = ictOn and swpOn
[swNewShH, swFireShH, swExtShH, swBarShH, swLvlShH] = f_sweep(msGate and swpSwing and not ictLshBroken, ictLsh, true)
[swNewShL, swFireShL, swExtShL, swBarShL, swLvlShL] = f_sweep(msGate and swpSwing and not ictLslBroken, ictLsl, false)
[swNewAsH, swFireAsH, swExtAsH, swBarAsH, swLvlAsH] = f_sweep(msGate and swpAsian and gAsianSwp, asianHi, true)
[swNewAsL, swFireAsL, swExtAsL, swBarAsL, swLvlAsL] = f_sweep(msGate and swpAsian and gAsianSwp, asianLo, false)
[swNewDH,  swFireDH,  swExtDH,  swBarDH,  swLvlDH ] = f_sweep(msGate and swpDay, dHiPrev, true)
[swNewDL,  swFireDL,  swExtDL,  swBarDL,  swLvlDL ] = f_sweep(msGate and swpDay, dLoPrev, false)
[swNewWH,  swFireWH,  swExtWH,  swBarWH,  swLvlWH ] = f_sweep(msGate and swpWeek, priorWkHi, true)
[swNewWL,  swFireWL,  swExtWL,  swBarWL,  swLvlWL ] = f_sweep(msGate and swpWeek, priorWkLo, false)
f_spFire(swFireShH, swExtShH, swBarShH, swLvlShH, true,  "Swing")
f_spFire(swFireShL, swExtShL, swBarShL, swLvlShL, false, "Swing")
f_spFire(swFireAsH, swExtAsH, swBarAsH, swLvlAsH, true,  "Asia H")
f_spFire(swFireAsL, swExtAsL, swBarAsL, swLvlAsL, false, "Asia L")
f_spFire(swFireDH,  swExtDH,  swBarDH,  swLvlDH,  true,  "PDH")
f_spFire(swFireDL,  swExtDL,  swBarDL,  swLvlDL,  false, "PDL")
f_spFire(swFireWH,  swExtWH,  swBarWH,  swLvlWH,  true,  "PWH")
f_spFire(swFireWL,  swExtWL,  swBarWL,  swLvlWL,  false, "PWL")
bool spHiEvt = swFireShH or swFireAsH or swFireDH or swFireWH
bool spLoEvt = swFireShL or swFireAsL or swFireDL or swFireWL
if spHiEvt
    lastSpHiBar := bar_index
if spLoEvt
    lastSpLoBar := bar_index
sweepEvt = swNewShH or swNewShL or swNewAsH or swNewAsL or swNewDH or swNewDL or swNewWH or swNewWL
spEvt    = spHiEvt or spLoEvt

bool mssEvt = false
var int lastBreakBar = na
var int lastBreakDir = 0
var bool lastBreakWasMss = false
if ictOn and not na(ictLsh) and not ictLshBroken and close > ictLsh
    ictIsChoch = ictDir != 1
    bool isMssUp = ictIsChoch and swpOn and not na(lastSpLoBar) and bar_index - lastSpLoBar <= mssWindow
    if (ictIsChoch and ictCHOCH) or (not ictIsChoch and ictBOS)
        lnUp = line.new(ictLshBar, ictLsh, ictX2, ictLsh, color = ictBullCol, width = isMssUp ? ictWidth + 1 : ictWidth, style = isMssUp ? line.style_solid : ictIsChoch ? line.style_dotted : line.style_dashed)
        if ictShowLbl
            label.new(bar_index, ictLsh, isMssUp ? "MSS" : ictIsChoch ? "CHoCH" : "BOS", style = label.style_label_down, color = color.new(ictBullCol, 25), textcolor = color.white, size = size.tiny)
        if ictEos
            array.push(ictActive, lnUp)
    mssEvt := mssEvt or isMssUp
    ictLshBroken := true
    ictDir := 1
    lastBreakBar := bar_index
    lastBreakDir := 1
    lastBreakWasMss := isMssUp
if ictOn and not na(ictLsl) and not ictLslBroken and close < ictLsl
    ictIsChochD = ictDir != -1
    bool isMssDn = ictIsChochD and swpOn and not na(lastSpHiBar) and bar_index - lastSpHiBar <= mssWindow
    if (ictIsChochD and ictCHOCH) or (not ictIsChochD and ictBOS)
        lnDn = line.new(ictLslBar, ictLsl, ictX2, ictLsl, color = ictBearCol, width = isMssDn ? ictWidth + 1 : ictWidth, style = isMssDn ? line.style_solid : ictIsChochD ? line.style_dotted : line.style_dashed)
        if ictShowLbl
            label.new(bar_index, ictLsl, isMssDn ? "MSS" : ictIsChochD ? "CHoCH" : "BOS", style = label.style_label_up, color = color.new(ictBearCol, 25), textcolor = color.white, size = size.tiny)
        if ictEos
            array.push(ictActive, lnDn)
    mssEvt := mssEvt or isMssDn
    ictLslBroken := true
    ictDir := -1
    lastBreakBar := bar_index
    lastBreakDir := -1
    lastBreakWasMss := isMssDn
if array.size(ictActive) > 0
    for i = 0 to array.size(ictActive) - 1
        line.set_x2(array.get(ictActive, i), bar_index)
if array.size(spActive) > 0
    for i = 0 to array.size(spActive) - 1
        line.set_x2(array.get(spActive, i), bar_index)

// ════════════════════════════════════════════════════════════════════════════
// 9 · AI CONTEXT BRAIN — one explainable read of everything above
// ════════════════════════════════════════════════════════════════════════════
g_ai = "9 · AI context brain"
aiOn     = input.bool(true, "Enable AI context brain", group = g_ai, tooltip = "Weighs structure, DWM position, volume participation, sweeps/strong pivots and the S/R zone map into ONE bias + confidence + next action, with the top reasons shown. Deterministic and explainable — every point traces to a signal on the chart.")
aiMode   = input.string("Balanced", "Brain mode", options = ["Conservative", "Balanced", "Aggressive"], group = g_ai, tooltip = "Conservative needs more evidence before calling a bias; Aggressive calls it earlier. Affects thresholds only — never the levels.")
aiIntrabar = input.bool(false, "React intrabar (faster, provisional)", group = g_ai, tooltip = "ON: the brain updates on every tick for the fastest read — the current bar's contribution is provisional until close. OFF: bar-close only (fully non-repainting).")
aiWStruct = input.float(1.0, "Weight × — structure",  minval = 0.0, maxval = 2.0, step = 0.1, group = g_ai)
aiWDwm    = input.float(1.0, "Weight × — DWM position", minval = 0.0, maxval = 2.0, step = 0.1, group = g_ai)
aiWVol    = input.float(1.0, "Weight × — volume",     minval = 0.0, maxval = 2.0, step = 0.1, group = g_ai)
aiWLiq    = input.float(1.0, "Weight × — liquidity (sweeps)", minval = 0.0, maxval = 2.0, step = 0.1, group = g_ai)
aiWZone   = input.float(1.0, "Weight × — S/R zone context", minval = 0.0, maxval = 2.0, step = 0.1, group = g_ai)

aiThr = aiMode == "Conservative" ? 30.0 : aiMode == "Aggressive" ? 12.0 : 20.0
// Bar close always evaluates; intrabar mode ALSO re-reads on every tick of the
// live bar. Between evaluations the arrays hold the last read (no blanking).
aiEval = barstate.isconfirmed or (aiIntrabar and barstate.islast)

// contributions (signed toward bull) + reason strings, kept in parallel arrays
var array<float>  aiW = array.new<float>()
var array<string> aiR = array.new<string>()
f_aiAdd(float w, string r) =>
    if w != 0
        array.push(aiW, w)
        array.push(aiR, r)

mom3 = close - close[3]
if aiOn and aiEval
    array.clear(aiW)
    array.clear(aiR)
    // 1 · structure: live direction + freshness of the last break
    if ictDir != 0
        f_aiAdd(25.0 * ictDir * aiWStruct, (ictDir > 0 ? "+" : "−") + "25 structure " + (ictDir > 0 ? "bullish" : "bearish"))
    if not na(lastBreakBar) and bar_index - lastBreakBar <= 20
        f_aiAdd((lastBreakWasMss ? 15.0 : 8.0) * lastBreakDir * aiWStruct, (lastBreakDir > 0 ? "+" : "−") + (lastBreakWasMss ? "15 fresh MSS" : "8 fresh break"))
    // 2 · DWM range position: above/below prior ranges = acceptance
    if not na(dPct)
        f_aiAdd((dPct > 100 ? 12.0 : dPct < 0 ? -12.0 : (dPct - 50.0) * 0.12) * aiWDwm, dPct > 100 ? "+12 above prev-Day range" : dPct < 0 ? "−12 below prev-Day range" : "Day range pos " + str.tostring(dPct, "#") + "%")
    if not na(wPct)
        f_aiAdd((wPct > 100 ? 8.0 : wPct < 0 ? -8.0 : 0.0) * aiWDwm, wPct > 100 ? "+8 above prev-Week range" : wPct < 0 ? "−8 below prev-Week range" : "")
    if not na(mPct)
        f_aiAdd((mPct > 100 ? 5.0 : mPct < 0 ? -5.0 : 0.0) * aiWDwm, mPct > 100 ? "+5 above prev-Month range" : mPct < 0 ? "−5 below prev-Month range" : "")
    // 3 · volume participation confirms the active push
    if showVolOsc and volOscVal >= volOscHigh and math.abs(mom3) > 0
        f_aiAdd(10.0 * math.sign(mom3) * aiWVol, (mom3 > 0 ? "+" : "−") + "10 high participation w/ move")
    if showVolOsc and volOscVal <= volOscLow and not na(lastBreakBar) and bar_index - lastBreakBar <= 10
        f_aiAdd(-6.0 * lastBreakDir * aiWVol, "−6 break on weak volume (suspect)")
    // 4 · liquidity: recent validated strong pivots point AGAINST the raid side
    if swpOn and not na(lastSpLoBar) and bar_index - lastSpLoBar <= mssWindow
        f_aiAdd(12.0 * aiWLiq, "+12 low sweep → strong pivot (bullish fuel)")
    if swpOn and not na(lastSpHiBar) and bar_index - lastSpHiBar <= mssWindow
        f_aiAdd(-12.0 * aiWLiq, "−12 high sweep → strong pivot (bearish fuel)")
    // 5 · zone context: strong zone overhead is a headwind, under-foot a cushion
    if not na(nearR) and not na(atrC) and (nearR - close) < atrC * 1.0 and nearRT >= 3
        f_aiAdd(-8.0 * (nearRR_ > 0 ? 1.5 : 1.0) * aiWZone, "−" + (nearRR_ > 0 ? "12 HTF" : "8") + " resistance wall " + str.tostring(nearR, format.mintick))
    if not na(nearS) and not na(atrC) and (close - nearS) < atrC * 1.0 and nearST >= 3
        f_aiAdd(8.0 * (nearSR_ > 0 ? 1.5 : 1.0) * aiWZone, "+" + (nearSR_ > 0 ? "12 HTF" : "8") + " support floor " + str.tostring(nearS, format.mintick))
    // 6 · zone-expansion ignition: range+volume expansion AT a tracked level
    if zoneOn and zoneYellow and math.abs(mom3) > 0
        f_aiAdd(10.0 * math.sign(mom3) * aiWVol, (mom3 > 0 ? "+" : "−") + "10 expansion ignition at level")

aiNet = 0.0
if array.size(aiW) > 0
    for i = 0 to array.size(aiW) - 1
        aiNet += array.get(aiW, i)
aiBull = aiNet >= aiThr
aiBear = aiNet <= -aiThr
aiBias = aiBull ? "BULL" : aiBear ? "BEAR" : "NEUTRAL"
aiConf = math.min(100.0, math.abs(aiNet) * 1.4)

// action: bias + where price sits versus the zone map = what to actually do
distS = na(nearS) or na(atrC) ? na : (close - nearS) / atrC
distR = na(nearR) or na(atrC) ? na : (nearR - close) / atrC
aiAct = aiBias == "NEUTRAL" ? "STAND ASIDE — no edge" :
     aiBull and not na(distS) and distS < 0.8 ? "BUY ZONE — support underfoot" :
     aiBull and not na(distR) and distR < 0.8 ? "WAIT — resistance " + str.tostring(nearR, format.mintick) + " first" :
     aiBull ? "BUY DIPS → " + (na(nearS) ? "structure" : str.tostring(nearS, format.mintick)) :
     aiBear and not na(distR) and distR < 0.8 ? "SELL ZONE — resistance overhead" :
     aiBear and not na(distS) and distS < 0.8 ? "WAIT — support " + str.tostring(nearS, format.mintick) + " first" :
     "SELL RALLIES → " + (na(nearR) ? "structure" : str.tostring(nearR, format.mintick))

// top-3 reasons by absolute weight (tiny n — simple selection scan)
f_topReasons() =>
    out = ""
    n = array.size(aiW)
    if n > 0
        used0 = -1
        used1 = -1
        for k = 0 to math.min(2, n - 1)
            bi = -1
            bw = -1.0
            for i = 0 to n - 1
                if i != used0 and i != used1 and math.abs(array.get(aiW, i)) > bw and array.get(aiR, i) != ""
                    bw := math.abs(array.get(aiW, i))
                    bi := i
            if bi >= 0
                out += (out == "" ? "" : "\n") + array.get(aiR, bi)
                if used0 < 0
                    used0 := bi
                else
                    used1 := bi
    out

var string aiPrevBias = "NEUTRAL"
aiFlip = aiOn and barstate.isconfirmed and aiBias != aiPrevBias and aiBias != "NEUTRAL"
if barstate.isconfirmed
    aiPrevBias := aiBias
aiActNow = aiOn and barstate.isconfirmed and ((aiBull and not na(distS) and distS < 0.8) or (aiBear and not na(distR) and distR < 0.8))

// ════════════════════════════════════════════════════════════════════════════
// 10 · DASHBOARD (AI brain + volume + DWM % + nearest S/R)
// ════════════════════════════════════════════════════════════════════════════
g_box = "10 · Dashboard"
showBox = input.bool(true, "Show dashboard", group = g_box)
boxPos  = input.string("Bottom Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group = g_box)
boxSize = input.string("Small", "Size", options = ["Tiny", "Small", "Normal", "Large"], group = g_box)
bxAi    = input.bool(true, "Rows: AI brain", group = g_box)
bxFlow  = input.bool(true, "Rows: volume participation", group = g_box)
bxNear  = input.bool(true, "Rows: nearest S/R", group = g_box)
boxBg = input.color(color.new(#0a1a3a, 20), "Box background", group = g_box)
txtColor = input.color(#ffffff, "Box text", group = g_box)
offColor = input.color(#2a2e39, "Box off / dim", group = g_box)
posLookup = boxPos == "Top Right" ? position.top_right : boxPos == "Top Left" ? position.top_left : boxPos == "Bottom Right" ? position.bottom_right : boxPos == "Bottom Left" ? position.bottom_left : boxPos == "Middle Right" ? position.middle_right : position.middle_left
txtSize = boxSize == "Tiny" ? size.tiny : boxSize == "Small" ? size.small : boxSize == "Large" ? size.large : size.normal

f_rngCol(_pct) => na(_pct) ? offColor : _pct > 100 ? rangeAbove : _pct < 0 ? rangeBelow : rangeInside
stars(s) =>
    out = ""
    for k = 1 to 5
        out := out + (k <= s ? "★" : "☆")
    out
rkName(int r) => r == 1 ? tfName(htf1) : r == 2 ? tfName(htf2) : tfName(timeframe.period)

var table dash = table.new(position.bottom_right, 3, 12, bgcolor = color.new(#0a1a3a, 20), border_width = 2, border_color = color.new(#000000, 50))
var string dashPosPrev = ""
if showBox and barstate.islast
    if dashPosPrev != boxPos
        table.delete(dash)
        dash := table.new(posLookup, 3, 12, bgcolor = boxBg, border_width = 2, border_color = color.new(#000000, 50))
        dashPosPrev := boxPos
    r = 0
    if bxAi and aiOn
        aiCol = aiBull ? #00e676 : aiBear ? #ff1744 : color.gray
        table.cell(dash, 0, r, "🧠", text_color = aiCol, text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 1, r, aiBias + "  " + str.tostring(aiConf, "#") + "%", text_color = aiCol, text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 2, r, str.tostring(aiNet, "#.#"), text_color = color.new(txtColor, 40), text_size = txtSize, bgcolor = boxBg)
        r += 1
        table.cell(dash, 0, r, "→", text_color = aiCol, text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 1, r, aiAct, text_color = txtColor, text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 2, r, "", bgcolor = boxBg)
        r += 1
        table.cell(dash, 0, r, "", bgcolor = boxBg)
        table.cell(dash, 1, r, f_topReasons(), text_color = color.new(txtColor, 35), text_size = size.tiny, bgcolor = boxBg)
        table.cell(dash, 2, r, "", bgcolor = boxBg)
        r += 1
    if bxFlow and showVolOsc
        table.cell(dash, 0, r, "●", text_color = volOscLightColor, text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 1, r, "VOL", text_color = color.new(txtColor, 30), text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 2, r, str.tostring(volOscVal, "#") + "%", text_color = volOscLightColor, text_size = txtSize, bgcolor = boxBg)
        r += 1
    if showDwmBias
        table.cell(dash, 0, r, "●", text_color = f_rngCol(asPct), text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 1, r, "Asia", text_color = color.new(txtColor, 30), text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 2, r, na(asPct) ? "—" : str.tostring(asPct, "#") + "%", text_color = f_rngCol(asPct), text_size = txtSize, bgcolor = boxBg)
        r += 1
        table.cell(dash, 0, r, "●", text_color = f_rngCol(dPct), text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 1, r, "Day", text_color = color.new(txtColor, 30), text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 2, r, na(dPct) ? "—" : str.tostring(dPct, "#") + "%", text_color = f_rngCol(dPct), text_size = txtSize, bgcolor = boxBg)
        r += 1
        table.cell(dash, 0, r, "●", text_color = f_rngCol(wPct), text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 1, r, "Week", text_color = color.new(txtColor, 30), text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 2, r, na(wPct) ? "—" : str.tostring(wPct, "#") + "%", text_color = f_rngCol(wPct), text_size = txtSize, bgcolor = boxBg)
        r += 1
        table.cell(dash, 0, r, "●", text_color = f_rngCol(mPct), text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 1, r, "Month", text_color = color.new(txtColor, 30), text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 2, r, na(mPct) ? "—" : str.tostring(mPct, "#") + "%", text_color = f_rngCol(mPct), text_size = txtSize, bgcolor = boxBg)
        r += 1
    if bxNear
        table.cell(dash, 0, r, "R", text_color = resCol, text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 1, r, na(nearR) ? "—" : str.tostring(nearR, format.mintick) + " · " + rkName(nearRR_), text_color = txtColor, text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 2, r, na(nearR) ? "" : stars(nearRT), text_color = resCol, text_size = size.tiny, bgcolor = boxBg)
        r += 1
        table.cell(dash, 0, r, "S", text_color = supCol, text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 1, r, na(nearS) ? "—" : str.tostring(nearS, format.mintick) + " · " + rkName(nearSR_), text_color = txtColor, text_size = txtSize, bgcolor = boxBg)
        table.cell(dash, 2, r, na(nearS) ? "" : stars(nearST), text_color = supCol, text_size = size.tiny, bgcolor = boxBg)

// ════════════════════════════════════════════════════════════════════════════
// 11 · ALERTS (set "Once per bar close" — all events are close-based)
// ════════════════════════════════════════════════════════════════════════════
alertcondition(newBreak, "S/R level broken (flip)", "Fusion: a support or resistance zone broke and flipped sides on {{ticker}} ({{interval}})")
alertcondition(not na(ph) or not na(pl), "New confirmed S/R level", "Fusion: new confirmed S/R level on {{ticker}} ({{interval}})")
alertcondition(sweepEvt, "Liquidity sweep", "Fusion: wick raid through a tracked level, body closed back inside on {{ticker}} ({{interval}})")
alertcondition(spEvt, "Strong pivot confirmed", "Fusion: sweep + displacement — strong pivot anchored on {{ticker}} ({{interval}})")
alertcondition(mssEvt, "MSS — validated reversal", "Fusion: CHoCH inside the MSS window of a strong pivot on {{ticker}} ({{interval}})")
alertcondition(zoneFired, "Zone expansion (yellow)", "Fusion: in-zone range + volume expansion at a D/W/M/Asian level on {{ticker}} ({{interval}})")
alertcondition(aiFlip, "AI brain — bias flip", "Fusion AI: context bias flipped on {{ticker}} ({{interval}})")
alertcondition(aiActNow, "AI brain — act-now zone", "Fusion AI: bias aligned with an S/R zone at price on {{ticker}} ({{interval}})")
