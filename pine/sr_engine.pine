//@version=6
// =============================================================================
//  INSTITUTIONAL ADAPTIVE SUPPORT & RESISTANCE ENGINE  —  Pine Script v6
//  Modular institutional build. See sr_engine_ARCHITECTURE.md for the full map.
// -----------------------------------------------------------------------------
//  BUILD STATUS
//    [x] Phase 1  Util + Adaptive Engine + Dashboard stub
//    [x] Phase 2  Swing Engine (adaptive pivot) + HTF fetch   <-- THIS FILE
//    [x] Phase 3  Level store + Support/Resistance + auto-clean   <-- THIS FILE
//    [x] Phase 4  Scoring + Confluence + fade-by-score   <-- THIS FILE
//    [x] Phase 5  Liquidity/SMC (EQH/EQL, sweeps, FVG, order blocks)   <-- THIS FILE
//    [x] Phase 6  Visualization polish
//    [x] Phase 7  Decision Engine (Market State classifier)
//    [x] Phase 8  Probability & Trade-Quality Engine
//    [x] Phase 9  Performance / Self-Review Engine
//    [x] Phase 10 Professional Dashboard
//    [x] Phase 14 Institutional Trade Execution Engine
//    [x] Phase 15 Diagnostic + MTF/Multi-Symbol Scanners
//    [x] Phase 16 Alert Engine + JSON Data Export (Pine → Python bridge)
// -----------------------------------------------------------------------------
//  CODE LAYERS (Python-migration boundaries)
//    PURE CALC : Sections 2-5, 8-9 helpers  — stateless math, direct port
//    DECISION  : Sections 10-12, 14 (plan)  — consumes calc outputs only
//    VISUAL    : Sections 13, 14 (render), 15 — Pine-only, never ported
// =============================================================================

indicator("Institutional Adaptive S/R Engine  [v2.1.1 · 2026-07-06]", "IA-SR", overlay = true,
     max_lines_count = 200, max_labels_count = 200, max_boxes_count = 250)

// BUILD TAG — bumped every release. Shows in the indicator title on the chart
// (top-left) and on the dashboard's top row, so you can always confirm the
// running version. If this differs from the tag I quote in chat, you're on an
// old copy — re-paste the file I attached. Keep this in sync with the title.
BUILD = "v3.6-MTF · 2026-07-15"

// #############################################################################
// # SECTION 1 — INPUTS
// #############################################################################
grpMode = "Engine Mode"
engineMode = input.string("Adaptive (Auto)", "Market Sensitivity Mode", group = grpMode,
     options = ["Adaptive (Auto)", "Conservative", "Balanced", "Aggressive", "Ultra Aggressive"],
     tooltip = "Adaptive (Auto) derives strictness live from volatility, regime, liquidity and market noise — recommended. The named presets are manual overrides. Affects ONLY trade filtering and probability thresholds; S/R levels are never changed by this setting.")

grpAdapt = "Adaptive Engine (auto — leave default)"
sensBias = input.float(1.0, "Sensitivity Bias", minval = 0.5, maxval = 2.0, step = 0.1,
     group = grpAdapt,
     tooltip = "Global nudge on adaptive sensitivity. 1.0 = fully automatic. Only touch if you want the engine broadly tighter/looser.")

grpSR2 = "S/R Engine (manual overrides — leave 1.0 for auto)"
lvlSens    = input.float(1.0, "Level Sensitivity ×",              minval = 0.5,  maxval = 2.0, step = 0.1,  group = grpSR2, tooltip = "Higher = shorter adaptive pivot legs = more levels.")
touchWMult = input.float(1.0, "Touch Weight ×",                   minval = 0.2,  maxval = 3.0, step = 0.1,  group = grpSR2)
reactWMult = input.float(1.0, "Reaction Weight ×",                minval = 0.2,  maxval = 3.0, step = 0.1,  group = grpSR2)
brkConf    = input.float(1.0, "Break Confirmation Strength ×",    minval = 0.5,  maxval = 2.5, step = 0.1,  group = grpSR2, tooltip = "Higher = a close must travel further beyond a level to count as a break.")
zoneScale  = input.float(1.0, "Zone Width ×",                     minval = 0.3,  maxval = 3.0, step = 0.1,  group = grpSR2)
decaySpd   = input.float(1.0, "Time Decay Speed ×",               minval = 0.25, maxval = 4.0, step = 0.25, group = grpSR2, tooltip = "Higher = untouched levels lose freshness faster.")
htfInfl    = input.float(1.0, "HTF Confluence Influence ×",       minval = 0.3,  maxval = 2.5, step = 0.1,  group = grpSR2)
ltfNoise   = input.float(1.0, "LTF Noise Filter ×",               minval = 0.5,  maxval = 2.0, step = 0.1,  group = grpSR2, tooltip = "Higher = 15m/5m levels carry less weight in scoring and confluence.")

grpProb2 = "Probability Engine (manual overrides — leave 1.0 for auto)"
wStruct = input.float(1.0, "Trend / Structure Weight ×",  minval = 0.0, maxval = 2.0, step = 0.1, group = grpProb2)
wSRW    = input.float(1.0, "S/R Weight ×",                minval = 0.0, maxval = 2.0, step = 0.1, group = grpProb2)
wLiq    = input.float(1.0, "Liquidity / SMC Weight ×",    minval = 0.0, maxval = 2.0, step = 0.1, group = grpProb2)
wMom    = input.float(1.0, "Momentum Weight ×",           minval = 0.0, maxval = 2.0, step = 0.1, group = grpProb2)
volAdjF = input.float(0.5, "Volatility Dampening",        minval = 0.0, maxval = 1.0, step = 0.1, group = grpProb2, tooltip = "Shrinks probability edge when volatility expands beyond normal (uncertainty discount).")

// Detection sensitivity: MANUAL overrides only (sensBias × lvlSens). The
// Engine Mode deliberately has no path into swing detection or the level
// book — levels are facts; mode only changes filtering and probability.
detSens   = sensBias * lvlSens

grpTF = "Higher-Timeframe Sources"
useMN = input.bool(false, "Monthly", group = grpTF, inline = "tf")
useW  = input.bool(true,  "Weekly",  group = grpTF, inline = "tf")
useD  = input.bool(true,  "Daily",   group = grpTF, inline = "tf")
useH4 = input.bool(true,  "4 Hour",  group = grpTF, inline = "tf")
useH1 = input.bool(true,  "1 Hour",  group = grpTF, inline = "tf")
useM15 = input.bool(true, "15 Min",  group = grpTF, inline = "tf2")
useM5  = input.bool(true, "5 Min",   group = grpTF, inline = "tf2")
htfOnly = input.bool(true, "HTF-Only (hide timeframes below the chart)", group = grpTF,
     tooltip = "On (default): only levels from the current chart TF and higher. TradingView SAMPLES sub-chart timeframe data (e.g. 15m data requested on a 1h chart), which creates phantom low-quality levels — keep this on unless you know why you need it off.")

grpLvl = "Levels"
maxRefLines  = input.int(12, "Max Reference Lines (strongest kept)", minval = 1, maxval = 12, group = grpLvl,
     tooltip = "How many of the reference lines to draw. Keeps the STRONGEST by test count (most-touched first, then timeframe tier, then nearest price). Set to 1 to show only the single most-tested level. THIS is the control for the lines you see by default.")
maxLvl       = input.int(8, "Max Levels per Timeframe (detected book only)", minval = 1, maxval = 20, group = grpLvl,
     tooltip = "Only affects the optional detected swing book (off by default). Does NOT limit the reference lines — use 'Max Reference Lines' above for those.")
// Label clutter control (display only). Shortens label text and, for the reference
// lines, horizontally staggers vertically-close labels so they never overlap.
labelMode    = input.string("Compact", "Label Detail", options = ["Full", "Compact", "Price only", "Off"], group = grpLvl,
     tooltip = "Full = grade/side/price/ICS/reasons. Compact = side + price (+ICS). Price only = just the price. Off = no text (lines only). Reduces clutter when many lines are shown.")
labelDeclutter = input.bool(true, "Hide overlapping labels", group = grpLvl,
     tooltip = "ON (default): all labels sit frozen at the same far-right column; any that would overlap a nearer one is hidden (its line still shows) so the labels never collide. OFF: show every label (may overlap when levels are close).")
labelGapATR  = input.float(0.6, "Label Min Gap (Daily ATR)", minval = 0.1, maxval = 3.0, step = 0.1, group = grpLvl,
     tooltip = "Labels closer together than this (in native Daily ATR) are collapsed — only the first is shown — so text never overlaps.")
labelOffset  = input.int(10, "Label Right Offset (bars)", minval = 0, maxval = 200, group = grpLvl,
     tooltip = "Pushes the on-line labels to the right of the last candle, into the chart margin. Higher = further right.")
labelSize    = input.string("Small", "Label Size", options = ["Tiny", "Small", "Normal", "Large"], group = grpLvl)
lblSz = labelSize == "Tiny" ? size.tiny : labelSize == "Normal" ? size.normal : labelSize == "Large" ? size.large : size.small
// LEVEL ADJUSTMENT — refines only the DRAWN position of a line. It NEVER changes the
// institutional level identity, the Power selection, merge logic, ICS, or the
// deterministic cross-TF behaviour (the raw level is always what is selected/scored;
// only where the line is painted is snapped, by a deterministic, chart-independent
// function of the raw price). Default None = raw levels, unchanged.
levelAdjust  = input.string("None", "Level Adjustment (drawn position only)", options = ["None", "Nearest Round Number", "Nearest Psychological Level", "Highest Touch Level"], group = grpLvl,
     tooltip = "None = raw. Round/Psychological = snap the drawn line to the nearest round / .00-.50 level. Highest Touch = snap to the most-tested price within the window. Identity, selection, ICS and determinism are untouched — display only.")
adjATRWin    = input.float(0.5, "Adjustment Window (Daily ATR)", minval = 0.1, maxval = 3.0, step = 0.1, group = grpLvl,
     tooltip = "For 'Highest Touch Level': how far from the raw level (in native Daily ATR) to search for a more-tested price.")
minTouches   = input.int(0, "Min Touches to Show Level", minval = 0, maxval = 20, group = grpLvl,
     tooltip = "0 = show all. Higher = only show levels price has reacted to at least this many times (proven S/R).")
anchorMode   = input.string("Wick", "Level Anchor (visual only)", options = ["Wick", "Wick/Body Mid", "Body"], group = grpLvl,
     tooltip = "COSMETIC ONLY. The institutional level is always the wick extreme — its identity, score, ranking, confluence and the Power Line never change. This just shifts where the line is DRAWN toward the candle interior (Mid / Body). It can no longer create, move, or rebuild levels.")
showZones    = input.bool(false, "Show Zones (bands around levels)", group = grpLvl,
     tooltip = "Draws a faint supply/demand band around each level. Width scales with HTF ATR and the adaptive zone multiplier.")
zoneWidthK   = input.float(0.15, "Zone Width × HTF-ATR", minval = 0.02, maxval = 1.0, step = 0.01, group = grpLvl)
brkMode      = input.string("Keep", "Broken Level Behaviour", options = ["Keep", "Dim", "Remove"], group = grpLvl,
     tooltip = "Keep = line never changes/disappears (stable). Dim = dashed grey after break. Remove = delete on break (auto-clean).")
colBrk       = input.color(color.new(#787b86, 35), "Broken Level Color (Dim mode)", group = grpLvl)

grpClar = "Chart Clarity (fewer, stronger, non-overlapping lines)"
clarityOn   = input.bool(true, "Enable Chart Clarity", group = grpClar,
     tooltip = "Display-only. Fills the level budget by RELEVANCE (strength × proximity) so a small count shows the levels that matter now, collapses nearby levels to the single strongest representative, and hides levels far from price. Never changes the level book, scores, or the hash.")
clarNearK   = input.float(0.5,  "Proximity weight (relevance)", minval = 0.0, maxval = 3.0, step = 0.1, group = grpClar,
     tooltip = "How strongly nearness to price is favoured when choosing which levels to draw. 0 = pure strength; higher = prefer levels close to price.")
clusterATRk = input.float(0.50, "Cluster distance (× Daily ATR)", minval = 0.0, maxval = 3.0, step = 0.05, group = grpClar,
     tooltip = "A level within this of an already-shown stronger / higher-timeframe level is hidden — nearby levels collapse to one representative. 0 = off.")
hideFarATRk = input.float(6.0,  "Hide levels beyond (× Daily ATR)", minval = 0.0, maxval = 30.0, step = 0.5, group = grpClar,
     tooltip = "Hide any level farther than this many Daily-ATR from current price. 0 = show every distance.")

grpStyle = "Line Styles (per timeframe)"
styleMN = input.string("Solid", "Monthly", options = ["Solid", "Dashed", "Dotted"], group = grpStyle, inline = "s1")
styleW  = input.string("Solid", "Weekly",  options = ["Solid", "Dashed", "Dotted"], group = grpStyle, inline = "s1")
styleD  = input.string("Solid", "Daily",   options = ["Solid", "Dashed", "Dotted"], group = grpStyle, inline = "s2")
