styleH1 = input.string("Solid", "1 Hour",  options = ["Solid", "Dashed", "Dotted"], group = grpStyle, inline = "s3")
styleM15 = input.string("Solid", "15 Min", options = ["Solid", "Dashed", "Dotted"], group = grpStyle, inline = "s4")
styleM5  = input.string("Solid", "5 Min",  options = ["Solid", "Dashed", "Dotted"], group = grpStyle, inline = "s4")

// Global appearance — DISPLAY ONLY (never affects the level book or scoring).
grpViz = "Line Appearance (visual only)"
lineWidth   = input.int(2, "Line width", minval = 1, maxval = 6, group = grpViz)
lineOpacity = input.int(0, "Line transparency (0 = solid, 90 = faint)", minval = 0, maxval = 95, group = grpViz)
zoneOpacity = input.int(80, "Zone fill transparency", minval = 40, maxval = 98, group = grpViz,
     tooltip = "Only applies when Show Zones is on. Higher = fainter fill.")

grpPower = "Power Line"
// INSTITUTIONAL REFERENCE LINES — the cross-TF-identical MTF set (prev D/W/M
// extremes + confirmed HTF swings), drawn at their current single-security values.
// On by default; the history-dependent detected swing book is OFF by default so
// the chart shows only levels that are identical on every timeframe.
showRefLines    = input.bool(true,  "Institutional reference lines (identical on every TF)", group = grpPower,
     tooltip = "Draws PDH/PDL, PWH/PWL, PMH/PML and the last confirmed Daily/Weekly/Monthly swings at their exact prices. Each is a single higher-timeframe value, so these lines are byte-identical on a 1m and a 1D chart — the institutional MTF reference set.")
showDetectedBook = input.bool(false, "Also show detected swing book (per-chart)", group = grpPower,
     tooltip = "The auto-detected pivot levels. These depend on how much history each chart timeframe loads, so they are NOT identical across timeframes — off by default. Turn on for extra per-chart detail.")
// PERFORMANCE: the detected-book pipeline (seed + per-bar merge scans + confluence
// scoring across 7 stores) is the heavy part. It is DISABLED unless the book is
// shown or the Determinism HUD (which needs the full history) is on — so the default
// chart (reference lines + Power) is fast. Debug toggles default OFF for the same
// reason; turn them on only when needed (they slow the recalc).
showDetHUD   = input.bool(false, "DEBUG: Determinism HUD (heavy — needs book)", group = grpPower,
     tooltip = "Read-only hash + freeze/replay test of the level identities. Requires the full book pipeline, so it slows the recalc. Off by default.")
showPwrTrace = input.bool(false, "DEBUG: Power Decision trace", group = grpPower,
     tooltip = "Per-stage fingerprints of the Power decision. Off by default.")
bookActive   = showDetectedBook or showDetHUD
colRefRes       = input.color(color.new(#ef5350, 0), "Line Color — ABOVE price", group = grpPower)
colRefSup       = input.color(color.new(#26a69a, 0), "Line Color — BELOW price", group = grpPower)
colorByPos      = input.bool(true, "Color lines by price position (red above / green below)", group = grpPower,
     tooltip = "On: every line above current price is red and every line below is green, regardless of its type. Off: colour by type (resistance red / support green).")
showPowerLine = input.bool(true, "Show Power Line", group = grpPower,
     tooltip = "A single line marking the nearest turning point where price is expected to flip back into the dominant HTF trend. Overall bear → nearest resistance above; overall bull → nearest support below. Does not touch the main S/R lines.")
colPower      = input.color(color.new(#ffd600, 0), "Power Line Color", group = grpPower)
powerWidth    = input.int(2, "Power Line Width", minval = 1, maxval = 6, group = grpPower)
// TOUCH / TEST STRENGTH — a level tested repeatedly (high/low many times across
// recent D/W/M history) earns more Power. Counted from NATIVE, un-clamped period
// extremes so the strength is identical on every chart TF (does not break the
// cross-TF determinism). Toggle off for exact v3.0 selection.
powerTouchOn   = input.bool(true,  "Weight Power by touches / tests", group = grpPower,
     tooltip = "A candidate that has been a Daily/Weekly/Monthly high or low many times (a repeatedly tested level) is boosted. Counted from native period extremes, so it stays identical on every chart timeframe.")
powerTouchInfl = input.float(0.6, "Touch Influence", minval = 0.0, maxval = 2.0, step = 0.1, group = grpPower,
     tooltip = "How strongly the test count boosts the Power ranking. 0 = ignore touches (v3.0 behaviour); higher = a well-tested level dominates a merely-close one.")
touchBandK     = input.float(0.25, "Touch Cluster Band (Daily ATR)", minval = 0.05, maxval = 1.0, step = 0.05, group = grpPower,
     tooltip = "How close a historical high/low must be to a level to count as a test of it, in native Daily ATR.")
powerRadius   = input.float(8.0, "Search Radius (Daily ATR)", minval = 1.0, maxval = 30.0, step = 0.5, group = grpPower,
     tooltip = "How far from price the engine may look for its highest-confidence level. Measured in DAILY ATR so the Power Line is the same level on every chart timeframe.")
powerMinSc    = input.int(60, "Min Level Score", minval = 0, maxval = 100, group = grpPower)
powerShowStat = input.bool(true, "Show Status Intelligence", group = grpPower,
     tooltip = "Adds respect / break-likely / retest-likely and next-action readout to the Power label.")
powerTrendSide = input.bool(true, "Favor Trend-Side Level (bounce / retest logic)", group = grpPower,
     tooltip = "On (default): with a BULL HTF bias the Power Line prefers the demand level BELOW price that a bounce launches from (breakout-retest); BEAR prefers the supply level above. Off: pure nearest-strongest regardless of side.")
powerSideBias  = input.float(1.6, "Trend-Side Strength", minval = 1.0, maxval = 3.0, step = 0.1, group = grpPower,
     tooltip = "How strongly the trend side is favored. 1.0 = no preference; higher = the launch level below (in a bull trend) wins even when an overhead level is closer.")

grpSMC = "Liquidity / SMC"
showFVGZones = input.bool(false, "Draw FVG (imbalance) Zones", group = grpSMC,
