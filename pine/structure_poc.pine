// © Institutional Market Structure Engine — Deterministic MTF POC (Phase 3)
//
// The single source of truth for market structure. Detects HH / HL / LH / LL
// with INSTITUTIONAL swing logic (not a plain ZigZag), freezes each confirmed
// structure point, unions W/D/4H into one read-only database, and derives market
// bias from that database alone. Same determinism spine as the S/R and Event
// engines: confirmed-HTF-only detection, append-only union with sequence
// identity, order-independent hash, time-based replay/freeze test.
//
// CANDLE CLOSE is the single source of truth for structure:
//   · swings are CLOSE pivots — ta.pivothigh/low run on the CLOSE series, so a
//     swing is the highest/lowest CLOSE across `pivot length` bars each side
//     (wick highs/lows never define structure; a wick through a level without a
//     close is a liquidity sweep, handled by the Liquidity Engine)
//   · minimum structure distance from the last same-side point (ATR filter)
//   · classification vs the last confirmed same-side point → HH/HL/LH/LL
//   · market bias from confirmed close BOS/CHoCH (trend), not label counts
//   · confidence from the swing distance vs ATR
// Once stored a point is immutable (write-once identity, never repaints).
//
// Types: 0 HH · 1 HL · 2 LH · 3 LL   (HH/HL bullish structure, LH/LL bearish)

//@version=6
indicator("IA-Structure · Market Structure Engine POC", "IA-Struct", overlay = true,
     max_lines_count = 300, max_labels_count = 300, max_bars_back = 80,
     calc_bars_count = 1600)
// calc_bars_count caps the script to the most recent 1600 chart bars. This bounds
// BOTH memory (fewer bars → fewer points → smaller request.security arrays, so it
// runs on every timeframe) AND the number of points formed, so the per-TF book
// stays under MAXPT and no frozen-window point is ever evicted → A=B=C stays valid.
// 1600 > the 1200-bar freeze window with warm-up to spare.

// ─── Structure detection ───────────────────────────────────────────────────
pivLen  = input.int(5, "Pivot length (swing bars each side)", minval = 2, maxval = 30, group = "Structure",
     tooltip = "Institutional swing sensitivity — the pivot leg length. A swing high/low is confirmed when a CLOSE is the highest/lowest close across pivLen bars on each side. Larger = fewer, bigger structure points; smaller = more, finer ones. Detection input — changing it re-detects structure and changes the hash. (Swings are still taken from CLOSES, never wicks.)")
MINDIST = 0.50   // min structure distance from last same-side point (× ATR) — frozen
MAXPT   = 600    // per-TF structure cap. Must exceed points formed within calc_bars_count so a
                 // frozen-window point is NEVER evicted (eviction would break the A=B=C freeze).

// ─── Display (read-only — must never change the database) ──────────────────
showHH   = input.bool(true, "HH", inline = "t", group = "Display")
showHL   = input.bool(true, "HL", inline = "t", group = "Display")
showLH   = input.bool(true, "LH", inline = "t", group = "Display")
showLL   = input.bool(true, "LL", inline = "t", group = "Display")
minConf  = input.int(0, "Min confidence to show", minval = 0, maxval = 100, group = "Display",
     tooltip = "Display filter (read-only). Hide structure points below this confidence score.")
maxPts   = input.int(6, "Max points per timeframe", minval = 1, maxval = 60, group = "Display")
showTfTag = input.bool(false, "Show timeframe tag", inline = "d", group = "Display")
showConf  = input.bool(false, "Show confidence",    inline = "d", group = "Display")
lblSizeS = input.string("Tiny", "Label size", options = ["Tiny", "Small", "Normal"], group = "Display")
showW    = input.bool(true, "Show Weekly", inline = "s", group = "Display")
showD    = input.bool(true, "Show Daily",  inline = "s", group = "Display")
showH4   = input.bool(false, "Show 4H",    inline = "s", group = "Display")
colBull  = input.color(#26a69a, "Bullish structure (HH/HL)", group = "Display")
colBear  = input.color(#ef5350, "Bearish structure (LH/LL)", group = "Display")
linkPts  = input.bool(false, "Link points (structure zigzag)", group = "Display")

// ─── Validation (proof instruments — affect only the debug panel) ──────────
canonDays  = input.int(30, "Canonical hash window (days)", minval = 3, maxval = 365, group = "Validation",
     tooltip = "Cross-TF STRUCTURE HASH covers points confirmed in the last N days — keep it inside the history every timeframe loads so the hash matches across resolutions.")
windowBars = input.int(1200, "Replay window (bars, must exceed 1000)", minval = 1050, group = "Validation")

// ═══════════════════════════════════════════════════════════════════════════
// 1 · PER-TIMEFRAME STRUCTURE BOOK — runs INSIDE request.security on its own TF.
//     Gated on barstate.isconfirmed → only CLOSED source bars create/age points,
//     so a forming HTF candle can never freeze a structure record (no repaint).
// ═══════════════════════════════════════════════════════════════════════════
f_struct() =>
    var array<float> sP   = array.new<float>()   // structure price (identity, a CLOSE extreme)
    var array<int>   sTy  = array.new<int>()     // 0 HH · 1 HL · 2 LH · 3 LL
    var array<int>   sT   = array.new<int>()     // birth time (chart-independent)
    var array<float> sPar = array.new<float>()   // parent (previous same-side point)
    var array<int>   sCf  = array.new<int>()     // confidence 0-100 (frozen)
    var float lastH = na     // last CONFIRMED structure-high close
    var float lastL = na     // last CONFIRMED structure-low close
    var int trend = 0        // market trend from CONFIRMED close BOS/CHoCH: 1 bull · -1 bear · 0 none

    // PIVOT-LENGTH swing detection on the CLOSE series (never wicks). A swing high
    // is a close that is the highest close across pivLen bars on each side; a swing
    // low the lowest. ta.* MUST run every bar (never inside a conditional).
    atr = ta.atr(14)
    ph  = ta.pivothigh(close, pivLen, pivLen)   // CLOSE pivot high (confirmed pivLen bars later)
    pl  = ta.pivotlow(close,  pivLen, pivLen)   // CLOSE pivot low
    pTime = time[pivLen]                         // the pivot bar's own time (chart-independent)

    if barstate.isconfirmed
        // BOS / CHoCH — bias source: a CLOSE beyond the last confirmed swing flips
        // trend (BOS = with trend, CHoCH = against). Wicks never count here.
        if not na(lastH) and close > lastH
            trend := 1
        if not na(lastL) and close < lastL
            trend := -1
        // new swing HIGH (close pivot). MINDIST filters insignificant swings.
        if not na(ph)
            dist = na(lastH) ? atr * MINDIST : math.abs(ph - lastH)
            if dist >= atr * MINDIST
                ty = na(lastH) or ph > lastH ? 0 : 2                    // HH or LH
                cf = int(math.round(50 + 50 * math.min(1.0, dist / (atr * 3.0))))
                sP.push(ph), sTy.push(ty), sT.push(pTime), sPar.push(na(lastH) ? ph : lastH), sCf.push(cf)
                lastH := ph
        // new swing LOW (close pivot)
        if not na(pl)
            dist = na(lastL) ? atr * MINDIST : math.abs(pl - lastL)
            if dist >= atr * MINDIST
                ty = na(lastL) or pl < lastL ? 3 : 1                    // LL or HL
                cf = int(math.round(50 + 50 * math.min(1.0, dist / (atr * 3.0))))
                sP.push(pl), sTy.push(ty), sT.push(pTime), sPar.push(na(lastL) ? pl : lastL), sCf.push(cf)
                lastL := pl

        // bound per-TF book memory (oldest points age out first)
        if sP.size() > MAXPT
            sP.remove(0), sTy.remove(0), sT.remove(0), sPar.remove(0), sCf.remove(0)

    [sP, sTy, sT, sPar, sCf, trend]

// ── Lightweight TREND-ONLY engine (returns a single int, no arrays) so the bias
//    vote can read the TRUE Weekly / Daily / 4H trend on ANY chart. Because it
//    returns a scalar (not a collection), requesting a timeframe below the chart
//    is cheap — it does not trigger the array-memory blow-up that gates the books
//    above. Trend = last confirmed CLOSE BOS/CHoCH: +1 bull, -1 bear, 0 unset.
f_trend() =>
    var float lastH = na
    var float lastL = na
    var int tr = 0
    ph = ta.pivothigh(close, pivLen, pivLen)
    pl = ta.pivotlow(close,  pivLen, pivLen)
    if barstate.isconfirmed
        if not na(lastH) and close > lastH
            tr := 1
        if not na(lastL) and close < lastL
            tr := -1
        if not na(ph)
            lastH := ph
        if not na(pl)
            lastL := pl
    tr

// ═══════════════════════════════════════════════════════════════════════════
// 2 · FETCH FROZEN STRUCTURE BOOKS (one security call per TF) + chart anchors
//
//     RE10139 fix for high chart timeframes: request.security() of a timeframe
//     BELOW the chart TF replays that lower TF's ENTIRE history in-security
//     (≈6× the chart bars on 1D for the 4H book, ≈30× on 1W), exhausting memory
//     on 1D/1W. So a book is only BUILT-and-MERGED when its native TF ≥ the chart
//     TF; otherwise its request is clamped to the chart TF (a cheap same-TF call)
//     and dropped from the union. Sub-chart structure is not shown on a higher
//     chart. The freeze test is a same-chart invariant, so it is unaffected.
// ═══════════════════════════════════════════════════════════════════════════
f_reqtf(string tf) => timeframe.in_seconds(tf) < timeframe.in_seconds() ? timeframe.period : tf
useW  = timeframe.in_seconds("W")   >= timeframe.in_seconds()
useD  = timeframe.in_seconds("D")   >= timeframe.in_seconds()
use4  = timeframe.in_seconds("240") >= timeframe.in_seconds()
[wP,  wTy,  wT,  wPar,  wCf,  wTr]  = request.security(syminfo.tickerid, f_reqtf("W"),   f_struct(), lookahead = barmerge.lookahead_off)
[dP,  dTy,  dT,  dPar,  dCf,  dTr]  = request.security(syminfo.tickerid, f_reqtf("D"),   f_struct(), lookahead = barmerge.lookahead_off)
[h4P, h4Ty, h4T, h4Par, h4Cf, h4Tr] = request.security(syminfo.tickerid, f_reqtf("240"), f_struct(), lookahead = barmerge.lookahead_off)
dayOpen = request.security(syminfo.tickerid, f_reqtf("D"), time, lookahead = barmerge.lookahead_off)
// TRUE-timeframe trends for the bias vote (scalars → always requested natively,
// even when the TF is below the chart; cheap, no array-memory cost).
wTrend  = request.security(syminfo.tickerid, "W",   f_trend(), lookahead = barmerge.lookahead_off)
dTrend  = request.security(syminfo.tickerid, "D",   f_trend(), lookahead = barmerge.lookahead_off)
h4Trend = request.security(syminfo.tickerid, "240", f_trend(), lookahead = barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════════════
// 3 · MARKET STRUCTURE DATABASE — REBUILT each bar from the (bounded) per-TF
//     books, so the union never grows unbounded (fixes the memory limit). The
//     books are append-only and frozen internally, so the rebuilt union is
//     deterministic and identical across chart timeframes; a confirmed point
//     never moves. No persistent map / write-once identity needed — the books
//     already hold each distinct point once.
// ═══════════════════════════════════════════════════════════════════════════
var array<float> SP   = array.new<float>()   // price
var array<int>   STy  = array.new<int>()     // type 0..3
var array<int>   STf  = array.new<int>()     // 3 W · 2 D · 1 4H
var array<int>   SBt  = array.new<int>()     // frozen birth time
var array<float> SPar = array.new<float>()   // parent price
var array<int>   SCf  = array.new<int>()     // confidence

f_ingest(bool use, array<float> p, array<int> ty, array<int> t, array<float> par, array<int> cf, int tf) =>
    if use and not na(p) and p.size() > 0
        for i = 0 to p.size() - 1
            SP.push(p.get(i)), STy.push(ty.get(i)), STf.push(tf), SBt.push(t.get(i)), SPar.push(par.get(i)), SCf.push(cf.get(i))

SP.clear(), STy.clear(), STf.clear(), SBt.clear(), SPar.clear(), SCf.clear()
f_ingest(useW, wP,  wTy,  wT,  wPar,  wCf,  3)
f_ingest(useD, dP,  dTy,  dT,  dPar,  dCf,  2)
f_ingest(use4, h4P, h4Ty, h4T, h4Par, h4Cf, 1)

// ═══════════════════════════════════════════════════════════════════════════
// 4 · STRUCTURE HASH (canonical time window) + per-type counts
// ═══════════════════════════════════════════════════════════════════════════
canonCut = dayOpen - canonDays * 86400000
f_inWin(int i) => not na(dayOpen) and SBt.get(i) >= canonCut
f_lh(int i) =>
    int(math.round(SP.get(i) / syminfo.mintick)) * 131 + STy.get(i) * 29 + STf.get(i) * 7
f_hash() =>
    h = 0
    if SP.size() > 0
        for i = 0 to SP.size() - 1
            if f_inWin(i)
                h := int(math.abs((h + f_lh(i)) % 99999989))
    h
dbHash = f_hash()

cHH = 0
cHL = 0
cLH = 0
cLL = 0
if SP.size() > 0
    for i = 0 to SP.size() - 1
        ty = STy.get(i)
        cHH += ty == 0 ? 1 : 0
        cHL += ty == 1 ? 1 : 0
        cLH += ty == 2 ? 1 : 0
        cLL += ty == 3 ? 1 : 0

// ═══════════════════════════════════════════════════════════════════════════
// 4b · MARKET BIAS — MAJORITY VOTE of the three timeframes (2-of-3 must agree).
//      Each timeframe's trend is its last CONFIRMED close BOS/CHoCH (+1/-1/0),
//      read from the TRUE-timeframe trend engine so the vote is correct on any
//      chart. Bias is BULLISH only if ≥2 timeframes are bullish, BEARISH only if
//      ≥2 are bearish; anything else (1-1-1, splits, mostly-flat) is NEUTRAL.
//      This is confirmed-BOS/CHoCH consensus — never a HH/HL/LH/LL label count.
// ═══════════════════════════════════════════════════════════════════════════
nBull = (wTrend > 0 ? 1 : 0) + (dTrend > 0 ? 1 : 0) + (h4Trend > 0 ? 1 : 0)
nBear = (wTrend < 0 ? 1 : 0) + (dTrend < 0 ? 1 : 0) + (h4Trend < 0 ? 1 : 0)
biasScore = nBull >= 2 ? 1 : nBear >= 2 ? -1 : 0
bias  = biasScore > 0 ? "BULLISH" : biasScore < 0 ? "BEARISH" : "NEUTRAL / RANGE"
phase = biasScore > 0 ? "Markup ▲" : biasScore < 0 ? "Markdown ▼" : "Range / Transition"
biasCol = biasScore > 0 ? colBull : biasScore < 0 ? colBear : color.gray
f_arrow(int tr) => tr > 0 ? "▲" : tr < 0 ? "▼" : "•"
f_acol(int tr)  => tr > 0 ? colBull : tr < 0 ? colBear : color.gray
tfTrendStr = "W " + f_arrow(wTrend) + "  D " + f_arrow(dTrend) + "  4H " + f_arrow(h4Trend)

// ═══════════════════════════════════════════════════════════════════════════
// 4c · TIME-BASED REPLAY / FREEZE TEST — hashes points whose frozen birth time is
//      at/before the timestamp of bar (last_bar − windowBars). Chart-independent
//      birth time + a cutoff captured once ⇒ A=B=C on a non-repainting engine.
// ═══════════════════════════════════════════════════════════════════════════
var int freezeCutT = na
if bar_index == last_bar_index - windowBars
    freezeCutT := time
f_whash(int cutT) =>
    h = 0
    if not na(cutT) and SP.size() > 0
        for i = 0 to SP.size() - 1
            if SBt.get(i) <= cutT
                h := int(math.abs((h + f_lh(i)) % 99999989))
    h
wHash = f_whash(freezeCutT)
// Capture the frozen-window hash at three fixed anchor bars into var scalars — NO
// series-history indexing (wHash[500]/[1000]) that would force Pine to buffer 1000
// bars of every series, including the request.security arrays, and exceed the
// memory limit (RE10139) on deep-history forex. A = B = C ⇒ freeze integrity.
var int rA = na
var int rB = na
var int rC = na
if bar_index == last_bar_index
    rA := wHash
if bar_index == last_bar_index - 500
    rB := wHash
if bar_index == last_bar_index - 1000
    rC := wHash
replayPass = not na(rC) and rA == rB and rB == rC

// ═══════════════════════════════════════════════════════════════════════════
// 5 · RENDERER — READ-ONLY. Labels each structure point; optional zigzag link.
// ═══════════════════════════════════════════════════════════════════════════
f_show(int tf)  => tf == 3 ? showW : tf == 2 ? showD : showH4
f_tag(int tf)   => tf == 3 ? "W" : tf == 2 ? "D" : "4H"
f_tyname(int t) => t == 0 ? "HH" : t == 1 ? "HL" : t == 2 ? "LH" : "LL"
f_tyshow(int t) => t == 0 ? showHH : t == 1 ? showHL : t == 2 ? showLH : showLL
f_tycol(int t)  => (t == 0 or t == 1) ? colBull : colBear
lblSize = lblSizeS == "Normal" ? size.normal : lblSizeS == "Small" ? size.small : size.tiny

var array<label> drawnL = array.new<label>()
var array<line>  drawnZ = array.new<line>()

if barstate.islast
    if drawnL.size() > 0
        for i = 0 to drawnL.size() - 1
            label.delete(drawnL.get(i))
    if drawnZ.size() > 0
        for i = 0 to drawnZ.size() - 1
            line.delete(drawnZ.get(i))
    drawnL.clear(), drawnZ.clear()

    n = SP.size()
    elig = array.new<bool>(n, false)
    if n > 0
        for i = 0 to n - 1
            elig.set(i, f_show(STf.get(i)) and f_tyshow(STy.get(i)) and SCf.get(i) >= minConf)
    // per-timeframe recency budget: keep the most recent maxPts eligible per TF
    cutT = array.new<int>(4, 0)
    for tf = 1 to 3
        tmp = array.new<int>()
        if n > 0
            for i = 0 to n - 1
                if elig.get(i) and STf.get(i) == tf
                    tmp.push(SBt.get(i))
        if tmp.size() > maxPts
            tmp.sort(order.descending)
            cutT.set(tf, tmp.get(maxPts - 1))

    int prevX = na
    float prevY = na
    if n > 0
        for i = 0 to n - 1
            tf = STf.get(i)
            if elig.get(i) and SBt.get(i) >= cutT.get(tf)
                ty  = STy.get(i)
                col = f_tycol(ty)
                up  = ty == 0 or ty == 2   // a high sits above its bar, a low below
                txt = (showTfTag ? f_tag(tf) + " " : "") + f_tyname(ty) + (showConf ? " " + str.tostring(SCf.get(i)) : "")
                drawnL.push(label.new(SBt.get(i), SP.get(i), txt, xloc = xloc.bar_time, yloc = yloc.price, style = up ? label.style_label_down : label.style_label_up, color = color.new(col, 15), textcolor = color.white, size = lblSize))
                if linkPts and not na(prevX)
                    drawnZ.push(line.new(prevX, prevY, SBt.get(i), SP.get(i), xloc = xloc.bar_time, color = color.new(color.gray, 55), width = 1, style = line.style_dotted))
                prevX := SBt.get(i)
                prevY := SP.get(i)

// ═══════════════════════════════════════════════════════════════════════════
// 6 · DEBUG PANEL — structure hash + bias/phase + per-type counts + freeze test
// ═══════════════════════════════════════════════════════════════════════════
var table hud = table.new(position.top_right, 2, 8, bgcolor = color.new(#0a1a3a, 10), border_width = 1, border_color = color.new(color.gray, 60))
if barstate.islast
    table.cell(hud, 0, 0, "STRUCT HASH", text_color = color.white, text_size = size.normal)
    table.cell(hud, 1, 0, str.tostring(dbHash), text_color = #00e676, text_size = size.normal)
    table.cell(hud, 0, 1, "Bias (2 of 3)", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 1, bias, text_color = biasCol, text_size = size.normal)
    table.cell(hud, 0, 2, "Phase", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 2, phase, text_color = biasCol, text_size = size.small)
    table.cell(hud, 0, 3, "HH/HL/LH/LL", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 3, str.tostring(cHH) + "/" + str.tostring(cHL) + "/" + str.tostring(cLH) + "/" + str.tostring(cLL), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 4, "Total points", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 4, str.tostring(SP.size()), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 5, "Replay A/B/C", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 5, str.tostring(rA) + "/" + (na(rB) ? "—" : str.tostring(rB)) + "/" + (na(rC) ? "—" : str.tostring(rC)), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 6, "Freeze test", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 6, na(rC) ? "need 1000+ bars" : replayPass ? "PASS ✓" : "FAIL ✗", text_color = na(rC) ? color.gray : replayPass ? #00e676 : #ff1744, text_size = size.normal)
    table.cell(hud, 0, 7, "1W / 1D / 4H", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 7, tfTrendStr, text_color = color.silver, text_size = size.small)
