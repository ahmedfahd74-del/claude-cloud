//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// LEVEL CORE v1 — Event-Sourced Support/Resistance (MODULE 1: the foundation)
//
//  Design rules (validated before any other module is added):
//   • DETERMINISTIC: a level is born once from a CONFIRMED swing pivot and its
//     anchor price NEVER moves. No averaging, no snapping, no drift.
//   • NON-REPAINTING: every interaction is detected on CLOSED bars only
//     (barstate.isconfirmed). The live/forming bar changes nothing structural.
//   • EVENT-SOURCED: every interaction is appended to a per-level EVENT LOG with
//     a timestamp + outcome. EVERY displayed statistic is a count over that log —
//     nothing is estimated. Hover a level to read its full timeline (evidence).
//   • ZONE-WHILE-INTERACTING: a level expands to a zone only while price is in it,
//     then collapses back to a line; the interaction stays in memory.
//
//  Deferred to later modules (NOT here, on purpose): behaviour/next-event
//  probability, adaptive confidence, MTF bias, DOL liquidity. Foundation first.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Level Core v1 [event-sourced]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=5000)

gD = "Detection"
pivLen  = input.int(10, "Swing Size (pivot L/R)", minval=2, maxval=100, group=gD)
bandPct = input.float(0.40, "Level band (% of price)", minval=0.02, maxval=5.0, step=0.02, group=gD)
maxLvls = input.int(12, "Max levels tracked", minval=1, maxval=40, group=gD)
maxEv   = input.int(40, "Timeline length (events kept per level)", minval=5, maxval=80, group=gD)
minShow = input.int(1, "Min interactions to show a level", minval=0, maxval=20, group=gD)

gS = "Style"
resCol  = input.color(#ef5350, "Resistance", group=gS)
supCol  = input.color(#26a69a, "Support", group=gS)
zoneCol = input.color(#ffd24a, "Active zone", group=gS)
extR    = input.int(30, "Extend right (bars)", minval=0, maxval=200, group=gS)
showLbl = input.bool(true, "Show labels", group=gS)
lblSize = input.string("Small", "Label size", options=["Tiny", "Small", "Normal"], group=gS)

f_sz(s) => s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small

// event kinds: 1 = TOUCH (first contact), 2 = BOUNCE/held, 3 = BREAK, 4 = RETEST
type Ev
    int   bar
    int   t
    int   kind
    float react       // reaction size at the event, in ATR (measured, not guessed)

type Lvl
    float anchor      // fixed at birth — never moves
    int   bornBar
    bool  inside      // price currently interacting?
    int   entSide     // +1 entered from above, -1 from below
    float testHi      // excursion while inside
    float testLo
    bool  brokenLast  // last exit was a break → arms RETEST on next entry
    array<Ev> log

var array<Lvl> book = array.new<Lvl>()
atr = ta.atr(14)

// append an event, capping the timeline length (drop oldest)
f_log(Lvl L, int kind, int bar, int t, float react) =>
    array.push(L.log, Ev.new(bar, t, kind, react))
    if array.size(L.log) > maxEv
        array.shift(L.log)

// count events of a kind — the ONLY way stats are produced (verifiable)
f_count(Lvl L, int kind) =>
    int c = 0
    if array.size(L.log) > 0
        for i = 0 to array.size(L.log) - 1
            if array.get(L.log, i).kind == kind
                c += 1
    c

// ── BIRTH: confirmed swing pivots found levels; anchor is set once, forever ──
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)

f_found(float px) =>
    band = px * bandPct / 100.0
    exists = false
    if array.size(book) > 0
        for i = 0 to array.size(book) - 1
            if math.abs(array.get(book, i).anchor - px) <= band
                exists := true
                break
    if not exists and array.size(book) < maxLvls
        L = Lvl.new(px, bar_index - pivLen, false, 0, na, na, false, array.new<Ev>())
        // the founding pivot IS a real rejection that held → log it at ITS timestamp
        array.push(L.log, Ev.new(bar_index - pivLen, time[pivLen], 2, 0.0))
        array.push(book, L)

if not na(ph)
    f_found(ph)
if not na(pl)
    f_found(pl)

// ── INTERACTIONS: detected on CLOSED bars only → deterministic, no repaint ──
if barstate.isconfirmed and array.size(book) > 0
    for i = 0 to array.size(book) - 1
        L = array.get(book, i)
        band = L.anchor * bandPct / 100.0
        top = L.anchor + band
        bot = L.anchor - band
        nowIn = high >= bot and low <= top
        rct = (na(atr) or atr <= 0) ? 0.0 : math.max(math.abs(high - L.anchor), math.abs(low - L.anchor)) / atr
        if nowIn and not L.inside
            L.entSide := close[1] >= L.anchor ? 1 : -1
            L.testHi := high
            L.testLo := low
            f_log(L, L.brokenLast ? 4 : 1, bar_index, time, rct)
            L.inside := true
        else if nowIn and L.inside
            L.testHi := math.max(L.testHi, high)
            L.testLo := math.min(L.testLo, low)
        else if (not nowIn) and L.inside
            exitSide = close > top ? 1 : close < bot ? -1 : L.entSide
            if exitSide == L.entSide
                f_log(L, 2, bar_index, time, rct)     // BOUNCE — held its side
                L.brokenLast := false
            else
                f_log(L, 3, bar_index, time, rct)     // BREAK — crossed through
                L.brokenLast := true
            L.inside := false
            L.testHi := na
            L.testLo := na

// ── RENDER (last bar only) — every number below is a count over the log ──────
var array<line>  dLine = array.new<line>()
var array<label> dLab  = array.new<label>()
var array<box>   dBox  = array.new<box>()

f_kindTxt(int k) => k == 2 ? "✓ held" : k == 3 ? "✗ break" : k == 4 ? "↻ retest" : "• touch"

if barstate.islast
    while array.size(dLine) > 0
        line.delete(array.pop(dLine))
    while array.size(dLab) > 0
        label.delete(array.pop(dLab))
    while array.size(dBox) > 0
        box.delete(array.pop(dBox))
    x1 = bar_index - math.min(400, bar_index)
    x2 = bar_index + extR
    if array.size(book) > 0
        for i = 0 to array.size(book) - 1
            L = array.get(book, i)
            touches = f_count(L, 1) + f_count(L, 4)
            bounces = f_count(L, 2)
            breaks  = f_count(L, 3)
            retests = f_count(L, 4)
            events  = array.size(L.log)
            if events >= minShow
                isRes = L.anchor > close
                col = isRes ? resCol : supCol
                decided = bounces + breaks
                band = L.anchor * bandPct / 100.0
                if L.inside
                    zt = na(L.testHi) ? L.anchor + band : math.max(L.testHi, L.anchor + band)
                    zb = na(L.testLo) ? L.anchor - band : math.min(L.testLo, L.anchor - band)
                    array.push(dBox, box.new(x1, zt, x2, zb, border_color=color.new(zoneCol, 40), bgcolor=color.new(zoneCol, 85), border_width=1))
                else
                    array.push(dLine, line.new(x1, L.anchor, x2, L.anchor, color=col, width=2, extend=extend.left))
                if showLbl
                    bornT = array.size(L.log) > 0 ? array.get(L.log, 0).t : time
                    string tl = "LEVEL " + str.tostring(L.anchor, format.mintick) + " (" + (isRes ? "resistance" : "support") + ")\nborn " + str.format_time(bornT, "yyyy-MM-dd") + "\n———————————————\n"
                    st = math.max(0, array.size(L.log) - 15)
                    if array.size(L.log) > 0
                        for e = st to array.size(L.log) - 1
                            ev = array.get(L.log, e)
                            tl := tl + str.format_time(ev.t, "yy-MM-dd HH:mm") + "  " + f_kindTxt(ev.kind) + "  (" + str.tostring(ev.react, "#.0") + " ATR)\n"
                    wrtxt = decided > 0 ? str.tostring(math.round(bounces / decided * 100)) + "%" : "n/a"
                    head = str.tostring(L.anchor, format.mintick) + "  " + (isRes ? "RES" : "SUP") + "\n" + str.tostring(events) + " events · " + str.tostring(bounces) + "✓ / " + str.tostring(breaks) + "✗ · win " + wrtxt + (retests > 0 ? " · " + str.tostring(retests) + "↻" : "")
                    array.push(dLab, label.new(x2, L.anchor, head, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(col, 20), textcolor=color.white, size=f_sz(lblSize), tooltip=tl))
