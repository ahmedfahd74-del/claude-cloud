// © Institutional S/R — Deterministic MTF Proof of Concept
//
// PROOF OF CONCEPT ONLY. Validates one claim: that a level book built INSIDE
// request.security() is identical on every chart timeframe, and that a
// read-only renderer can draw it without ever changing it.
//
// Scope (nothing else): build Weekly / Daily / 4H books in-security → freeze →
// merge into one database → pick one Power Line → draw from the database.
// No methodology, probability, trade engine, dashboard, alerts, scanner, AI.

//@version=6
indicator("IA-SR · MTF Determinism POC", "IA-SR POC", overlay = true,
     max_lines_count = 200, max_labels_count = 200, max_boxes_count = 200, max_bars_back = 300)

// ─── Structure detection ───────────────────────────────────────────────────
// Swing strength IS a detection parameter: changing it re-detects swings and
// reshapes the level database (positions + hash change). Merge/Break stay frozen
// constants so only swing strength is tunable.
pivLen   = input.int(5, "Swing strength (bars each side)", minval = 2, maxval = 30, group = "Structure",
     tooltip = "Institutional swing sensitivity — the pivot leg length. This re-detects swings, so changing it MOVES levels and changes the DB hash (it is a detection input, not a display one).")
mergeATR = 0.40   // merge distance (× TF-ATR) — frozen
brkATR   = 0.30   // break distance (× TF-ATR) — frozen

// ─── Display (read-only — must never change the database) ──────────────────
maxLines = input.int(6, "Max lines per timeframe", minval = 1, maxval = 40, group = "Display",
     tooltip = "Applied PER timeframe: each shown timeframe draws up to this many levels. Enabling another timeframe adds its lines and never removes a level from a different timeframe.")
linePrio = input.string("Nearest to price", "Line priority", options = ["Nearest to price", "Highest strength"], group = "Display",
     tooltip = "Which levels fill each timeframe's budget first. Nearest = the closest levels to current price always show (most tradeable). Strength = the highest-ranked levels regardless of distance.")
clusterATR = input.float(0.5, "Merge lines closer than (× ATR)", minval = 0.0, maxval = 5.0, step = 0.1, group = "Display",
     tooltip = "Visual de-clutter (drawing only — never moves a line or changes the database). Lines sitting within this many daily-ATR of each other collapse to the single most important one (higher timeframe, then higher rank). 0 = draw every line, no merging. Raise it to thin out dense zones.")
minTouch = input.float(0.0, "Min touches to show", minval = 0.0, maxval = 20.0, step = 0.25, group = "Display",
     tooltip = "Display filter (read-only — never changes the database). Hide levels whose touch evidence is below this. A fresh level counts 1; each retest/merge adds evidence. 0 = show all.")
showW    = input.bool(true, "Show Weekly", inline = "s", group = "Display")
showD    = input.bool(true, "Show Daily",  inline = "s", group = "Display")
showH4   = input.bool(true, "Show 4H",     inline = "s", group = "Display")
// Levels are coloured by ROLE, not timeframe: a line below price acts as support
// (green); above price acts as resistance (red). When a level is broken (price
// closes through it) its role flips — a broken support becomes resistance and a
// broken resistance becomes support — so the colour flips on break/retest.
colSup   = input.color(#26a69a, "Support (below price)",    inline = "c", group = "Display")
colRes   = input.color(#ef5350, "Resistance (above price)", inline = "c", group = "Display")
lineWid  = input.int(2, "Line width", minval = 1, maxval = 6, group = "Display")
lineTr   = input.int(0, "Line transparency", minval = 0, maxval = 90, group = "Display")
styleS   = input.string("Solid", "Line style", options = ["Solid", "Dashed", "Dotted"], group = "Display")
showLbl  = input.bool(true, "Labels", group = "Display")
showPwr  = input.bool(true, "Power Line", group = "Display")

// ═══════════════════════════════════════════════════════════════════════════
// 1 · PER-TIMEFRAME BOOK BUILDER — runs INSIDE request.security on its own TF.
//     Detection + freeze + break all computed on that timeframe's OWN bars, so
//     the returned book is identical regardless of the chart timeframe.
// ═══════════════════════════════════════════════════════════════════════════
MAXBOOK = 400   // effectively append-only: confirmed levels are frozen records
                // and must not age out within the freeze-test window

f_book() =>
    var array<float> p = array.new<float>()   // frozen identity price (wick)
    var array<float> b = array.new<float>()   // body edge (visual anchor only)
    var array<int>   s = array.new<int>()     // 1 = resistance, 0 = support
    var array<float> t = array.new<float>()   // touch evidence
    var array<bool>  k = array.new<bool>()     // broken
    var array<int>   bt = array.new<int>()     // confirmation time (HTF bar time — chart-independent)
    a  = ta.atr(14)
    md = a * mergeATR
    bf = a * brkATR
    ph = ta.pivothigh(pivLen, pivLen)
    pl = ta.pivotlow(pivLen, pivLen)
    bodyHi = math.max(open[pivLen], close[pivLen])
    bodyLo = math.min(open[pivLen], close[pivLen])
    // new resistance — merge inside md is EVIDENCE ONLY (price never moves)
    if not na(ph)
        hit = false
        if p.size() > 0
            for i = 0 to p.size() - 1
                if s.get(i) == 1 and not k.get(i) and math.abs(p.get(i) - ph) <= md
                    t.set(i, t.get(i) + 1.0)
                    hit := true
                    break
        if not hit
            p.push(ph), b.push(bodyHi), s.push(1), t.push(1.0), k.push(false), bt.push(time[pivLen])
    // new support
    if not na(pl)
        hit = false
        if p.size() > 0
            for i = 0 to p.size() - 1
                if s.get(i) == 0 and not k.get(i) and math.abs(p.get(i) - pl) <= md
                    t.set(i, t.get(i) + 1.0)
                    hit := true
                    break
        if not hit
            p.push(pl), b.push(bodyLo), s.push(0), t.push(1.0), k.push(false), bt.push(time[pivLen])
    // touches + breaks on THIS timeframe's closes (chart-independent)
    if p.size() > 0
        for i = 0 to p.size() - 1
            if not k.get(i)
                lvl = p.get(i)
                res = s.get(i) == 1
                if high >= lvl - bf and low <= lvl + bf
                    t.set(i, t.get(i) + 0.25)
                if (res and close > lvl + bf) or (not res and close < lvl - bf)
                    k.set(i, true)
    // bound memory
    if p.size() > MAXBOOK
        w = 0
        wv = 1.0e18
        for i = 0 to p.size() - 1
            sc = t.get(i) - (k.get(i) ? 100.0 : 0.0)
            if sc < wv
                wv := sc
                w := i
        p.remove(w), b.remove(w), s.remove(w), t.remove(w), k.remove(w), bt.remove(w)
    [p, b, s, t, k, bt]

// ═══════════════════════════════════════════════════════════════════════════
// 2 · FETCH FROZEN BOOKS (one security call per TF) + chart-independent ATR
// ═══════════════════════════════════════════════════════════════════════════
[wP,  wB,  wS,  wT,  wK,  wBT]  = request.security(syminfo.tickerid, "W",   f_book(), lookahead = barmerge.lookahead_off)
[dP,  dB,  dS,  dT,  dK,  dBT]  = request.security(syminfo.tickerid, "D",   f_book(), lookahead = barmerge.lookahead_off)
[h4P, h4B, h4S, h4T, h4K, h4BT] = request.security(syminfo.tickerid, "240", f_book(), lookahead = barmerge.lookahead_off)
atrD = request.security(syminfo.tickerid, "D", ta.atr(14), lookahead = barmerge.lookahead_off)
atrRef = na(atrD) or atrD <= 0 ? close * 0.005 : atrD
// Chart-INDEPENDENT "today 00:00" anchor: the current daily bar's open time is
// the same timestamp on every chart resolution — the base for the canonical window.
dayOpen = request.security(syminfo.tickerid, "D", time, lookahead = barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════════════
// 3 · ONE PERSISTENT DATABASE — APPEND-ONLY UNION, WRITE-ONCE IDENTITY.
//
//     The combined DB is the pure UNION of the three frozen per-TF books. A
//     level enters exactly once — the first bar its (price-tick, timeframe)
//     identity appears — and never leaves; later bars only refresh live fields
//     (rank, broken). NOTHING is ever dropped, so membership does not depend on
//     the order in which levels appear. That matters twice:
//       · cross-TF — the union is the same set on every chart timeframe
//         (commutative hash ⇒ identical dbHash), and
//       · over time — for any fixed cut bar, {levels born ≤ cut} is immutable,
//         which is exactly what the freeze/replay test measures.
//     Near-duplicate levels from different timeframes are kept as distinct
//     records here (different provenance); the RENDERER de-duplicates them
//     visually (read-only), so de-dup never touches the database or the hash.
// ═══════════════════════════════════════════════════════════════════════════
var array<float> Dp   = array.new<float>()   // frozen identity price (wick)
var array<float> Db   = array.new<float>()   // body edge (frozen; retained for future use — not drawn)
var array<int>   Ds   = array.new<int>()     // 1 = resistance, 0 = support
var array<float> Dr   = array.new<float>()   // ranked strength 0-100 (live)
var array<float> Dt   = array.new<float>()   // touch evidence (live) — for the touch-count filter
var array<int>   Dtf  = array.new<int>()     // 3 W · 2 D · 1 4H
var array<bool>  Dbk  = array.new<bool>()    // broken/invalidated (live flag)
var array<int>   Dkey = array.new<int>()     // frozen identity key (price in ticks)
var array<int>   Dbt  = array.new<int>()     // frozen confirmation TIME (chart-independent — canon + freeze window)

f_norm(float v) => v / (v + 3.0)

// BOUNDED UNION — rebuilt every bar from the three frozen per-TF books. The books
// are themselves append-only/bounded INSIDE request.security (MAXBOOK), so the
// union is a bounded snapshot that cannot grow across chart history. Identity is
// still (price-tick, timeframe); the RENDERER de-duplicates near-duplicates
// visually. Rebuilding avoids the unbounded persistent map that exhausted memory
// (RE10139) on deep-history forex symbols. Determinism is unchanged: the union
// each bar equals the current chart-independent books, so the canonical-window
// hash and the time-based freeze test still sample the same frozen set.
f_ingest(bool use, array<float> p, array<float> b, array<int> s, array<float> t, array<bool> k, array<int> bt, float w, int tf) =>
    if use and not na(p) and p.size() > 0
        for i = 0 to p.size() - 1
            px  = p.get(i)
            key = int(math.round(px / syminfo.mintick))
            rk  = math.min(100.0, (0.35 + 0.65 * f_norm(t.get(i))) * w * 100.0)
            Dp.push(px), Db.push(b.get(i)), Ds.push(s.get(i)), Dr.push(rk), Dt.push(t.get(i))
            Dtf.push(tf), Dbk.push(k.get(i)), Dkey.push(key), Dbt.push(bt.get(i))

Dp.clear(), Db.clear(), Ds.clear(), Dr.clear(), Dt.clear(), Dtf.clear(), Dbk.clear(), Dkey.clear(), Dbt.clear()
f_ingest(true, wP,  wB,  wS,  wT,  wK,  wBT,  1.00, 3)
f_ingest(true, dP,  dB,  dS,  dT,  dK,  dBT,  0.80, 2)
f_ingest(true, h4P, h4B, h4S, h4T, h4K, h4BT, 0.60, 1)

// ═══════════════════════════════════════════════════════════════════════════
// 4 · POWER LINE — one controlling level, chosen ONLY from the database
// ═══════════════════════════════════════════════════════════════════════════
// TWO FROZEN POWER LINES (W/D only) that FRAME price. Each re-anchors ONLY when
// price closes through it (a real break) — never bar-to-bar — so they stop the
// jumping. PL1 = the nearer (controlling) boundary, PL2 = the farther (target).
// A broken boundary flips to the opposite side (support→resistance / vice-versa).
f_nearWD(bool below) =>
    best = float(na)
    bd = 1.0e18
    if Dp.size() > 0
        for i = 0 to Dp.size() - 1
            if Dtf.get(i) >= 2 and not Dbk.get(i)    // Weekly / Daily, unbroken
                px = Dp.get(i)
                if (below and px < close) or (not below and px > close)
                    d = math.abs(close - px)
                    if d < bd
                        bd := d
                        best := px
    best
// STATELESS power lines — no var, no path-dependent state. Each is a pure
// function of the current database + price, so given the same DB and last-bar
// price (both identical across chart timeframes) the result is byte-identical
// on every timeframe. They still change only when price actually CROSSES a W/D
// level (the nearest bracket shifts) — never bar-to-bar — so there is no jump.
// plLo = nearest unbroken Weekly/Daily level below price; plHi = nearest above.
plLo = f_nearWD(true)
plHi = f_nearWD(false)
pl1 = na(plLo) ? plHi : na(plHi) ? plLo : (math.abs(close - plLo) <= math.abs(close - plHi) ? plLo : plHi)

// ═══════════════════════════════════════════════════════════════════════════
// 4b · CANONICAL DATABASE HASH — resolution-independent cross-TF proof.
//      A chart's resolution limits how much HTF history request.security loads,
//      so a 1D chart legitimately knows older levels a 15m chart cannot even
//      load. To make the hash comparable across ALL resolutions, it covers only
//      the CANONICAL window: levels confirmed within the last `canonDays`
//      calendar days. BOTH the cutoff (from the daily-security "today" anchor)
//      and each level's confirmation time are chart-independent, so within the
//      window the level SET is identical on every resolution ⇒ identical hash.
//      Order-independent (commutative sum mod a prime). No eyeballing.
// ═══════════════════════════════════════════════════════════════════════════
canonDays = input.int(30, "Canonical hash window (days)", minval = 3, maxval = 365, group = "Validation",
     tooltip = "The cross-TF DB HASH covers levels confirmed in the last N days. For the hash to match across timeframes, N must be INSIDE the history every chart loaded — near a chart's history edge one old level can be present on one timeframe but not another, changing the sum. Lower N → more robust low-timeframe parity (1m matching 1D); raise it for wider coverage when comparing higher timeframes only. If two timeframes disagree, lower N until they match.")
canonCut  = dayOpen - canonDays * 86400000
f_inWin(int i) => not na(dayOpen) and Dbt.get(i) >= canonCut
f_hash() =>
    h = 0
    if Dp.size() > 0
        for i = 0 to Dp.size() - 1
            if not Dbk.get(i) and f_inWin(i)
                tickP = int(math.round(Dp.get(i) / syminfo.mintick))
                lh = tickP * 131 + Ds.get(i) * 17 + Dtf.get(i) * 7
                h := int(math.abs((h + lh) % 99999989))
    h
f_wincount() =>
    c = 0
    if Dp.size() > 0
        for i = 0 to Dp.size() - 1
            if not Dbk.get(i) and f_inWin(i)
                c += 1
    c
dbHash    = f_hash()
winLevels = f_wincount()

// ═══════════════════════════════════════════════════════════════════════════
// 4c · REPLAY / FREEZE-INTEGRITY TEST — the "solid enough to build on" proof.
//      Hashes ONLY the frozen window: levels whose write-once birth bar is at or
//      before last_bar − windowBars. Because the DB is append-only with frozen
//      identities, that window's membership can never change, so its hash
//      sampled now / 500 / 1000 bars ago MUST match on a non-repainting engine.
//      A = B = C ⇒ freeze integrity holds. (Broken flag is deliberately NOT in
//      the hash — invalidation is a live overlay, not part of level identity.)
// ═══════════════════════════════════════════════════════════════════════════
windowBars = input.int(1200, "Replay window (bars, must exceed 1000)", minval = 1050, group = "Validation")

// TIME-BASED cutoff (chart-independent), captured once at bar (last − windowBars).
// Records whose frozen confirmation time is at/before that instant form the frozen
// window; append-only books keep that set immutable ⇒ its hash is invariant.
var int freezeCutT = na
if bar_index == last_bar_index - windowBars
    freezeCutT := time
f_whash(int cutT) =>
    h = 0
    if not na(cutT) and Dp.size() > 0
        for i = 0 to Dp.size() - 1
            if Dbt.get(i) <= cutT
                h := int(math.abs((h + Dkey.get(i) * 131 + Ds.get(i) * 17 + Dtf.get(i) * 7) % 99999989))
    h
wHash = f_whash(freezeCutT)
// Sample the frozen-window hash at three fixed anchor bars and CAPTURE each into a
// var scalar — no series-history indexing (wHash[500]/[1000]) that would force Pine
// to buffer 1000 bars of every series (incl. the request.security arrays) and blow
// the memory limit (RE10139) on deep-history forex. A = B = C ⇒ freeze integrity.
var int rA = na
var int rB = na
var int rC = na
if bar_index == last_bar_index
    rA := wHash
if bar_index == last_bar_index - 500
    rB := wHash
if bar_index == last_bar_index - 1000
    rC := wHash
replayPass = not na(rC) and rA == rB and rB == rC

// ═══════════════════════════════════════════════════════════════════════════
// 5 · RENDERER — READ-ONLY. Every setting here changes drawing only.
// ═══════════════════════════════════════════════════════════════════════════
lStyle  = styleS == "Dashed" ? line.style_dashed : styleS == "Dotted" ? line.style_dotted : line.style_solid
f_show(int tf) => tf == 3 ? showW : tf == 2 ? showD : showH4
f_tag(int tf)  => tf == 3 ? "W" : tf == 2 ? "D" : "4H"
// CURRENT ROLE by PRICE POSITION (not the birth side): every level above the
// current price acts as resistance (red); every level below acts as support
// (green). When price crosses a level the role — and colour — flips. Pure
// function of price + level, so it is identical across chart timeframes.
f_res(int i)  => Dp.get(i) > close   // above price ⇒ resistance (red); below ⇒ support (green)
f_rcol(int i) => f_res(i) ? colRes : colSup
f_rtag(int i) => f_res(i) ? "R" : "S"

// READ-ONLY visual CLUSTER de-dup: when several drawn lines sit within the
// spacing budget (clusterATR × daily-ATR) of each other, keep only the most
// important one and hide the rest — so dense zones collapse to a single line.
// "Most important" is a strict total order: higher timeframe wins; tie → higher
// rank; tie → lower index (deterministic). It only HIDES lines, never moves one,
// and touches only drawing — never the database or the hash.
f_keep(int i) =>
    keep = true
    lvl  = Dp.get(i)
    tf   = Dtf.get(i)
    rk   = Dr.get(i)
    tol  = atrRef * clusterATR
    if clusterATR > 0 and Dp.size() > 0
        for j = 0 to Dp.size() - 1
            if j != i and f_show(Dtf.get(j)) and math.abs(Dp.get(j) - lvl) <= tol
                tfj = Dtf.get(j)
                rkj = Dr.get(j)
                wins = tfj > tf or (tfj == tf and (rkj > rk or (rkj == rk and j < i)))
                if wins
                    keep := false
                    break
    keep

// A level is eligible to draw when its timeframe is shown and it survived de-dup.
// Broken levels ARE drawn — they flip role/colour rather than disappearing, so a
// former support that price broke shows as red resistance (a retest candidate).
// The Max-Lines budget is filled from this set only, so the count is what you SEE.
nearMode = linePrio == "Nearest to price"
f_eligible(int i) => f_show(Dtf.get(i)) and f_keep(i) and Dt.get(i) >= minTouch
f_metric(int i)   => nearMode ? math.abs(close - Dp.get(i)) : Dr.get(i)

// PER-TIMEFRAME budget: the cutoff is computed for ONE timeframe at a time, so
// each shown timeframe gets its own n-nearest (or n-strongest) allowance.
// Enabling another timeframe therefore ADDS its lines and never evicts a level
// from a different timeframe. Nearest → n-th SMALLEST distance to price;
// Strength → n-th LARGEST rank. na ⇒ fewer than n eligible in that TF, draw all.
f_cutoffTF(int n, int tf) =>
    tmp = array.new<float>()
    if Dp.size() > 0
        for i = 0 to Dp.size() - 1
            if f_eligible(i) and Dtf.get(i) == tf
                tmp.push(f_metric(i))
    cut = float(na)
    if tmp.size() > n and n > 0
        tmp.sort(nearMode ? order.ascending : order.descending)
        cut := tmp.get(n - 1)
    cut

// Does level i make the Max-Lines cut? (nearest ⇒ within cutoff distance;
// strength ⇒ at or above cutoff rank.)
f_inbudget(int i, float cut) => na(cut) or (nearMode ? f_metric(i) <= cut : f_metric(i) >= cut)

var array<line>  drawn = array.new<line>()
var array<label> drawnL = array.new<label>()
var line  pLnLo = na
var line  pLnHi = na
var label pLbLo = na
var label pLbHi = na

if barstate.islast
    if drawn.size() > 0
        for i = 0 to drawn.size() - 1
            line.delete(drawn.get(i))
    if drawnL.size() > 0
        for i = 0 to drawnL.size() - 1
            label.delete(drawnL.get(i))
    drawn.clear(), drawnL.clear()
    cutW = f_cutoffTF(maxLines, 3)   // one budget per timeframe — independent layers
    cutD = f_cutoffTF(maxLines, 2)
    cut4 = f_cutoffTF(maxLines, 1)
    x1 = bar_index - 1
    x2 = bar_index + 1
    if Dp.size() > 0
        for i = 0 to Dp.size() - 1
            tf = Dtf.get(i)
            rk = Dr.get(i)
            if f_eligible(i) and f_inbudget(i, tf == 3 ? cutW : tf == 2 ? cutD : cut4)
                lvl = Dp.get(i)                                     // draw at the wick — the true level
                col = color.new(f_rcol(i), lineTr)                  // colour by CURRENT role (S green / R red)
                drawn.push(line.new(x1, lvl, x2, lvl, xloc = xloc.bar_index, extend = extend.both, color = col, width = lineWid, style = lStyle))
                if showLbl
                    drawnL.push(label.new(x2, lvl, f_tag(tf) + " " + f_rtag(i) + " " + str.tostring(math.round(rk)), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(f_rcol(i), 20), textcolor = color.white, size = size.small))
    if not na(pLnLo)
        line.delete(pLnLo)
        pLnLo := na
    if not na(pLnHi)
        line.delete(pLnHi)
        pLnHi := na
    if not na(pLbLo)
        label.delete(pLbLo)
        pLbLo := na
    if not na(pLbHi)
        label.delete(pLbHi)
        pLbHi := na
    if showPwr and not na(plLo)
        p1 = pl1 == plLo
        pLnLo := line.new(x1, plLo, x2, plLo, xloc = xloc.bar_index, extend = extend.both, color = colSup, width = p1 ? 3 : 2, style = line.style_solid)
        pLbLo := label.new(x2, plLo, "⚡ " + (p1 ? "PL1" : "PL2") + " " + str.tostring(plLo, format.mintick) + " · S", xloc = xloc.bar_index, style = label.style_label_left, color = colSup, textcolor = color.white, size = size.normal)
    if showPwr and not na(plHi)
        p1 = pl1 == plHi
        pLnHi := line.new(x1, plHi, x2, plHi, xloc = xloc.bar_index, extend = extend.both, color = colRes, width = p1 ? 3 : 2, style = line.style_solid)
        pLbHi := label.new(x2, plHi, "⚡ " + (p1 ? "PL1" : "PL2") + " " + str.tostring(plHi, format.mintick) + " · R", xloc = xloc.bar_index, style = label.style_label_left, color = colRes, textcolor = color.white, size = size.normal)

// ═══════════════════════════════════════════════════════════════════════════
// 6 · HASH READOUT — the validation instrument. Compare DB HASH across
//     1M / 5M / 15M / 1H / 4H / 1D: identical hash ⇒ identical canonical DB.
//     "Levels win/all" — the WINDOW count matches across TFs; the TOTAL may
//     differ because higher-TF charts load more HTF history (expected, benign).
// ═══════════════════════════════════════════════════════════════════════════
var table hud = table.new(position.top_right, 2, 5, bgcolor = color.new(#0a1a3a, 10), border_width = 1, border_color = color.new(color.gray, 60))
if barstate.islast
    table.cell(hud, 0, 0, "DB HASH", text_color = color.white, text_size = size.normal)
    table.cell(hud, 1, 0, str.tostring(dbHash), text_color = #00e676, text_size = size.normal)
    table.cell(hud, 0, 1, "Levels win/all", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 1, str.tostring(winLevels) + " / " + str.tostring(Dp.size()), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 2, "PL1 / PL2", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 2, (na(plLo) ? "—" : str.tostring(plLo, format.mintick)) + " / " + (na(plHi) ? "—" : str.tostring(plHi, format.mintick)), text_color = color.white, text_size = size.small)
    table.cell(hud, 0, 3, "Replay A/B/C", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 3, str.tostring(rA) + "/" + (na(rB) ? "—" : str.tostring(rB)) + "/" + (na(rC) ? "—" : str.tostring(rC)), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 4, "Freeze test", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 4, na(rC) ? "need 1000+ bars" : replayPass ? "PASS ✓" : "FAIL ✗", text_color = na(rC) ? color.gray : replayPass ? #00e676 : #ff1744, text_size = size.normal)
