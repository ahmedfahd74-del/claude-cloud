// © Institutional S/R — Deterministic MTF Proof of Concept
//
// PROOF OF CONCEPT ONLY. Validates one claim: that a level book built INSIDE
// request.security() is identical on every chart timeframe, and that a
// read-only renderer can draw it without ever changing it.
//
// Scope (nothing else): build Weekly / Daily / 4H books in-security → freeze →
// merge into one database → pick one Power Line → draw from the database.
// No methodology, probability, trade engine, dashboard, alerts, scanner, AI.

//@version=6
indicator("IA-SR · MTF Determinism POC", "IA-SR POC", overlay = true,
     max_lines_count = 200, max_labels_count = 200, max_boxes_count = 200, max_bars_back = 5000)

// ─── Detection (pre-freeze) ───────────────────────────────────────────────
pivLen   = input.int(5, "Swing strength (bars each side)", minval = 2, maxval = 30, group = "Detection")
mergeATR = input.float(0.40, "Merge distance (× TF-ATR)", minval = 0.05, maxval = 2.0, step = 0.05, group = "Detection")
brkATR   = input.float(0.30, "Break distance (× TF-ATR)", minval = 0.05, maxval = 2.0, step = 0.05, group = "Detection")

// ─── Display (read-only — must never change the database) ──────────────────
maxLines = input.int(10, "Max Lines (top-ranked drawn)", minval = 1, maxval = 40, group = "Display")
showW    = input.bool(true, "Show Weekly", inline = "s", group = "Display")
showD    = input.bool(true, "Show Daily",  inline = "s", group = "Display")
showH4   = input.bool(true, "Show 4H",     inline = "s", group = "Display")
colW     = input.color(#d32f2f, "Weekly", inline = "c", group = "Display")
colD     = input.color(#ffd700, "Daily",  inline = "c", group = "Display")
colH4    = input.color(#2962ff, "4H",     inline = "c", group = "Display")
lineWid  = input.int(2, "Line width", minval = 1, maxval = 6, group = "Display")
lineTr   = input.int(0, "Line transparency", minval = 0, maxval = 90, group = "Display")
styleS   = input.string("Solid", "Line style", options = ["Solid", "Dashed", "Dotted"], group = "Display")
anchorS  = input.string("Wick", "Anchor (visual only)", options = ["Wick", "Mid", "Body"], group = "Display")
showLbl  = input.bool(true, "Labels", group = "Display")
showPwr  = input.bool(true, "Power Line", group = "Display")
colPwr   = input.color(#ffffff, "Power Line colour", group = "Display")

// ═══════════════════════════════════════════════════════════════════════════
// 1 · PER-TIMEFRAME BOOK BUILDER — runs INSIDE request.security on its own TF.
//     Detection + freeze + break all computed on that timeframe's OWN bars, so
//     the returned book is identical regardless of the chart timeframe.
// ═══════════════════════════════════════════════════════════════════════════
MAXBOOK = 400   // effectively append-only: confirmed levels are frozen records
                // and must not age out within the freeze-test window

f_book() =>
    var array<float> p = array.new<float>()   // frozen identity price (wick)
    var array<float> b = array.new<float>()   // body edge (visual anchor only)
    var array<int>   s = array.new<int>()     // 1 = resistance, 0 = support
    var array<float> t = array.new<float>()   // touch evidence
    var array<bool>  k = array.new<bool>()     // broken
    a  = ta.atr(14)
    md = a * mergeATR
    bf = a * brkATR
    ph = ta.pivothigh(pivLen, pivLen)
    pl = ta.pivotlow(pivLen, pivLen)
    bodyHi = math.max(open[pivLen], close[pivLen])
    bodyLo = math.min(open[pivLen], close[pivLen])
    // new resistance — merge inside md is EVIDENCE ONLY (price never moves)
    if not na(ph)
        hit = false
        if p.size() > 0
            for i = 0 to p.size() - 1
                if s.get(i) == 1 and not k.get(i) and math.abs(p.get(i) - ph) <= md
                    t.set(i, t.get(i) + 1.0)
                    hit := true
                    break
        if not hit
            p.push(ph), b.push(bodyHi), s.push(1), t.push(1.0), k.push(false)
    // new support
    if not na(pl)
        hit = false
        if p.size() > 0
            for i = 0 to p.size() - 1
                if s.get(i) == 0 and not k.get(i) and math.abs(p.get(i) - pl) <= md
                    t.set(i, t.get(i) + 1.0)
                    hit := true
                    break
        if not hit
            p.push(pl), b.push(bodyLo), s.push(0), t.push(1.0), k.push(false)
    // touches + breaks on THIS timeframe's closes (chart-independent)
    if p.size() > 0
        for i = 0 to p.size() - 1
            if not k.get(i)
                lvl = p.get(i)
                res = s.get(i) == 1
                if high >= lvl - bf and low <= lvl + bf
                    t.set(i, t.get(i) + 0.25)
                if (res and close > lvl + bf) or (not res and close < lvl - bf)
                    k.set(i, true)
    // bound memory
    if p.size() > MAXBOOK
        w = 0
        wv = 1.0e18
        for i = 0 to p.size() - 1
            sc = t.get(i) - (k.get(i) ? 100.0 : 0.0)
            if sc < wv
                wv := sc
                w := i
        p.remove(w), b.remove(w), s.remove(w), t.remove(w), k.remove(w)
    [p, b, s, t, k]

// ═══════════════════════════════════════════════════════════════════════════
// 2 · FETCH FROZEN BOOKS (one security call per TF) + chart-independent ATR
// ═══════════════════════════════════════════════════════════════════════════
[wP,  wB,  wS,  wT,  wK]  = request.security(syminfo.tickerid, "W",   f_book(), lookahead = barmerge.lookahead_off)
[dP,  dB,  dS,  dT,  dK]  = request.security(syminfo.tickerid, "D",   f_book(), lookahead = barmerge.lookahead_off)
[h4P, h4B, h4S, h4T, h4K] = request.security(syminfo.tickerid, "240", f_book(), lookahead = barmerge.lookahead_off)
atrD = request.security(syminfo.tickerid, "D", ta.atr(14), lookahead = barmerge.lookahead_off)
atrRef = na(atrD) or atrD <= 0 ? close * 0.005 : atrD

// ═══════════════════════════════════════════════════════════════════════════
// 3 · ONE PERSISTENT DATABASE — APPEND-ONLY UNION, WRITE-ONCE IDENTITY.
//
//     The combined DB is the pure UNION of the three frozen per-TF books. A
//     level enters exactly once — the first bar its (price-tick, timeframe)
//     identity appears — and never leaves; later bars only refresh live fields
//     (rank, broken). NOTHING is ever dropped, so membership does not depend on
//     the order in which levels appear. That matters twice:
//       · cross-TF — the union is the same set on every chart timeframe
//         (commutative hash ⇒ identical dbHash), and
//       · over time — for any fixed cut bar, {levels born ≤ cut} is immutable,
//         which is exactly what the freeze/replay test measures.
//     Near-duplicate levels from different timeframes are kept as distinct
//     records here (different provenance); the RENDERER de-duplicates them
//     visually (read-only), so de-dup never touches the database or the hash.
// ═══════════════════════════════════════════════════════════════════════════
var array<float> Dp   = array.new<float>()   // frozen identity price (wick)
var array<float> Db   = array.new<float>()   // body edge (visual anchor only)
var array<int>   Ds   = array.new<int>()     // 1 = resistance, 0 = support
var array<float> Dr   = array.new<float>()   // ranked strength 0-100 (live)
var array<int>   Dtf  = array.new<int>()     // 3 W · 2 D · 1 4H
var array<bool>  Dbk  = array.new<bool>()    // broken/invalidated (live flag)
var array<int>   Dkey = array.new<int>()     // frozen identity key (price in ticks)
var array<int>   Dbir = array.new<int>()     // frozen birth bar_index

f_norm(float v) => v / (v + 3.0)

// Find an existing level with this exact (key, tf) identity, else -1.
f_find(int key, int tf) =>
    idx = -1
    if Dkey.size() > 0
        for j = 0 to Dkey.size() - 1
            if Dkey.get(j) == key and Dtf.get(j) == tf
                idx := j
                break
    idx

f_ingest(bool use, array<float> p, array<float> b, array<int> s, array<float> t, array<bool> k, float w, int tf) =>
    if use and not na(p) and p.size() > 0
        for i = 0 to p.size() - 1
            px  = p.get(i)
            key = int(math.round(px / syminfo.mintick))
            rk  = math.min(100.0, (0.35 + 0.65 * f_norm(t.get(i))) * w * 100.0)
            idx = f_find(key, tf)
            if idx >= 0
                Dr.set(idx, rk), Dbk.set(idx, k.get(i))     // refresh live fields only
            else
                Dp.push(px), Db.push(b.get(i)), Ds.push(s.get(i)), Dr.push(rk)
                Dtf.push(tf), Dbk.push(k.get(i))
                Dkey.push(key), Dbir.push(bar_index)         // write-once identity + birth bar

f_ingest(true, wP,  wB,  wS,  wT,  wK,  1.00, 3)
f_ingest(true, dP,  dB,  dS,  dT,  dK,  0.80, 2)
f_ingest(true, h4P, h4B, h4S, h4T, h4K, 0.60, 1)

// Nth-highest strength for the Max-Lines display filter (read-only).
f_thresh(int n) =>
    tmp = array.new<float>()
    if Dr.size() > 0
        for i = 0 to Dr.size() - 1
            if not Dbk.get(i)
                tmp.push(Dr.get(i))
    thr = -1.0
    if tmp.size() > n and n > 0
        tmp.sort(order.descending)
        thr := tmp.get(n - 1)
    thr

// ═══════════════════════════════════════════════════════════════════════════
// 4 · POWER LINE — one controlling level, chosen ONLY from the database
// ═══════════════════════════════════════════════════════════════════════════
// TWO FROZEN POWER LINES (W/D only) that FRAME price. Each re-anchors ONLY when
// price closes through it (a real break) — never bar-to-bar — so they stop the
// jumping. PL1 = the nearer (controlling) boundary, PL2 = the farther (target).
// A broken boundary flips to the opposite side (support→resistance / vice-versa).
f_nearWD(bool below) =>
    best = float(na)
    bd = 1.0e18
    if Dp.size() > 0
        for i = 0 to Dp.size() - 1
            if Dtf.get(i) >= 2 and not Dbk.get(i)    // Weekly / Daily, unbroken
                px = Dp.get(i)
                if (below and px < close) or (not below and px > close)
                    d = math.abs(close - px)
                    if d < bd
                        bd := d
                        best := px
    best
pwrBuf = atrRef * 0.25
var float plLo = na       // frozen support boundary (below price)
var float plHi = na       // frozen resistance boundary (above price)
nbLo = f_nearWD(true)
nbHi = f_nearWD(false)
if na(plLo)
    plLo := nbLo
else if close < plLo - pwrBuf
    plHi := plLo                                     // broken support flips up to resistance
    plLo := nbLo                                     // re-anchor to the next support below
if na(plHi)
    plHi := nbHi
else if close > plHi + pwrBuf
    plLo := plHi                                     // broken resistance flips down to support
    plHi := nbHi
pl1 = na(plLo) ? plHi : na(plHi) ? plLo : (math.abs(close - plLo) <= math.abs(close - plHi) ? plLo : plHi)

// ═══════════════════════════════════════════════════════════════════════════
// 4b · DATABASE HASH — objective determinism proof (order-independent).
//      A pure function of the frozen database contents (tick-rounded price +
//      side + timeframe per level, summed mod a prime — commutative, so it is
//      independent of insertion order). If this value is IDENTICAL on every
//      chart timeframe, the database is provably identical. No eyeballing.
// ═══════════════════════════════════════════════════════════════════════════
f_hash() =>
    h = 0
    if Dp.size() > 0
        for i = 0 to Dp.size() - 1
            if not Dbk.get(i)
                tickP = int(math.round(Dp.get(i) / syminfo.mintick))
                lh = tickP * 131 + Ds.get(i) * 17 + Dtf.get(i) * 7
                h := int(math.abs((h + lh) % 99999989))
    h
dbHash = f_hash()

// ═══════════════════════════════════════════════════════════════════════════
// 4c · REPLAY / FREEZE-INTEGRITY TEST — the "solid enough to build on" proof.
//      Hashes ONLY the frozen window: levels whose write-once birth bar is at or
//      before last_bar − windowBars. Because the DB is append-only with frozen
//      identities, that window's membership can never change, so its hash
//      sampled now / 500 / 1000 bars ago MUST match on a non-repainting engine.
//      A = B = C ⇒ freeze integrity holds. (Broken flag is deliberately NOT in
//      the hash — invalidation is a live overlay, not part of level identity.)
// ═══════════════════════════════════════════════════════════════════════════
windowBars = input.int(1200, "Replay window (bars, must exceed 1000)", minval = 1050, group = "Detection")

f_whash(int cut) =>
    h = 0
    if Dp.size() > 0
        for i = 0 to Dp.size() - 1
            if Dbir.get(i) <= cut
                h := int(math.abs((h + Dkey.get(i) * 131 + Ds.get(i) * 17 + Dtf.get(i) * 7) % 99999989))
    h
winCut = last_bar_index - windowBars
wHash  = f_whash(winCut)
rA = wHash
rB = wHash[500]
rC = wHash[1000]
replayPass = not na(rC) and rA == rB and rB == rC

// ═══════════════════════════════════════════════════════════════════════════
// 5 · RENDERER — READ-ONLY. Every setting here changes drawing only.
// ═══════════════════════════════════════════════════════════════════════════
anchorA = anchorS == "Body" ? 1.0 : anchorS == "Mid" ? 0.5 : 0.0
lStyle  = styleS == "Dashed" ? line.style_dashed : styleS == "Dotted" ? line.style_dotted : line.style_solid
f_col(int tf)  => tf == 3 ? colW : tf == 2 ? colD : colH4
f_show(int tf) => tf == 3 ? showW : tf == 2 ? showD : showH4
f_tag(int tf)  => tf == 3 ? "W" : tf == 2 ? "D" : "4H"

// READ-ONLY visual de-dup: hide a level when a HIGHER-timeframe unbroken level
// sits within tolerance (uses live ATR — affects drawing only, never the DB).
f_keep(int i) =>
    keep = true
    lvl = Dp.get(i)
    tf  = Dtf.get(i)
    if Dp.size() > 0
        for j = 0 to Dp.size() - 1
            if j != i and not Dbk.get(j) and Dtf.get(j) > tf and math.abs(Dp.get(j) - lvl) <= atrRef * mergeATR
                keep := false
                break
    keep

var array<line>  drawn = array.new<line>()
var array<label> drawnL = array.new<label>()
var line  pLnLo = na
var line  pLnHi = na
var label pLbLo = na
var label pLbHi = na

if barstate.islast
    if drawn.size() > 0
        for i = 0 to drawn.size() - 1
            line.delete(drawn.get(i))
    if drawnL.size() > 0
        for i = 0 to drawnL.size() - 1
            label.delete(drawnL.get(i))
    drawn.clear(), drawnL.clear()
    thr = f_thresh(maxLines)
    x1 = bar_index - 1
    x2 = bar_index + 1
    if Dp.size() > 0
        for i = 0 to Dp.size() - 1
            tf = Dtf.get(i)
            rk = Dr.get(i)
            if f_show(tf) and not Dbk.get(i) and f_keep(i) and (thr < 0 or rk >= thr)
                lvl = Dp.get(i)
                dy  = lvl * (1.0 - anchorA) + Db.get(i) * anchorA   // visual anchor only
                col = color.new(f_col(tf), lineTr)
                drawn.push(line.new(x1, dy, x2, dy, xloc = xloc.bar_index, extend = extend.both, color = col, width = lineWid, style = lStyle))
                if showLbl
                    drawnL.push(label.new(x2, dy, f_tag(tf) + " " + (Ds.get(i) == 1 ? "R" : "S") + " " + str.tostring(math.round(rk)), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(f_col(tf), 20), textcolor = color.white, size = size.small))
    if not na(pLnLo)
        line.delete(pLnLo)
        pLnLo := na
    if not na(pLnHi)
        line.delete(pLnHi)
        pLnHi := na
    if not na(pLbLo)
        label.delete(pLbLo)
        pLbLo := na
    if not na(pLbHi)
        label.delete(pLbHi)
        pLbHi := na
    if showPwr and not na(plLo)
        p1 = pl1 == plLo
        pLnLo := line.new(x1, plLo, x2, plLo, xloc = xloc.bar_index, extend = extend.both, color = colPwr, width = p1 ? 3 : 2, style = line.style_solid)
        pLbLo := label.new(x2, plLo, "⚡ " + (p1 ? "PL1" : "PL2") + " " + str.tostring(plLo, format.mintick) + " · S", xloc = xloc.bar_index, style = label.style_label_left, color = colPwr, textcolor = color.black, size = size.normal)
    if showPwr and not na(plHi)
        p1 = pl1 == plHi
        pLnHi := line.new(x1, plHi, x2, plHi, xloc = xloc.bar_index, extend = extend.both, color = colPwr, width = p1 ? 3 : 2, style = line.style_solid)
        pLbHi := label.new(x2, plHi, "⚡ " + (p1 ? "PL1" : "PL2") + " " + str.tostring(plHi, format.mintick) + " · R", xloc = xloc.bar_index, style = label.style_label_left, color = colPwr, textcolor = color.black, size = size.normal)

// ═══════════════════════════════════════════════════════════════════════════
// 6 · HASH READOUT — the validation instrument. Compare this value across
//     1M / 5M / 15M / 1H / 4H / 1D: identical hash ⇒ identical database.
// ═══════════════════════════════════════════════════════════════════════════
var table hud = table.new(position.top_right, 2, 5, bgcolor = color.new(#0a1a3a, 10), border_width = 1, border_color = color.new(color.gray, 60))
if barstate.islast
    table.cell(hud, 0, 0, "DB HASH", text_color = color.white, text_size = size.normal)
    table.cell(hud, 1, 0, str.tostring(dbHash), text_color = #00e676, text_size = size.normal)
    table.cell(hud, 0, 1, "Levels", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 1, str.tostring(Dp.size()), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 2, "PL1 / PL2", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 2, (na(plLo) ? "—" : str.tostring(plLo, format.mintick)) + " / " + (na(plHi) ? "—" : str.tostring(plHi, format.mintick)), text_color = color.white, text_size = size.small)
    table.cell(hud, 0, 3, "Replay A/B/C", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 3, str.tostring(rA) + "/" + (na(rB) ? "—" : str.tostring(rB)) + "/" + (na(rC) ? "—" : str.tostring(rC)), text_color = color.silver, text_size = size.small)
    table.cell(hud, 0, 4, "Freeze test", text_color = color.gray, text_size = size.small)
    table.cell(hud, 1, 4, na(rC) ? "need 1000+ bars" : replayPass ? "PASS ✓" : "FAIL ✗", text_color = na(rC) ? color.gray : replayPass ? #00e676 : #ff1744, text_size = size.normal)
